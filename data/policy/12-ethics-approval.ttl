
# ------------------------------------------------------------------
# Title: Consent and Ethics Approval Required
# OpenREL Example Access Rules Policy
# Version 0.5 (Draft)
# Revised: 4 November 2026
#
# Developed by Melios Katsamakis and Prodromos Tsiavos
# (OpenAIRE), and Wim Hugo (DANS/EUDAT)
#
# Access to an asset requires:
#
# 1. Consent for the intended use of the asset.
# 2. Approval from an authorised ethics review body.
#
# Both requirements MUST be fulfilled before the
# requested action is permitted.
#
# The obligations apply independently of any licence
# governing the asset.
# ------------------------------------------------------------------

@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ------------------------------------------------------------------
# Access Rules Policy
# ------------------------------------------------------------------

<OR-EA-0.4>
    a openrel:AccessRules ;

    # Citation information
    dct:title "Consent and Ethics Approval Required"@en ;
    dct:alternative "Ethics Approval Required"@en ;
    dct:description "Access rules requiring both consent for the intended use of an asset and approval from an authorised ethics review body before the requested action is permitted."@en ;
    dct:publisher "OpenREL" ;
    dct:created "2026-07-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-11-04T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject
        "Ethics",
        "Ethics Approval",
        "Consent",
        "Research Data Access" ;
    dct:version "0.5" ;

    # Policy metadata
    openrel:accessType openrel:managed ;
    openrel:jurisdiction openrel:worldwide ;
    openrel:validityType openrel:perpetual ;
    openrel:policyStatus openrel:typeTemplate ;

    # Template Parameters
    # These MUST be resolved when the policy is instantiated.
    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;

    # Human-readable policy text
    openrel:policyText
        """Access to the asset requires both consent for
        the intended use and ethics approval from an
        authorised ethics review body.

        Consent and ethics approval MUST be obtained
        and verified before the requested use of the
        asset is permitted.

        Both obligations apply independently of the
        licence governing the asset."""@en ;

    # Optional published representation
    # openrel:encodedRules <PUBLISHED_POLICY_RDF_IRI> ;

    # --------------------------------------------------------------
    # Permission with two mandatory PreDuties
    # --------------------------------------------------------------

    odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:use ;

        # PreDuty 1: Consent to Use and verification
        odrl:duty [
            a openrel:PreDuty ;
            odrl:action odrl:obtainConsent ;
            odrl:constraint openrel:consentPrior
        ] ;

        # PreDuty 2: Ethics Approval and verification
        odrl:duty [
            a openrel:PreDuty ;
            odrl:action openrel:obtainEthicsApproval ;
            odrl:constraint openrel:ethicsApproval
        ]
    ] .

# ------------------------------------------------------------------
# Evaluation Notes
# ------------------------------------------------------------------
#
# 1. Both PreDuties MUST be fulfilled before the
#    requested action is permitted.
# 2. Consent MUST cover the intended use of the asset.
# 3. Ethics approval MUST cover the relevant research
#    activity and intended use.
# 4. The evaluator MUST verify the validity, scope,
#    provenance and applicability of both approvals.
# 5. If either PreDuty remains outstanding, the
#    evaluation outcome is CONDITIONAL, provided
#    fulfilment remains possible.
# 6. If either mandatory PreDuty cannot be fulfilled,
#    the evaluation outcome is DENY.
# 7. PERMIT requires both PreDuties to be satisfied,
#    with no applicable prohibition.
# 8. Verification mechanisms and evidence requirements
#    will be specified separately.
#
# ------------------------------------------------------------------
