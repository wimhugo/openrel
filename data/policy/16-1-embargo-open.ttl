# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Embargo 
# Example Policy
# Embargo is a Process Rule: imposed by an organisation or platform independently of the licence applicable to the asset
# A combination example is also provided
# This Process Rule is specific to an Asset and MUST include a date of asset availability calculated from date of publication
# and indicate the IRI of a specific asset as the target of the policy.
# OpenREL - Open Rights Encoding language
# Version 0.5 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 29 October 2026
# --------------------------------------------------------------------------------------------------------------------------------


@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ------------------------------------------------------------
# Embargo Policy Metadata
# ------------------------------------------------------------

<OR-EM-0.4>
    a openrel:AccessRules ;
    openrel:policyStatus openrel:typeTemplate ;

    # Citation information
    dct:title "Embargo"@en ;
    dct:publisher "OpenREL" ;
    dct:created "2026-07-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-08-03T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Embargo"@en ;
    openrel:accessType openrel:managed ;
    schema:version "0.4" ;

    # Coverage and policy status
    openrel:jurisdiction openrel:worldwide ;
    openrel:policyStatus openrel:typeCustomActive ;

    # Parties and target
    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;

    # Alternative representations
    # openrel:encodedRules <IRI_OF_PUBLISHED_RULES> ;

    # Optional evaluation results
    # openrel:permits <IRI_OF_OTHER_POLICY> ;
    # openrel:contradicts <IRI_OF_OTHER_POLICY> ;
    # openrel:evaluationDetail <OPENREL_EVALUATION> ;

    # --------------------------------------------------------
    # Permission
    # --------------------------------------------------------

    odrl:permission [
        odrl:action odrl:use ;

        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand odrl:dateTime ;
            odrl:operator odrl:gteq ;

            # The embargo end date must be resolved before
            # the permission can be evaluated.
            odrl:rightOperandReference
                openrel:parameterEndDate
        ]
    ] .
