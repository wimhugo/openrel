# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Embargo 
# Example Policy
# Embargo is an Access Rule: imposed by an organisation or platform independently of the licence applicable to the asset
# A combination example is also provided 
# This Process Rule is specific to an Asset and MUST include a date of asset availability calculated from date of publication
# and indicate the IRI of a specific asset as the target of the policy.
# OpenREL - Open Rights Encoding language
# Version 0.5 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 29 October 2026
# --------------------------------------------------------------------------------------------------------------------------------


# ------------------------------------------------------------
# OpenREL Example Policy
# Title: Embargo
# Version: 0.5 (Draft)
# ------------------------------------------------------------

@base <http://www.w3id.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .

<OR-EM-0.5>
    a openrel:AccessRules ;

    dct:title "Embargo"@en ;
    dct:description "An Access Rule that permits use of an Asset only on or after the end of an embargo period. The embargo release date is supplied at runtime through a Parameter."@en ;

    dct:publisher "OpenREL" ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2026-11-05T00:00:00Z"^^xsd:dateTime ;
    dct:subject "Embargo"@en ;
    dct:version "0.5" ;

    openrel:accessType openrel:managed ;
    openrel:policyStatus openrel:typeTemplate ;

    # Template parameters
    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;

    # Permission becomes applicable at embargo release, calculated in a parameterised named constraint
    odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:use ;
        odrl:constraint openrel:calculatedStartDate
    ] .
