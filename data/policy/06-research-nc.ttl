
# ------------------------------------------------------------
# eIDAS Verified Researcher + CC BY-NC 4.0
# OpenREL Composite Policy
# Version 0.5 (Draft)
# Revised: 4 November 2026
# ------------------------------------------------------------

@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ------------------------------------------------------------
# Policy Collection
# ------------------------------------------------------------

<OR-BY-AC-VI-NC-4.0>
    a openrel:PolicyCollection ;
    dct:title "eIDAS Verified Researcher + CC BY-NC 4.0"@en ;
    dct:description "A composite policy combining eIDAS-verified researcher eligibility requirements with the Creative Commons Attribution-NonCommercial 4.0 International licence."@en ;
    dct:publisher "OpenREL" ;
    dct:created "2026-07-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-11-04T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject
        "Researcher",
        "Identified",
        "eIDAS",
        "Non-Commercial",
        "CC BY-NC 4.0" ;
    dct:version "0.5" ;
    openrel:accessType openrel:managed ;
    openrel:jurisdiction openrel:worldwide ;
    openrel:policyStatus openrel:typeTemplate ;

    # --------------------------------------------------------
    # Component Policies
    # --------------------------------------------------------

    openrel:hasPolicy
        <OR-BY-AC-VI-4.0>,
        <CC-BY-NC-4.0> .

# ------------------------------------------------------------
# Template Binding Requirements
# ------------------------------------------------------------
#
# Resolve the following Parameters when instantiating
# the collection and its component policies:
#
# openrel:parameterPublisherIRI
# openrel:parameterAssignerIRI
# openrel:parameterAssigneeIRI
# openrel:parameterTargetIRI
#
# The resolved values MUST be associated with the
# appropriate component policies.
#
# The Parameter individuals themselves are not
# substitutes for the resolved party or asset IRIs.

# ------------------------------------------------------------
# Composite Evaluation Requirements
# ------------------------------------------------------------
# The intended composite decision requires:
# 1. The Process Rules to permit the requested action,
#    including successful researcher verification.
# 2. The CC BY-NC 4.0 Licence to permit the action,
#    subject to its applicable conditions and duties.
# 3. Both decisions to concern the same requestor,
#    asset and requested action.
# 4. Outstanding conditions or duties to be handled
#    according to the OpenREL evaluation contract.
#
# --------------------------------------------------------
# Optional Policy-Level Evaluation (illustrative)
# --------------------------------------------------------
#
# openrel:hasEvaluation [
#     a openrel:EvaluationDetail ;
#     openrel:assertedBy <https://orcid.org/0000-0002-0255-5101> ;
#     openrel:created "2026-11-04"^^xsd:date ;
#     openrel:evaluationOutcome openrel:conditional ;
#     openrel:rationale
#         "The CC BY-NC 4.0 licence permits the
#          requested non-commercial use, subject to
#          applicable licence duties. The additional
#          eIDAS researcher verification requirements
#          must be satisfied before access is granted."@en
# ] ;

