
# ------------------------------------------------------------------
# OpenREL Example Policy
# Title: EU-Only Geographical Restriction
# Version: 0.5 (Draft)
# Type: Access Rules
# ------------------------------------------------------------------

@base <http://www.w3id.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .

@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .

# ------------------------------------------------------------------
# Policy Metadata
# ------------------------------------------------------------------

<OR-EU-0.5>
    a openrel:AccessRules ;

    dct:title "EU-Only Geographical Restriction"@en ;
    dct:alternative "Use Within the European Union Only"@en ;
    dct:description "An access and usage policy requiring all uses of an Asset to occur within the legal territory of the European Union. Use includes downloading, copying, storage, hosting, processing, transformation, analysis, archiving, backup, restoration and other forms of use. The restriction applies throughout the Asset's lifecycle, including after initial access or transfer."@en ;
    dct:subject
        "Geographical restriction"@en ;
    dct:publisher openrel:parameterPublisherIRI ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2026-11-05T00:00:00Z"^^xsd:dateTime ;
    dct.version "0.5" ;

    openrel:accessType openrel:managed ;
    openrel:policyStatus openrel:typeTemplate ;

    # Template parameters
    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;

    # Machine-readable representation
    openrel:encodedRules <OR-EU-0.5> ;

# ------------------------------------------------------------------
# Rules
# ------------------------------------------------------------------

    odrl:permission [
        a odrl:Permission ;
        # Generic use, encompassing narrower use actions
        odrl:action openrel:use ;
        # Reusable geographical constraint
        odrl:constraint openrel:euUseOnly
    ] .

# To include specific end uses in the limitations, either duplicate the permission
# with a narrower action, or add end use actions that do not exist in actions.ttl
# via a pull request to extend the instances of actions.
