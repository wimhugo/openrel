@prefix dalicclib: <https://dalicc.net/licenselibrary/> 
@prefix lfslib: <https://lfs.labs.dansdemo.nl/api/v1/licenses/> .

# --------------------------------------------------------------------------------------------------------------------------------
# Access Rules Metadata
# --------------------------------------------------------------------------------------------------------------------------------

<OR-EU-0.4> a openrel:AccessRules ;
    # Alternate identifiers
    ## skos:exactMatch lfslib:[TO_BE_REGISTERED] ;

    # Citation Information
    dc:title "EU-Only Geographical Restriction" ;
    dct:alternative "Use in EU Only" ;
    dct:publisher openrel:parameterPublisherIRI ;
    dct:created "2026-07-12T00:00:00+00:00" ;
    dct:modified "2026-08-03T00:00:00+00:00" ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Time-Limited Access" ;
    openrel:accessType openrel:managed ;
    dct:version "0.1" ;

    # Coverage related information
    # These properties apply only for those policies that explicitly require them, optional for others
    # openrel:validityType openrel:perpetual ;
    openrel:jurisdiction openrel:worldwide ;
    openrel:policyStatus openrel:typePrivateActive ;
    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;

    # Alternative representations, mappings of SPDX and LFS properties
    openrel:policyText "**Time Limited Access** is an **Access Rule** imposed by an organisation or platform independently of the licence applicable to the asset. The motivation may, for example, be to re-evaluate context of the assignee at the completion of the access period"@en ;
    openrel:encodedRules openrellib:OR-EU-0.4 ;

# --------------------------------------------------------------------------------------------------------------------------------
#   Rules
# --------------------------------------------------------------------------------------------------------------------------------
    
    odrl:permission [
        odrl:action openrel:use ;
        odrl:namedconstraint openrel:euUseOnly ;
    ] ;
    
    openrel:evaluation "permit | deny" ;
    openrel:machineActionable "true" 
.

