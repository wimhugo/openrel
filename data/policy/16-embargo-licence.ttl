# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Embargo Plus an Otherwise Open Licence
# Example Policy 
# Embargo is a Process Rule: imposed by an organisation or platform independently of the licence applicable to the asset
# A combination example is also provided (this file)
# Process Rule instances are specific to an Asset and MUST include a date of asset availability calculated from date of publication
# and indicate the IRI of a specific asset as the target of the policy.
# OpenREL - Open Rights Encoding language
# Version 0.5 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 05 November 2026
# --------------------------------------------------------------------------------------------------------------------------------


@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<OR-BY-EM-0.2>
    a openrel:PolicyCollection ;

    dct:title "CC BY 4.0 with Embargo"@en ;
    dct:description "A collection combining a CC BY 4.0 licence with an Access Rule governing the earliest date of authorised access or use of an Asset. The embargo does not modify the terms of the CC BY 4.0 licence."@en ;
    dct:publisher "OpenREL" ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:subject "Embargo"@en, "CC BY 4.0"@en ;
    dct:version "0.5" ;
    openrel:accessType openrel:managed ;
    openrel:policyStatus openrel:typeTemplate ;

    # Constituent policies.
    # These IRIs must identify the actual policy encodings.
    openrel:hasPolicy
        <OR-EM-0.5>,
        <CC-BY-4.0> .

