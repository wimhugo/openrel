# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Agentic AI — Delegated Access with Audit Trail
# Example Policy
# Repositories may limit access to AI agents and require auditable records of access
# This Process Rule is specific to an Asset Collection and a Repository harvesting Endpoint
# OpenREL - Open Rights Encoding language
# Version 0.4 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 3 August 2026
# --------------------------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix dpv: <https://w3id.org/dpv/> .
# Policy Libraries and Registries
@prefix openrellib: <https://github.com/wimhugo/openrel/new/main/data/policy/> .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> 
@prefix lfslib: <https://lfs.labs.dansdemo.nl/api/v1/licenses/> .

# --------------------------------------------------------------------------------------------------------------------------------
# Access Rules Metadata
# --------------------------------------------------------------------------------------------------------------------------------

<OR-AI-AU-0.4> a openrel:ProcessRules ;
    # Alternate identifiers
    # skos:exactMatch spdx:<> ;
    # skos:exactMatch lfs:<> ;

    # Citation Information
    dct:title "Agentic AI — Delegated Access with Audit Trail" ;
    dct:publisher <> ;
    dct:created "2026-07-12T00:00:00+00:00" ;
    dct:modified "2026-08-03T00:00:00+00:00" ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "AI Agent Access and Process" ;
    openrel:accessType openrel:managed ;
    dct:source <> ;
    dct:version "0.4" ;

    # Coverage related information
    # These properties apply only for those policies that explicitly require them, optional for others
    # openrel:validityType openrel:perpetual ;
    openrel:jurisdiction openrel:worldwide ;
    odrl:assigner parameterAssignerIRI ;
    odrl:assignee parameterAssigneeIRI ;
    odrl:target parameterTargetIRI ;

    # Disclaimers
    ## openrel:liabilityLimitation {{Liability Limitation Text}} ;
    ## openrel:warrantyNotice {{Warranty Notice Text}} ;

    # Alternative representations, mappings of SPDX and LFS properties
    ## openrel:legalcode <> ;
    ## openrel:policyTextHtml <> ;
    ## openrel:policyText lfslib:[TO_BE_REGISTERED]/original ;
    openrel:encodedRules openrel:OR-AI-AU-0.4 ;

	# Optional results of evaluation of two policies
    ## openrel:permits <IRI_OF_OTHER_POLICY> ;
	## openrel:contradicts <IRI_OF_OTHER_POLICY> ;
    ## openrel:evaluationDetail <OPENREL_EVALUATION> ;

# --------------------------------------------------------------------------------------------------------------------------------
#   Rules
# --------------------------------------------------------------------------------------------------------------------------------
    
	odrl:permission [
		odrl:action openrel:use ;
		odrl:constraint <verified-AI-agent> ;
		odrl:constraint <humanOversight>
		odrl:duty [
			a openrel:NamedConstraint
			@id openrel:notifyClearingHouse ;
			openrel:applicableEndpoint openrel:parameterClearingHouseAPI
		  ]
	  ] ;

	odrl:prohibition [
		odrl:action openrel:use ;
		odrl:constraint <notDeclaredPurpose>
	] ;

	odrl:obligation [
		odrl:action openrel:use ;
		odrl:constraint <dataMinimisationSpec>
	] ;
		
# --------------------------------------------------------------------------------------------------------------------------------
# Custom Named Constraints
# --------------------------------------------------------------------------------------------------------------------------------

<tokenVerified>
	 a openrel:NamedConstraint ;
		rdfs:label "Authorised URI Only"@en ;
		skos:definition "Asset MUST only distributed to an authorised endpoint URI"@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:tom ;
		openrel:scenario openrel:formal-toms ;
		odrl:leftOperand openrel:delegationToken ;
		odrl:operator odrl:eq ;
		odrl:rightOperand openrel:parameterAccessToken ;
    	openrel:applicableEndpoint openrel:parameterTokenVerificationAPI
		.

<notDeclaredPurpose>
	 a openrel:NamedConstraint ;
		rdfs:label "Declared Purpose" ;
		skos:definition "IRL to a resource with a declared purpose of use." ;
		skos:note "Purpose drift prohibited — agent may not use data outside declared scope." ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:usage ;
		openrel:scenario openrel:explicit-consent ;
		odrl:leftOperand odrl:purpose ;
		odrl:operator odrl:neq ;
		odrl:rightOperand openrel:parameterPurposeIRI ;
		openrel:applicableEndpoint openrel:parameterPurposeVerificationIRI 
		.

<explicitConsentObtained>
	 	a openrel:NamedConstraint ;
		rdfs:label "Explicit Consent Obtained" ;
		skos:definition "IRL to a resource with explicit consent for the declared purpose of use." ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:usage ;
		openrel:scenario openrel:explicit-consent ;
		odrl:assigner openrel:parameterDataSubjectIRI ;
		odrl:leftOperand openrel:consentRequired ;
		odrl:operator odrl:eq ;
		odrl:rightOperand openrel:consent-reuse-before ;
		openrel:applicableEndpoint openrel:parameterInformedConsentIRI
		.

<consentExpiry>
	 	a openrel:NamedConstraint ;
		rdfs:label "Explicit Consent Expires" ;
		skos:definition "Explicit consent to use the data is time limited." ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:usage ;
		openrel:scenario openrel:tech-limits ;
		odrl:assigner openrel:parameterDataSubjectIRI ;
		odrl:leftOperand odrl:dateTime ;
		odrl:operator odrl:lteq ;
		odrl:rightOperand openrel:parameterConsentExpiryDate ;
		openrel:applicableEndpoint openrel:parameterInformedConsentIRI
		.

<dataMinimisationSpec>
	 a openrel:NamedConstraint ;
		rdfs:label "Data Minimisation Specification"@en ;
		skos:definition "Data minimisation: agent may only access fields required for declared purpose."@en ;
		skos:note "For sensitive data, the OpenREL extensions to DPV may be used to encode the specification."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:tom ;
		openrel:scenario openrel:formal-toms ;
		odrl:leftOperand openrel:usageLimitation ;
		odrl:operator odrl:eq ;
		odrl:rightOperand openrel:dataMinimisation ;
    	openrel:applicableEndpoint openrel:parameterDataSpecIRI
		.

# --------------------------------------------------------------------------------------------------------------------------------
# Custom Logical Constraints
# --------------------------------------------------------------------------------------------------------------------------------

<verified-AI-agent>
    a odrl:LogicalConstraint ;
    odrl:and (
        openrel:eidasVerified
        openrel:confirmedAIAgent
        openrel:trustPlus
        <tokenVerified>
    ) 

<humanOversight>
    a odrl:LogicalConstraint ;
    odrl:and (
		<consentExpiry>
		<explicitConsentObtained>
    ) 
.
