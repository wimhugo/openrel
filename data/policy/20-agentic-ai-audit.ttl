# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Agentic AI — Delegated Access with Audit Trail
# Example Policy
# Repositories may limit access to AI agents and require auditable records of access
# This Process Rule is specific to an Asset Collection and a Repository harvesting Endpoint
# OpenREL - Open Rights Encoding language
# Version 0.5 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 5 November 2026
# --------------------------------------------------------------------------------------------------------------------------------

@base <http://www.w3id.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<OR-AI-AU-0.5>
    a openrel:ProcessRules ;
    
	dct:title "Agentic AI - Delegated Access with Audit Trail"@en ;
    dct:description "Template for controlled AI-agent access with identity and trust checks, scoped delegation, purpose and consent checks, data minimisation and audit duties."@en ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2026-11-05T00:00:00Z"^^xsd:dateTime ;
    dct:version "0.5" ;
    dct:subject "AI Agent Access and Process"@en ;
    
	openrel:accessType openrel:managed ;
    openrel:jurisdiction openrel:worldwide ;
    openrel:policyStatus openrel:typeTemplate ;
    
	odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;
    
# ----------------------------------------------------------------------------------------------	
# Rules
# ----------------------------------------------------------------------------------------------

	odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:use ;
        odrl:constraint [
            a odrl:LogicalConstraint ;
            odrl:and (
                openrel:eidasVerified
                openrel:confirmedAIAgent
                openrel:trustPlus
                <OR-AI-AU-0.5-token-verified>
                <OR-AI-AU-0.5-purpose-matched>
                <OR-AI-AU-0.5-consent-valid>
                <OR-AI-AU-0.5-consent-unexpired>
                <OR-AI-AU-0.5-data-minimised>
            )
        ] ;
        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:log ;
            odrl:constraint openrel:logUse
        ] ;
        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:log ;
            odrl:constraint openrel:notifyClearingHouse
        ]
    ] .


# ----------------------------------------------------------------------------------------------	
# Example Named Constraints (provisional)
# Token comparison is provisional: a valid delegation must also bind
# the principal, agent, target, action, purpose and expiry.
# ----------------------------------------------------------------------------------------------

<OR-AI-AU-0.5-token-verified>
    a openrel:NamedConstraint, skos:Concept ;
    rdfs:label "Delegation token verified"@en ;
    skos:definition "Checks a delegation token presented by the requesting agent against the platform token context."@en ;
    skos:note "Token equality alone does not establish delegation scope or validity; the verification endpoint MUST validate signature, expiry, revocation, principal, agent, target, action and purpose."@en ;
    openrel:constraintType openrel:tom ;
    odrl:leftOperand openrel:delegationToken ;
    odrl:operator odrl:eq ;
    odrl:rightOperandReference openrel:parameterAccessToken ;
    openrel:applicableEndpoint openrel:parameterTokenVerificationAPI .

<OR-AI-AU-0.5-purpose-matched>
    a openrel:NamedConstraint, skos:Concept ;
    rdfs:label "Requested purpose matches declared purpose"@en ;
    skos:definition "Requires the requested use purpose to match the purpose resolved for this request."@en ;
    skos:note "The resolved purpose MUST also be authorised by the delegation and applicable consent or other legal authorisation."@en ;
    openrel:constraintType openrel:usage ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperandReference openrel:parameterPurposeIRI ;
    openrel:applicableEndpoint openrel:parameterPurposeVerificationIRI .

<OR-AI-AU-0.5-consent-valid>
    a openrel:NamedConstraint, skos:Concept ;
    rdfs:label "Consent evidence verified"@en ;
    skos:definition "Requires the consent evidence identified for the request to be verified as applicable and currently valid."@en ;
    skos:note "The evaluator MUST check the consenting principal, asset/data subset, purpose, scope, revocation status and validity of the evidence. This constraint does not itself encode these checks."@en ;
    openrel:constraintType openrel:usage ;
    odrl:leftOperand openrel:consentRequired ;
    odrl:operator odrl:eq ;
    odrl:rightOperandReference openrel:parameterInformedConsentIRI .

<OR-AI-AU-0.5-consent-unexpired>
    a openrel:NamedConstraint, skos:Concept ;
    rdfs:label "Consent has not expired"@en ;
    skos:definition "Requires the evaluation time to be no later than the consent expiry timestamp."@en ;
    openrel:constraintType openrel:usage ;
    odrl:leftOperand odrl:dateTime ;
    odrl:operator odrl:lteq ;
    odrl:rightOperandReference openrel:parameterConsentExpiryDate .

<OR-AI-AU-0.5-data-minimised>
    a openrel:NamedConstraint, skos:Concept ;
    rdfs:label "Data subset restricted to authorised specification"@en ;
    skos:definition "Requires the data selected for access to comply with the authorised data specification."@en ;
    skos:note "This is a provisional equality test. A proper subset comparison and a request-data-subset LeftOperand are required for interoperable enforcement."@en ;
    openrel:constraintType openrel:tom ;
    odrl:leftOperand openrel:usageLimitation ;
    odrl:operator odrl:eq ;
    odrl:rightOperandReference openrel:parameterDataSpecIRI .
