# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Institution allows research and academic users only
# Example Policy
# OpenREL - Open Rights Encoding language
# Version 0.5 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 05 November 2026
# --------------------------------------------------------------------------------------------------------------------------------


@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<OR-IN-RO-0.5>
    a openrel:AccessRules ;

    dct:title "Repository Researcher-Only Access Rules"@en ;
    dct:description "A baseline repository access policy permitting use of an Asset only by agents whose researcher role has been established through an accepted assertion or verification mechanism."@en ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2026-11-05T00:00:00Z"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Researcher", "Repository Access" ;
    dct:version "0.5" ;

    openrel:accessType openrel:managed ;
    openrel:policyStatus openrel:typeTemplate ;

    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:target openrel:parameterTargetIRI ;

    odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:use ;
        odrl:constraint openrel:verifiedResearcher
    ] .
