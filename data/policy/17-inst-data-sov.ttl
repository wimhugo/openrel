# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Institutional Data Sovereignty
# Example Policy
# Assets may only be used by members of an institution and processed or stored on institutional infrastructure
# This Process Rule may not be compatible with open licences that apply world-wide.
# It may be compatible with CC BY ND 4.0, which prohibits derivatives to be shared.
# OpenREL - Open Rights Encoding language
# Version 0.5 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 5 November 2026
# --------------------------------------------------------------------------------------------------------------------------------


@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<OR-SD-IN-0.5>
    a openrel:ProcessRules ;

    dct:title "Institutional Data Sovereignty"@en ;
    dct:description "A policy restricting the use of an Asset to infrastructure authorised by a designated institution and to agents with verified institutional affiliation."@en ;

    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2026-11-04T00:00:00Z"^^xsd:dateTime ;
    dct:subject "Institutional Data Sovereignty"@en ;
    dct:version "0.5" ;

    openrel:accessType openrel:managed ;
    openrel:policyStatus openrel:typeTemplate ;

    # The parameters have to be resolved at run-time or based on repository context
    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;

# ---------------------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------------------

    # All conditions MUST be satisfied.

    odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:use ;
        odrl:constraint [
            a odrl:LogicalConstraint ;
            odrl:and (
                openrel:institutionalInfrastructure
                openrel:institutionalAffiliation
            )
        ]
    ] ;
    
    odrl:prohibition [
        a odrl:Prohibition ;
        odrl:action odrl:distribute ;
        odrl:constraint openrel:externalRecipient
    ] 
    .

# Additional external-replication restriction:
# A future prohibition should constrain the
# destination infrastructure of reproduction
# or transfer, rather than the current asset
# location. At the moment, the recipient (agent) 
# cannot be unaffiliated with the institution.
