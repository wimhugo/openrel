# Title: Researcher-Only Access with eIDAS Verification
# Example Policy
# OpenREL - Open Rights Encoding language
# Version 0.5 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 29 October 2026
# --------------------------------------------------------------------------------------------------------------------------------


@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ------------------------------------------------------------
# Process Rules Metadata
# ------------------------------------------------------------

<OR-BY-AC-VI-4.0>
    a openrel:ProcessRules ;
    openrel:policyStatus openrel:typeTemplate ;

    # Parties and target
    odrl:assigner [ASSIGNER_URI] ;
    odrl:assignee [ASSIGNEE_URI] ;
    odrl:target [TARGET_URI] ;

    # Citation information
    dct:title "OpenREL Academic eIDAS Verified Identity"@en ;
    dct:alternative "eIDAS Researcher Verification"@en ;
    dct:description "Process rules applicable to the verification of researcher identity."@en ;
    dct:publisher "OpenREL" ;
    dct:created "2026-07-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-10-29T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Identity Verification", "eIDAS", "Researcher" ;

    openrel:accessType openrel:managed ;
    schema:version "0.5" ;

    # Coverage and policy status
    cc:jurisdiction openrel:worldwide ;
    openrel:validityType openrel:perpetual ;
    openrel:policyStatus openrel:typeCustomActive ;

    # Disclaimers
    openrel:liabilityLimitation ""@en ;
    openrel:warrantyNotice ""@en ;

    # Alternative representation
    openrel:encodedRules <https://github.com/wimhugo/openrel/blob/main/data/policy/OR-BY-AC-VI-4.0> ;

# --------------------------------------------------------
# Rules
# --------------------------------------------------------

    odrl:permission [
        odrl:action odrl:use ;
        odrl:constraint <11-eidas-researcher>
    ] .

# ---------------------------------------------------------
# Logical Constraints
# ---------------------------------------------------------

<11-eidas-researcher>
    a odrl:LogicalConstraint ;
    odrl:or (
        <11-verifiedResearcher>
        openrel:eidasVerifiedResearcher
    ) .

<11-verifiedResearcher>
    a odrl:LogicalConstraint ;
    odrl:or (
        openrel:verifiedResearcher
        openrel:eidasVerified
    ) .

