
# ------------------------------------------------------------
# Researcher-Only Access with eIDAS Verification
# OpenREL Process Rules
# Version 0.5 (Draft)
# Revised: 4 November 2026
# ------------------------------------------------------------

@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ------------------------------------------------------------
# Process Rules Metadata
# ------------------------------------------------------------

<OR-BY-AC-VI-4.0>
    a openrel:ProcessRules ;

    # resolve at run-time from appropriate context
    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;


    dct:title "OpenREL Academic eIDAS Verified Identity"@en ;

    dct:alternative "eIDAS Researcher Verification"@en ;

    dct:description
        """Process rules requiring eIDAS-verified identity
        and verified researcher status. Researcher status
        may be established either through an accepted
        eIDAS assertion that includes researcher status,
        or through independent trusted verification
        combined with eIDAS identity verification."""@en ;

    dct:publisher "OpenREL" ;
    dct:created "2026-07-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-11-04T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;

    dct:subject
        "Identity Verification",
        "eIDAS",
        "Researcher" ;

    openrel:accessType openrel:managed ;
    dct:version "0.5" ;

    openrel:jurisdiction openrel:worldwide ;
    openrel:validityType openrel:perpetual ;
    openrel:policyStatus openrel:typeTemplate ;

    # Replace with the published RDF resource IRI.
    # openrel:encodedRules <PUBLISHED_POLICY_RDF_IRI> ;

    # --------------------------------------------------------
    # Permission
    # --------------------------------------------------------

    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:use ;

        odrl:constraint <11-eidas-researcher>
    ] .

# ------------------------------------------------------------
# Logical Constraints
# ------------------------------------------------------------

# Pathway A OR Pathway B

<11-eidas-researcher>
    a odrl:LogicalConstraint ;
    odrl:or (
        openrel:eidasVerifiedResearcher
        <11-verifiedResearcher>
    ) .

# Pathway B:
# eIDAS identity AND independently verified researcher status

<11-verifiedResearcher>
    a odrl:LogicalConstraint ;
    odrl:and (
        openrel:eidasVerified
        openrel:verifiedResearcher
    ) .

# ------------------------------------------------------------
# Named Constraint semantics
# ------------------------------------------------------------
#
# openrel:eidasVerifiedResearcher
#   MUST establish both eIDAS-verified identity and
#   researcher status associated with that identity.
#
# openrel:eidasVerified
#   MUST establish eIDAS-verified identity.
#
# openrel:verifiedResearcher
#   MUST establish researcher status through an accepted
#   trusted mechanism.
#
# For Pathway B, both assertions MUST refer to the same
# person, with appropriate identity linking.
#
# REVIEW: An identity or researcher-status assertion
# should include evidence provenance, validity and
# verification status.
#
# ------------------------------------------------------------
# TEMPLATE STATUS
# ------------------------------------------------------------
#
# This policy remains a template.
#
# When instantiated:
# - Resolve assigner, assignee and target.
# - Set the appropriate active policy status.
# - Confirm the trusted sources for researcher status.
# - Verify that the logical constraints can be evaluated.
#
# ------------------------------------------------------------

