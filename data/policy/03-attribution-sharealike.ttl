    # Publication reference pending verification.
    # openrel:encodedRules <PUBLISHED_POLICY_RDF_IRI> ;

    # --------------------------------------------------------
    # Permissions
    # --------------------------------------------------------

    # Display
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:display
    ] ;

    # Distribution
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:distribute ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:attribute
        ] ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:notify ;
            openrel:namedConstraint openrel:notifyInAsset
        ] ;

        # ShareAlike applies when distributing adaptations.
        # It does not require unchanged material to be
        # relicensed under a ShareAlike licence.
        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:shareAlike
        ]
    ] ;

    # Modification
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:modify ;

        # Attribution and change notices are required
        # when modified material is shared.
        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:attribute
        ] ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:notify ;
            openrel:namedConstraint openrel:notifyInAsset
        ]
    ] ;

    # Derivation
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:derive ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:attribute
        ] ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:notify ;
            openrel:namedConstraint openrel:notifyInAsset
        ]
    ] ;

    # Presentation
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:present
    ] ;

    # Reproduction
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:reproduce
    ] ;

    # Recovery of reasonable distribution costs
    odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:costRecovery ;
        openrel:namedConstraint
            openrel:allowDistributionFee
    ] .
