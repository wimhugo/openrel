@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix lfslib: <https://lfs.labs.dansdemo.nl/api/v1/licenses/> .

# ------------------------------------------------------------
# Licence Metadata
# ------------------------------------------------------------

<CC-BY-SA-4.0>
    a openrel:Licence ;

    # Provenance
    prov:wasDerivedFrom dalicclib:CC-BY-SA-4.0 ;
    dct:contributor "Giray Havur" ;

    # Alternate identifiers
    dct:relation spdxlicense:CC-BY-SA-4.0 ;
    dct:relation lfslib:CC-BY-SA-4.0 ;

    # Citation information
    dct:title
        "Creative Commons Attribution-ShareAlike 4.0 International"@en ;

    dct:alternative
        "Attribution ShareAlike 4.0 International"@en,
        "Attribution-ShareAlike 4.0"@en,
        "Attribution-ShareAlike 4.0 International"@en,
        "CC BY SA 4.0"@en,
        "CC BY SA 4.0 International"@en,
        "CC BY-SA 4.0"@en,
        "CC BY-SA 4.0 International"@en,
        "CC-BY-SA 4.0"@en,
        "CC-BY-SA 4.0 International"@en,
        "Creative Commons BY-SA 4.0"@en,
        "Creative Commons BY-SA 4.0 International"@en ;

    dct:description
        """The licence permits sharing and adaptation of the
        licensed material, including for commercial purposes.
        Attribution is required, and shared adaptations must
        be licensed under the same or a compatible licence
        as specified by CC BY-SA 4.0."""@en ;

    dct:publisher "Creative Commons" ;
    dct:created "2026-07-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-11-04T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Attribution", "ShareAlike", "Open Licensing" ;
    dct:source <https://creativecommons.org/licenses/by-sa/4.0/> ;
    schema:version "4.0" ;

    # Access, coverage and status
    openrel:accessType openrel:open-access ;
    openrel:jurisdiction openrel:worldwide ;
    openrel:validityType openrel:perpetual ;
    openrel:policyStatus openrel:typeGlobalActive ;

    # Disclaimers
    openrel:liabilityLimitation
        """To the extent possible, in no event will the Licensor
        be liable to You on any legal theory (including, without
        limitation, negligence) or otherwise for any direct,
        special, indirect, incidental, consequential, punitive,
        exemplary, or other losses, costs, expenses, or damages
