    # Alternative representations
    openrel:legalcode
        <https://creativecommons.org/licenses/by-sa/4.0/legalcode> ;

    openrel:policyTextHtml
        <https://spdx.org/licenses/CC-BY-SA-4.0.html> ;

    openrel:policyText
