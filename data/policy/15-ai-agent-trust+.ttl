@base <http://www.w3id.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<OR-AI-TR-PL-0.5>
    a openrel:ProcessRules ;

    dct:title "Trust+ Certified Endpoint with Clearinghouse Reporting"@en ;
    dct:description "A policy permitting use of an Asset only through an endpoint or connector with a verified IDS Trust+ security profile, and requiring notification of each use to a designated clearinghouse."@en ;
    dct:publisher <https://ror.org/019kf3481> ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2026-11-05T00:00:00Z"^^xsd:dateTime ;
    dct:source <https://kb.internationaldataspaces.org/external/rulebook/103_Establishing_Trust/> ;
    dct:subject "Connector security and usage reporting"@en ;
    dct:version "0.5" ;
    openrel:accessType openrel:managed ;
    openrel:policyStatus openrel:typeTemplate ;

    # Parameters resolved before evaluation
    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;

    # --------------------------------------------------------
    # Permission subject to verified Trust+
    # --------------------------------------------------------

    odrl:permission [
        a odrl:Permission ;
        dct:description "Use is permitted only when the endpoint or connector performing the use has a verified, currently valid IDS Trust+ certification."@en ;
        odrl:action openrel:use ;
        odrl:constraint openrel:trustPlus ;
        # Notification required for each use
        odrl:duty [
            a openrel:PostDuty ;
            dct:description "Report each use of the Asset to the designated clearinghouse endpoint."@en ;
            odrl:action openrel:notify ;
            odrl:constraint openrel:notifyClearingHouse ;
            odrl:target openrel:parameterClearingHouseAPI
        ]
    ] .

