# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dpv: <https://w3id.org/dpv> .
@prefix lfs: <https://lfs.labs.dansdemo.nl/api/v1/licenses> .

# --------------------------------------------------------------------------------------------------------------------------------
# Access Rules Metadata
# --------------------------------------------------------------------------------------------------------------------------------

<OR-OPENAIRE-PRIVACY-2.7> a openrel:ProcessRules ;
    # Alternate identifiers
    ## dct:relation spdx:<> ;
    ## dct:relation lfs:[TO_BE_REGISTERED] ;

    # Citation Information
    dc:title "OpenAIRE Personal Data Processing Policy" ;
    dct:alternative "OpenAIRE Privacy Policy" ;
    dct:publisher <https://ror.org/019kf3481> ;
    dct:created "2026-07-12T00:00:00+00:00" ;
    dct:mofified "2026-31-12T00:00:00+00:00" ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Privacy" ;
	dct:licence spdxlicense:CC-BY-4.0 ;
    dct:source <https://www.openaire.eu/privacy-policy> ;
    dct:version "2.7" ;

    # Coverage related information
    # These properties apply only for those policies that explicitly require them, optional for others
    openrel:validityType openrel:perpetual ;
    openrel:jurisdiction openrel:worldwide ;
    odrl:assignee <https://openaire.eu> ;
    ## odrl:assigner parameterDataSubjectIRI ;
    ## odrl:target parameterTargetIRI ;

    # Disclaimers
    ## openrel:liabilityLimitation "{{Liability Limitation Text}}" ;
    ## openrel:warrantyNotice "{{Warranty Notice Text}}" ;
    
	# Alternative representations, mappings of SPDX and LFS properties
    ## openrel:legalCode <IRI_TO_LEGAL_CODE>;
    ## openrel:policyTextHtml <IRI_TO_HTML_VIEW> ;
    ## openrel:policyText <https://www.openaire.eu/privacy-policy> ;
    ## openrel:encodedRules openrellib:OR-OPENAIRE-PRIVACY-2.7 ;
	
	# Optional results of evaluation of two policies
    ## openrel:permits <IRI_OF_OTHER_POLICY> ;
	## openrel:contradicts <IRI_OF_OTHER_POLICY> ;
    ## openrel:evaluationDetail <OPENREL_EVALUATION> ;

# --------------------------------------------------------------------------------------------------------------------------------
#   Rules
# ---------------------------------- ----------------------------------------------------------------------------------------------
    
    odrl:permission [
		dct:description "Data may only be used in the EU." ;
        odrl:action openrel:use ;
        odrl:namedconstraint openrel:euUseOnly ;
    ] ;

    odrl:permission [
		dct:description "Newsletter — email under explicit consent." ;
        odrl:action openrel:action.use ;
        odrl:constraint [
            odrl:leftOperand openrel:legalBasis ;
            odrl:operator odrl:eq ;
            odrl:rightOperand dpv:Consent
        ] ;
        odrl:constraint [
            odrl:leftOperand openrel:leftOperand.purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand dpv:ServiceProvision
        ] ;
        odrl:duty [
            odrl:action sensitiveDataConsent 
        ] ;
        odrl:duty [
            odrl:action openrel:log	;
			odrl:constraint openrel:logUse ;	
        ]
    ] ;

    odrl:permission [
		dct:description "Website visit — IP address/ cookies under legitimate interest." ;
        odrl:action openrel:use ;
        odrl:constraint [
            odrl:leftOperand openrel:legalBasis ;
            odrl:operator odrl:eq ;
            odrl:rightOperand dpv:LegitimateInterest
        ] ;
        odrl:constraint [
            odrl:leftOperand openrel:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand dpv:Analytics
        ] ;
        odrl:duty [
            odrl:action openrel:encrypt
        ]
    ] ;

    odrl:prohibition [
        dc:description "No third-party sharing outside service provision." ;
        odrl:action openrel:distribute ;
        odrl:constraint [
            odrl:leftOperand openrel:purpose ;
            odrl:operator odrl:neq ;  
            odrl:rightOperand dpv:ServiceProvision
        ]
    ] ;

    odrl:prohibition [
        odrl:action openrel:use ;
        openrel:namedConstraint openrel:noSpecialCategory
    ] ;
    
	odrl:permission [
        odrl:action openrel:delete ;
        dc:description "Delete on consent withdrawal or erasure request (GDPR Art.17)."
    ] ;
    
	odrl:obligation [
        odrl:action openrel:notify ;
        dc:description "Notify data subjects of policy changes within 5 days."
    ] ;

.

openrel:dataSubjectRights openrel:right-access ;
openrel:dataSubjectRights openrel:right-rectification ;
openrel:dataSubjectRights openrel:right-erasure ;
openrel:dataSubjectRights openrel:right-restriction ;
openrel:dataSubjectRights openrel:right-portability  ;

# --------------------------------------
# Custom Logical Constraints
# --------------------------------------
# None

# --------------------------------------
# Custom Named Constraints
# --------------------------------------

# In constraints.ttl
# openrel:noSpecialCategory



.
