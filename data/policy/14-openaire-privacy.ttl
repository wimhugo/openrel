# --------------------------------------------------------------------------------------------------------------------------------
# OpenREL Example Policy
# Title: OpenAIRE Personal Data Processing Policy
# OpenREL - Open Rights Encoding language
# Version 0.5 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 05 November 2026
# --------------------------------------------------------------------------------------------------------------------------------
# This is an illustrative encoding of declared processing practices, not an independent legal authorisation to process personal data.
# --------------------------------------------------------------------------------------------------------------------------------

@base <http://www.w3id.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix schema: <http://schema.org/> .

# ------------------------------------------------------------
# Policy metadata
# ------------------------------------------------------------

<OR-OPENAIRE-PRIVACY-2.8>
    a openrel:ProcessRules, odrl:Privacy ;

    dct:title "OpenAIRE Personal Data Processing Policy"@en ;
    dct:alternative
        "OpenAIRE Privacy Policy"@en ;
    dct:description "An illustrative machine-readable representation of personal data processing practices, restrictions, obligations and data subject rights associated with OpenAIRE services."@en ;
    dct:publisher <https://ror.org/019kf3481> ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2026-11-05T00:00:00Z"^^xsd:dateTime ;
    dct:source <https://www.openaire.eu/privacy-policy> ;
    dct:version "2.8-draft" ;
    dct:subject "Personal data processing"@en ;
    openrel:policyStatus openrel:typeCustomActive ;
    openrel:accessType openrel:open-access ;

    # Template parameters, resolved before evaluation
    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:target openrel:parameterTargetIRI ;

    # --------------------------------------------------------
    # Subject rights descriptive metadata - supported rights
    # --------------------------------------------------------

    openrel:subjectRights
        openrel:right-access,
        openrel:right-rectification,
        openrel:right-erasure,
        openrel:right-restriction,
        openrel:right-portability,
        openrel:right-object,
        openrel:right-withdraw,
        openrel:right-complaint,
        openrel:right-non-automation ;

    # --------------------------------------------------------
    # Processing permissions
    # --------------------------------------------------------

    # Newsletter communications, subject to prior consent.
    # A specific newsletter data target and purpose should
    # be supplied in the operational policy.

    odrl:permission [
        a odrl:Permission ;
        dct:description "Processing of newsletter subscription data subject to valid prior consent."@en ;
        odrl:action openrel:use ;
        odrl:duty [
            a openrel:PreDuty ;
            odrl:action odrl:obtainConsent ;
            odrl:constraint openrel:consentPrior
        ]
    ] ;

    # Website analytics.
    # The legal basis, specific purpose, cookie requirements
    # and data categories must be confirmed before this rule
    # can be made operational.

    odrl:permission [
        a odrl:Permission ;
        dct:description "Processing of website usage information for analytics, subject to the applicable legal basis and processing conditions."@en ;
        odrl:action openrel:use
    ] ;

    # --------------------------------------------------------
    # Processing restrictions
    # --------------------------------------------------------

    odrl:prohibition [
        a odrl:Prohibition ;
        dct:description "Disclosure of personal data for purposes outside the authorised processing purposes is prohibited, except where another applicable legal basis permits or requires disclosure."@en ;
        odrl:action openrel:distribute
    ] ;

    # --------------------------------------------------------
    # Operational obligations
    # --------------------------------------------------------

    odrl:obligation [
        a odrl:Duty ;
        dct:description "Apply appropriate encryption controls to personal data where required by the applicable security measures."@en ;
        odrl:action openrel:encrypt
    ] ;

    odrl:obligation [
        a odrl:Duty ;
        dct:description "Erase personal data when an applicable erasure obligation arises, subject to statutory exceptions and retention duties."@en ;
        odrl:action openrel:delete
    ] ;

    odrl:obligation [
        a odrl:Duty ;
        dct:description "Provide required notifications to affected data subjects when an applicable notification obligation is triggered."@en ;
        odrl:action openrel:notify
    ] .
