# ------------------------------------------------------------
# Licence Metadata
# ------------------------------------------------------------

<CC0-1.0>
    a openrel:Licence ;

    # Alternate identifiers
    dct:relation spdxlicense:CC0-1.0 ;
    dct:relation lfslib:CC0-1.0 ;

    # Citation information
    dct:title "Creative Commons Zero v1.0 Universal"@en ;
    dct:description
        "Anyone can read, download, share, and reuse this resource freely, for any purpose including commercial use."@en ;
    dct:publisher "Creative Commons" ;
    dct:created "2026-07-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-08-03T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Public Domain"@en ;
    dct:source <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:version "1.0" ;

    # Access and coverage
    openrel:accessType openrel:open-access ;
    openrel:validityType openrel:perpetual ;
    openrel:jurisdiction openrel:worldwide ;
    openrel:policyStatus openrel:typeGlobalActive ;

    # Disclaimers
    # The waiver text below is retained from the source
    # policy. It describes the waiver of rights rather
