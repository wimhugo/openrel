@prefix lfslib: <https://lfs.labs.dansdemo.nl/api/v1/licenses/> .

# ------------------------------------------------------------
# Licence metadata
# ------------------------------------------------------------

<CC-BY-NC-4.0>
    a openrel:Licence ;

    # Provenance
    prov:wasDerivedFrom dalicclib:CC-BY-NC-4.0 ;
    dct:contributor "Giray Havur" ;

    # Alternate identifiers
    dct:relation spdxlicense:CC-BY-NC-4.0 ;
    dct:relation lfslib:CC-BY-NC-4.0 ;

    # Citation information
    dct:title
        "Creative Commons Attribution-NonCommercial 4.0 International"@en ;

    dct:alternative
        "Attribution NonCommercial 4.0 International"@en,
        "Attribution-NonCommercial 4.0"@en,
        "CC BY NC 4.0"@en,
        "CC BY NC 4.0 International"@en,
        "CC BY-NC 4.0"@en,
        "CC BY-NC 4.0 International"@en,
        "CC-BY-NC 4.0"@en,
        "CC-BY-NC 4.0 International"@en,
        "Creative Commons BY-NC 4.0"@en,
        "Creative Commons BY-NC 4.0 International"@en ;

    dct:description
        """Permits sharing and adaptation of the licensed material
        for noncommercial purposes, provided that attribution
        requirements are satisfied. Commercial use of the
        licensed material is not authorised by this licence."""@en ;

    skos:note
        """NonCommercial means not primarily intended for or
        directed towards commercial advantage or monetary
        compensation. The assessment depends on the purpose
        and circumstances of the particular use."""@en ;

    dct:publisher "Creative Commons" ;
    dct:created "2026-07-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-11-04T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Attribution", "NonCommercial", "Open Licensing" ;
    dct:source <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dct:version "4.0" ;

    # Access, coverage and status
    openrel:accessType openrel:open-access ;
    openrel:jurisdiction openrel:worldwide ;
    openrel:validityType openrel:perpetual ;
    openrel:policyStatus openrel:typeGlobalActive ;

    # Disclaimers
    openrel:liabilityLimitation
        """To the extent possible, in no event will the Licensor be
        liable to You on any legal theory (including, without
        limitation, negligence) or otherwise for any direct,
        special, indirect, incidental, consequential, punitive,
        exemplary, or other losses, costs, expenses, or damages
        arising out of this Public License or use of the Licensed
        Material, even if the Licensor has been advised of the
        possibility of such losses, costs, expenses, or damages.
        Where a limitation of liability is not allowed in full
        or in part, this limitation may not apply to You."""@en ;

    openrel:warrantyNotice
        """Unless otherwise separately undertaken by the Licensor,
        to the extent possible, the Licensor offers the Licensed
        Material as-is and as-available, and makes no
        representations or warranties of any kind concerning
        the Licensed Material, whether express, implied,
        statutory, or other. This includes, without limitation,
        warranties of title, merchantability, fitness for a
        particular purpose, non-infringement, absence of latent
        or other defects, accuracy, or the presence or absence
        of errors, whether or not known or discoverable. Where
        disclaimers of warranties are not allowed in full or
        in part, this disclaimer may not apply to You."""@en ;

    # Alternative representations
    openrel:legalcode
        <https://creativecommons.org/licenses/by-nc/4.0/legalcode> ;

    openrel:policyTextHtml
        <https://spdx.org/licenses/CC-BY-NC-4.0.html> ;

    openrel:policyText
        <https://lfs.labs.dansdemo.nl/api/v1/licenses/CC-BY-NC-4.0/original> ;

    # Publication reference pending verification.
    # openrel:encodedRules <PUBLISHED_POLICY_RDF_IRI> ;

    # --------------------------------------------------------
    # Prohibitions
    # --------------------------------------------------------

    odrl:prohibition [
        a odrl:Prohibition ;
        odrl:action openrel:commercialise
    ] ;

    # Commercial-purpose restrictions should
    # ideally apply to each licensed use, rather than only
    # to the distinct action openrel:commercialise.

    # --------------------------------------------------------
    # Permissions
    # --------------------------------------------------------

    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:display
    ] ;

    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:distribute ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:attribute
        ] ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:notify ;
            openrel:namedConstraint openrel:notifyInAsset
        ]
    ] ;

    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:modify ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:attribute
        ] ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:notify ;
            openrel:namedConstraint openrel:notifyInAsset
        ]
    ] ;

    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:derive ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:attribute
        ] ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:notify ;
            openrel:namedConstraint openrel:notifyInAsset
        ]
    ] ;

    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:present
    ] ;

    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:reproduce
    ] ;

    # Cost recovery is retained since this is not regarded as commercialisation,
    # but remains subject to the NonCommercial restriction.
    odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:costRecovery ;
        openrel:namedConstraint openrel:allowDistributionFee
    ] .

