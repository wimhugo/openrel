@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<OR-DS-0.5>
    a openrel:AccessRules ;

    dct:title "Data Space Baseline Access Rules"@en ;
    dct:description "Requires the requesting agent to have an eIDAS-verified identity before use of an Asset governed by the Data Space."@en ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2026-11-05T00:00:00Z"^^xsd:dateTime ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Data Space", "Identity Verification" ;
    dct:version "0.5" ;
    openrel:accessType openrel:managed ;
    openrel:policyStatus openrel:typeTemplate ;

    odrl:target openrel:parameterTargetIRI ;

    odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:use ;
        odrl:constraint openrel:eidasVerified
    ] .

