# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Repository Harvesting Limitations
# Example Policy
# Repositories may limit access based on volume and verify the identity of the harvesting entity
# This Access Rule is specific to an Asset Collection and a Repository Aharvesting Endpoint
# OpenREL - Open Rights Encoding language
# Version 0.5 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 3 August 2026
# --------------------------------------------------------------------------------------------------------------------------------

@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<OR-IN-HV-0.5>
    a openrel:ProcessRules ;

    dct:title "Harvesting Access Conditions"@en ;
    dct:description "A repository policy permitting harvesting by verified agents, subject to cumulative data-volume and execution-count limits and mandatory audit logging."@en ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2026-11-05T00:00:00Z"^^xsd:dateTime ;
    dct:subject
        "Repository Harvesting",
        "Usage Limitation",
        "Identity Verification",
        "Audit Logging" ;
    dct:version "0.5" ;

    openrel:accessType openrel:managed ;
    openrel:policyStatus openrel:typeTemplate ;

    # Runtime policy bindings

    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;

    # Harvesting permission

    odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:read ;
        odrl:constraint [
            a odrl:LogicalConstraint ;
            odrl:and (
                openrel:eidasVerified
                openrel:volumeLimit
                openrel:countLimit   
        )] ;

        # Mandatory audit logging
        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:log ;
            odrl:constraint openrel:logUse
        ]
    ] .
