# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Repository Harvesting Limitations
# Example Policy
# Repositories may limit access based on volume and verify the identity of the harvesting entity
# This Access Rule is specific to an Asset Collection and a Repository Aharvesting Endpoint
# OpenREL - Open Rights Encoding language
# Version 0.4 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 3 August 2026
# --------------------------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix dpv: <https://w3id.org/dpv/> .
# Policy Libraries and Registries
@prefix openrellib: <https://github.com/wimhugo/openrel/new/main/data/policy/> .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> 
@prefix lfslib: <https://lfs.labs.dansdemo.nl/api/v1/licenses/> .

# --------------------------------------------------------------------------------------------------------------------------------
# Access Rules Metadata
# --------------------------------------------------------------------------------------------------------------------------------

<19-repo-harvest> a openrel:ProcessRules ;
    # Alternate identifiers
    # skos:exactMatch spdx:<> ;
    # skos:exactMatch lfs:<> ;
    # Citation Information
    dct:title "Harvesting Access Conditions" ;
    dct:publisher <> ;
    dct:created "2026-07-12T00:00:00+00:00" ;
    dct:modified "2026-08-03T00:00:00+00:00" ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Harvesting" ;
    openrel:accessType openrel:managed ;
    dct:source <> ;
    dct:version "0.1" ;
    # Coverage related information
    # These properties apply only for those policies that explicitly require them, optional for others
    # openrel:validityType openrel:perpetual ;
    openrel:jurisdiction openrel:worldwide ;
    odrl:assigner [REPOSITORY_IRI] ;
    # odrl:assignee [ASSIGNEE_IRI] ;
    odrl:target [TARGET_ASSET_COLLECTION_IRI] ; 
    # Disclaimers
    # openrel:liabilityLimitation {{Liability Limitation Text}} ;
    # openrel:warrantyNotice {{Warranty Notice Text}} ;
    # Alternative representations, mappings of SPDX and LFS properties
    # openrel:legalCode [IRI_TO_LEGAL_CODE] ;
    openrel:policyTextHtml [IRI_TO_HTML_VIEW] ;
    openrel:policyText [IRI_TO_TEXT] ;
    openrel:encodedRules openrel:<19-repo-harvest> ;
	  # Optional results of evaluation of two policies
    # openrel:permits [IRI_OF_OTHER_POLICY] ;
	  # openrel:contradicts [IRI_OF_OTHER_POLICY] ;
    # openrel:evaluationDetail [OPENREL_EVALUATION] ;

# --------------------------------------------------------------------------------------------------------------------------------
#   Rules
# --------------------------------------------------------------------------------------------------------------------------------
    
    odrl:permission [
        odrl:action openrel:action.read ;
        odrl:constraint <authorisedEndpoint> ;
        odrl:constraint <accessOpenManaged> ;
        odrl:constraint openrel:constraint.volume:maxVolume ;
        odrl:duty [
            odrl:action openrel:log	;
			odrl:constraint openrel:logUse ;	
    	] ;

