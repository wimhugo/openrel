
# Title: Time-Limited Access
# Example Policy
# Time Limited Access is an Access Rule: imposed by an organisation or platform independently of the licence applicable to the asset
# The motivation may, for example, be to re-evaluate context of the assignee at the completion of the access period
# A combination example is also provided
# This Access Rule is specific to an Assignee and MUST include a date of asset availability and a date on which it ends
# OpenREL - Open Rights Encoding language
# Version 0.4 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 3 August 2026
# --------------------------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix dpv: <https://w3id.org/dpv/> .
# Policy Libraries and Registries
@prefix openrellib: <https://github.com/wimhugo/openrel/new/main/data/policy/> .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> 
@prefix lfslib: <https://lfs.labs.dansdemo.nl/api/v1/licenses/> .

# --------------------------------------------------------------------------------------------------------------------------------
# Access Rules Metadata
# --------------------------------------------------------------------------------------------------------------------------------

<OR-TL-0.4> a openrel:AccessRules ;
    # Alternate identifiers
    skos:exactMatch lfslib:[TO_BE_REGISTERED] ;

    # Citation Information
    dct:title "Time-Limited Access" ;
    dct:publisher openrel:parameterPublisherIRI ;
    dct:created "2026-07-12T00:00:00+00:00" ;
    dct:modified "2026-08-03T00:00:00+00:00" ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Time-Limited Access" ;
    openrel:accessType openrel:managed ;
    dct:version "0.1" ;

    # Coverage related information
    ## These properties apply only for those policies that explicitly require them, optional for others
    ## openrel:validityType openrel:perpetual ;
    openrel:jurisdiction openrel:worldwide ;
    openrel:policyStatus openrel:typePrivateActive ;
    odrl:assigner parameterAssignerIRI ;
    odrl:assignee parameterAssigneeIRI ;
    odrl:target parameterTargetIRI ; 
 
	# Alternative representations, mappings of SPDX and LFS properties
    openrel:policyText "**Time Limited Access** is an **Access Rule** imposed by an organisation or platform independently of the licence applicable to the asset. The motivation may, for example, be to re-evaluate context of the assignee at the completion of the access period"@en ;
    openrel:encodedRules openrellib:OR-TL-0.4 ;

# --------------------------------------------------------------------------------------------------------------------------------
#   Rules
# --------------------------------------------------------------------------------------------------------------------------------
    
    odrl:permission [
        [odrl:action openrel:read ;
        odrl:constraint <SD-ED-limits>
		],
        [odrl:action openrel:download ;
        odrl:constraint <SD-ED-limits>
		]	
        .

# --------------------------------------------------------------------------------------------------------------------------------
#   Custom Logical Constraints
# --------------------------------------------------------------------------------------------------------------------------------
  
<SD-ED-limits>
    a odrl:LogicalConstraint ;
	rdfs:label "Time Interval (parametric)" ;  
    odrl:and (
        <validStartDate>
        <validEndDate>
    ) 
    .
# --------------------------------------------------------------------------------------------------------------------------------
#   Custom Named Constraints
# --------------------------------------------------------------------------------------------------------------------------------
  
<validStartDate>
	 a openrel:NamedConstraint ;
		rdfs:label "Start Date Constraint"@en ;
		skos:definition "Access is only permitted on or after this date."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:tom ;
		openrel:scenario openrel:tech-limits ;
		odrl:leftOperand odrl:dateTime ;
		odrl:operand odrl:gteq ;
		odrl:rightOperand openrel:startDateParameter ;
		.

<validEndDate>
	 a openrel:NamedConstraint ;
		rdfs:label "End Date Constraint"@en ;
		skos:definition "Access is only permitted on or before this date."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:tom ;
		openrel:scenario openrel:tech-limits ;
		odrl:leftOperand odrl:dateTime ;
		odrl:operand odrl:lteq ;
		odrl:rightOperand openrel:endDateParameter ;
		.
