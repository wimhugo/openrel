
# ------------------------------------------------------------------
# Title: Time-Limited Access
# OpenREL Example Access Rules Policy
# Version 0.5 (Draft)
# Revised: 4 November 2026
#
# Developed by Melios Katsamakis and Prodromos Tsiavos
# (OpenAIRE), and Wim Hugo (DANS/EUDAT)
#
# Time-Limited Access is an Access Rule imposed by an
# organisation or platform independently of the licence
# applicable to an asset.
#
# Access is permitted only within a defined time interval.
# The rule is specific to an assignee and an asset.
#
# The start and end dates are supplied through runtime
# Parameters. Both dates MUST be resolved before the
# policy can be evaluated successfully.
# ------------------------------------------------------------------

# Namespaces

@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ------------------------------------------------------------------
# Access Rules Policy
# ------------------------------------------------------------------

<OR-TL-0.4>
    a openrel:AccessRules ;

    # Citation information
    dct:title "Time-Limited Access"@en ;
    dct:description "Access rules permitting an identified assignee to read or download an asset only within a specified time interval. These rules apply independently of the licence governing the asset."@en ;
    dct:publisher openrel:parameterPublisherIRI ;
    dct:created "2026-07-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-11-04T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator "Melios Katsamakis - OpenAIRE",
        <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Time-Limited Access"@en ;
    schema:version "0.5" ;

    # Policy metadata
    openrel:accessType openrel:managed ;
    openrel:jurisdiction openrel:worldwide ;
    openrel:policyStatus openrel:typeTemplate ;

    # Template Parameters for policy parties and asset
    #
    # These references MUST be replaced with resolved
    # party and asset IRIs when the policy is instantiated.

    odrl:assigner openrel:parameterAssignerIRI ;
    odrl:assignee openrel:parameterAssigneeIRI ;
    odrl:target openrel:parameterTargetIRI ;

    # Human-readable policy text

    openrel:policyText
        """Time-Limited Access is an Access Rule imposed
        by an organisation or platform independently of
        the licence applicable to the asset.

        Reading and downloading are permitted only
        between the specified start and end dates.

        Access expires at the end of the defined period.
        The organisation or platform may subsequently
        re-evaluate the assignee's eligibility."""@en ;

    # Optional published representation
    # openrel:encodedRules <PUBLISHED_POLICY_RDF_IRI> ;

    # --------------------------------------------------------------
    # Permissions
    # --------------------------------------------------------------

    odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:read ;
        odrl:constraint <SD-ED-limits>
    ],
    [
        a odrl:Permission ;
        odrl:action openrel:download ;
        odrl:constraint <SD-ED-limits>
    ] .

# ------------------------------------------------------------------
# Logical Constraint
# ------------------------------------------------------------------

<SD-ED-limits>
    a odrl:LogicalConstraint ;
    rdfs:label "Time Interval (parametric)"@en ;
    skos:definition "A logical constraint requiring the current date and time to fall within the specified start and end dates, inclusive."@en ;
    odrl:and (
        openrel:validStartDate
        openrel:validEndDate
    ) .


# ------------------------------------------------------------------
# Runtime Evaluation Notes
# ------------------------------------------------------------------
#
# 1. The policy MUST be instantiated with an identified
#    assigner, assignee and target asset.
# 2. The evaluator MUST resolve:
#       openrel:startDateParameter
#       openrel:endDateParameter
#    Both values MUST be valid xsd:dateTime values.
# 3. The resolved end date MUST NOT precede the start date.
# 4. The evaluator MUST compare the current evaluation
#    date/time with both resolved values.
# 5. Both Named Constraints MUST be satisfied for either
#    permission to apply.
# 6. Unresolved or invalid Parameters MUST NOT result
#    in a successful permission decision.
# 7. The permissions apply only to the identified assignee
#    and target asset.
# 8. The policy does not replace or override the licence
#    governing the asset. Both can subsequently be combined
#    in an openrel:PolicyCollection.
#
# ------------------------------------------------------------------
