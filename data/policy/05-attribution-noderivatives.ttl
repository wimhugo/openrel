@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix lfslib: <https://lfs.labs.dansdemo.nl/api/v1/licenses/> .

# ------------------------------------------------------------
# Licence metadata
# ------------------------------------------------------------

<CC-BY-ND-4.0>
    a openrel:Licence ;

    # Provenance
    prov:wasDerivedFrom dalicclib:CC-BY-ND-4.0 ;
    dct:contributor "Giray Havur" ;

    # Alternate identifiers
    dct:relation spdxlicense:CC-BY-ND-4.0 ;
    dct:relation lfslib:CC-BY-ND-4.0 ;

    # Citation information
    dct:title
        "Creative Commons Attribution-NoDerivatives 4.0 International"@en ;

    dct:alternative
        "Attribution NoDerivatives 4.0 International"@en,
        "Attribution-NoDerivatives 4.0"@en,
        "CC BY ND 4.0"@en,
        "CC BY ND 4.0 International"@en,
        "CC BY-ND 4.0"@en,
        "CC BY-ND 4.0 International"@en,
        "CC-BY-ND 4.0"@en,
        "CC-BY-ND 4.0 International"@en,
        "Creative Commons BY-ND 4.0"@en,
        "Creative Commons BY-ND 4.0 International"@en ;

    dct:description
        """Permits sharing of the licensed material, including
        commercially, subject to attribution. Adaptations
        may be created privately, but sharing adapted
        material is not authorised by this licence."""@en ;

    dct:publisher "Creative Commons" ;
    dct:created "2026-07-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-11-04T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator "Melios Katsamakis - OpenAIRE" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Attribution", "NoDerivatives", "Open Licensing" ;
    dct:source <https://creativecommons.org/licenses/by-nd/4.0/> ;
    schema:version "4.0" ;

    # Access, coverage and status
    openrel:accessType openrel:open-access ;
    openrel:jurisdiction openrel:worldwide ;
    openrel:validityType openrel:perpetual ;
    openrel:policyStatus openrel:typeGlobalActive ;

    # Disclaimers
    openrel:liabilityLimitation
        """To the extent possible, in no event will the Licensor
        be liable to You on any legal theory (including, without
        limitation, negligence) or otherwise for any direct,
        special, indirect, incidental, consequential, punitive,
        exemplary, or other losses, costs, expenses, or damages
        arising out of this Public License or use of the Licensed
        Material, even if the Licensor has been advised of the
        possibility of such losses, costs, expenses, or damages.
        Where a limitation of liability is not allowed in full
        or in part, this limitation may not apply to You."""@en ;

    openrel:warrantyNotice
        """Unless otherwise separately undertaken by the Licensor,
        to the extent possible, the Licensor offers the Licensed
        Material as-is and as-available, and makes no
        representations or warranties of any kind concerning
        the Licensed Material, whether express, implied,
        statutory, or other. This includes, without limitation,
        warranties of title, merchantability, fitness for a
        particular purpose, non-infringement, absence of latent
        or other defects, accuracy, or the presence or absence
        of errors, whether or not known or discoverable. Where
        disclaimers of warranties are not allowed in full or
        in part, this disclaimer may not apply to You."""@en ;

    # Alternative representations
    openrel:legalcode
        <https://creativecommons.org/licenses/by-nd/4.0/legalcode> ;

    openrel:policyTextHtml
        <https://spdx.org/licenses/CC-BY-ND-4.0.html> ;

    openrel:policyText
        <https://lfs.labs.dansdemo.nl/api/v1/licenses/CC-BY-ND-4.0/original> ;

    # REVIEW: Replace with the persistent IRI of the
    # published OpenREL policy representation.
    # openrel:encodedRules <PUBLISHED_POLICY_RDF_IRI> ;

    # --------------------------------------------------------
    # Permissions
    # --------------------------------------------------------

    # Display the licensed material.
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:display
    ] ;

    # Distribution is permitted only for material that
    # does not constitute an adaptation.
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:distribute ;

        openrel:namedConstraint
            openrel:distributeUnmodified ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:attribute
        ]
    ] ;

    # Presentation only allowed for non-modified material
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:present

        openrel:namedConstraint
            openrel:distributeUnmodified ;

        odrl:duty [
            a openrel:PostDuty ;
            odrl:action openrel:attribute
        ]        
    ] ;

    # Private modification is permitted.
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:modify
    ] ;

    # Private creation of adaptations is permitted.
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:derive
    ] ;

    # Reproduction of the licensed material.
    odrl:permission [
        a odrl:Permission ;
        odrl:action odrl:reproduce
    ] ;

    # Recovery of reasonable distribution costs.
    odrl:permission [
        a odrl:Permission ;
        odrl:action openrel:costRecovery ;
        openrel:namedConstraint
            openrel:allowDistributionFee
    ] .

# ------------------------------------------------------------
# Parameter and contextual assertion review
# ------------------------------------------------------------
#
# The NoDerivatives condition is represented by:
#
#   openrel:distributeUnmodified
#
# This Named Constraint evaluates openrel:adaptationStatus = false
#
# Simple evluation may require the checksum of the original asset and the derived asset to be the same
# Evaluation requirements:
#
# - false: distribution may be authorised.
# - true: distribution is not authorised by this licence.
# - unknown: distribution cannot be confirmed as permitted.
#
# REVIEW: The relationship between contextual assertions,
# registered OpenREL parameters and runtime operand
# resolution must be standardised during the later
# parameter-comparison work.
