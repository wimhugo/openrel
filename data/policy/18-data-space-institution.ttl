# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Data Space Requirements, Institutional Access Ru;es, Plus an Otherwise Open Licence
# Example Policy 
# Data Space Policy is a Process Rule: imposed by a Data Space independently of the licence applicable to the asset
# Institutional Access Polict is an Access Rule: imposed by the repository independently of the licence applicable to the asset
# A combination example is provided (this file)
# OpenREL - Open Rights Encoding language
# Version 0.4 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 3 August 2026
# --------------------------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dpv: <https://w3id.org/dpv> .
@prefix lfs: <https://lfs.labs.dansdemo.nl/api/v1/licenses> .

# --------------------------------------------------------------------------------------------------------------------------------
# PolicyCollection Metadata
# --------------------------------------------------------------------------------------------------------------------------------

<18-data-space-institution> a openrel:PolicyCollection ;
    # Alternate identifiers
    # skos:exactMatch spdx:<> ;
    # skos:exactMatch lfs:<> ;
    # Citation Information
    dct:title "Data Space Requirements, Institutional Access Ru;es, Plus an Otherwise Open Licence" ;
    # dct:publisher <> ;
    dct:created "2026-07-12T00:00:00+00:00" ;
    dct:modified "2026-08-03T00:00:00+00:00" ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject "Data Space", "CC BY 4.0", "Research Only" ;
    openrel:accessType openrel:managed ;
    dct:source <> ;
    dct:version "0.1" ;
    # Coverage related information
    # These properties apply only for those policies that explicitly require them, optional for others
    # openrel:validityType openrel:perpetual ;
    # openrel:jurisdiction openrel:worldwide ;
    odrl:assigner [INSTITUTION_IRI] ;
    # odrl:assignee [ASSIGNEE_IRI] ;
    # odrl:target [TARGET_IRI] ; 
    # Disclaimers
    # openrel:liabilityLimitation {{Liability Limitation Text}} ;
    # openrel:warrantyNotice {{Warranty Notice Text}} ;
    # Alternative representations, mappings of SPDX and LFS properties
    # openrel:legalCode [IRI_TO_LEGAL_CODE] ;
    # openrel:policyTextHtml [IRI_TO_HTML_VIEW] ;
    # openrel:policyText [IRI_TO_TEXT] ;
    openrel:encodedRules openrel:18-data-space-institution ;
    # Definition of input policies
    openrel:hasPolicy <18-1-data-space> ;
    openrel:hasPolicy <18-2-research-user> ;
    openrel:hasPolicy <CC-BY-4.0> ;    
	  # Optional results of evaluation of two or more policies
    # openrel:evaluationDetail [OPENREL_EVALUATION] ;

# --------------------------------------------------------------------------------------------------------------------------------
# Policy-Level Comparisons
# --------------------------------------------------------------------------------------------------------------------------------

<CC-BY-4.0>
    a openrel:Licence, odrl:Policy ;
    openrel:permits <18-1-data-space>, <18-2-research-user> ;
    openrel:hasEvaluation [
        a openrel:EvaluationDetail ;
        openrel:assertedBy <https://orcid.org/0000-0002-0255-5101> ;
        openrel:created "2026-08-04"^^xsd:date
    ] .
