# Context and Input Licences
# --------------------------------------------------------------------------------------------------------------------------------
# Title: Data Space Requirements, Institutional Access Rules, Plus an Otherwise Open Licence
# Example Policy 
# Data Space Policy is a Process Rule: imposed by a Data Space independently of the licence applicable to the asset
# Institutional Access Polict is an Access Rule: imposed by the repository independently of the licence applicable to the asset
# A combination example is provided (this file)
# OpenREL - Open Rights Encoding language
# Version 0.5 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 5 November 2026
# The repository may legitimately require identity verification and researcher status before granting access to its hosted copy. 
# However, CC BY 4.0 generally permits redistribution of the licensed material to other recipients, including people who 
# are not researchers or eIDAS-verified. The example does not infer that there is no conflict present.
# --------------------------------------------------------------------------------------------------------------------------------

@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<OR-IN-DS-CC-BY-0.5>
    a openrel:PolicyCollection ;

    dct:title "Data Space and Researcher Access with CC BY 4.0"@en ;
    dct:description "A collection combining a Data Space identity-verification requirement, a repository researcher-status requirement, and the Creative Commons Attribution 4.0 International licence. Inclusion of these policies does not assert their compatibility or establish an aggregate authorisation outcome."@en ;
    dct:created "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2026-11-05T00:00:00Z"^^xsd:dateTime ;
    dct:contributor <https://orcid.org/0000-0002-0255-5101> ;
    dct:subject
        "Data Space",
        "Researcher Access",
        "CC BY 4.0" ;
    dct:version "0.5" ;

    openrel:accessType openrel:managed ;
    openrel:policyStatus openrel:typeTemplate ;

    # Constituent policies

    openrel:hasPolicy
        <OR-DS-0.5>,
        <OR-IN-RO-0.5>,
        <CC-BY-4.0> .

# No openrel:hasEvaluation assertions.
# No openrel:policyEvaluationOutcome assertion.
