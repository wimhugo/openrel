    {
      "id": "openrel:example-policy-A",
      "label": "Example A — Non-Commercial Reuse with Attribution (Simple)",
      "description": "A researcher is permitted to reuse a published dataset for academic purposes, provided they give attribution to the original creators. Commercial use is explicitly prohibited. The policy is modelled on CC BY-NC semantics expressed in ODRL, covering the pattern from Sections 1, 4, 7, and 10 of the draft.",
      "odrl_type": "odrl:Set",
      "status": "openrel:status/pending",
      "uid": "https://openrel.eu/policies/examples/A",
      "dcterms:issued": "2025-10-01",
      "dcterms:modified": "2025-10-01",
      "assigner": {
        "uid": "https://ror.org/04wxnsj81",
        "type": "openrel:agent:DataProvider",
        "label": "Example Research Institute (assigner)"
      },
      "assignee": {
        "uid": "https://orcid.org/0000-0001-2345-6789",
        "type": "openrel:agent:Researcher",
        "label": "Researcher Jane Doe (assignee)"
      },
      "target": {
        "uid": "https://doi.org/10.1234/example-dataset-001",
        "label": "Climate Research Dataset v2"
      },
      "permissions": [
        {
          "action": "openrel:use",
          "refinement": {
            "leftOperand": "dpv:hasPurpose",
            "operator": "odrl:isA",
            "rightOperand": "dpv:AcademicResearch",
            "rightOperand_type": "xsd:anyURI"
          },
          "duty": {
            "action": "openrel:attribute",
            "description": "The assignee must credit the original creator in any publication, output, or derivative that uses this dataset. Attribution must include the dataset DOI and the name of the originating institution."
          }
        },
        {
          "action": "openrel:distribute",
          "constraint": {
            "leftOperand": "dpv:hasPurpose",
            "operator": "odrl:neq",
            "rightOperand": "dpv:CommercialResearch",
            "rightOperand_type": "xsd:anyURI"
          },
          "duty": {
            "action": "openrel:attribute"
          }
        },
        {
          "action": "openrel:modify",
          "constraint": {
            "leftOperand": "dpv:hasPurpose",
            "operator": "odrl:isA",
            "rightOperand": "dpv:AcademicResearch",
            "rightOperand_type": "xsd:anyURI"
          },
          "duty": {
            "action": "openrel:attribute"
          }
        }
      ],
      "prohibitions": [
        {
          "action": "openrel:use",
          "constraint": {
            "leftOperand": "dpv:hasPurpose",
            "operator": "odrl:eq",
            "rightOperand": "dpv:CommercialResearch",
            "rightOperand_type": "xsd:anyURI"
          },
          "description": "Commercial use of any kind is explicitly prohibited."
        },
        {
          "action": "openrel:distribute",
          "constraint": {
            "id": "openrel:constraint:attribution:required",
            "leftOperand": "openrel:attributionRequired",
            "operator": "odrl:eq",
            "rightOperand": false,
            "rightOperand_type": "xsd:boolean"
          },
          "description": "Redistribution without attribution is prohibited."
        }
      ],
      "duties": [],
      "sources_used": [
        "openrel:source:CreativeCommons",
        "openrel:source:FAIR",
        "openrel:source:DPV",
        "openrel:source:ODRL"
      ],
      "original_draft_coverage": ["Section 1", "Section 4", "Section 7", "Section 10", "Section 51"],
      "cc_rel_equivalent": "CC BY-NC 4.0",
      "machine_actionable": true,
      "evaluation": "allow | deny",
      "modelling_notes": [
        "The draft modelled 'share' and 'reuse' as separate top-level actions. Normalized to openrel:use, openrel:distribute, and openrel:modify — ODRL's canonical action hierarchy.",
        "The draft's 'constraint: {name: purpose, operator: eq, rightOperand: nonCommercial}' used an informal string. Replaced with dpv:hasPurpose neq dpv:CommercialResearch for typed, resolvable semantics.",
        "Attribution is modelled as a duty on each permission, not as a constraint. In ODRL, attribution is an obligation accompanying a permission, not a condition blocking it.",
        "The prohibition uses openrel:attributionRequired=false to capture the 'may not redistribute without attribution' rule as a typed boolean constraint."
      ]
    },
