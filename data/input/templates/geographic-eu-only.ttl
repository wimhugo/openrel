@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .


<p008> a openrel:Access ;
    dct:title "Geographic Restriction — EU Only" ;
    dct:description """This resource is accessible only from within the European Union. Requests originating outside EU member states receive a DENY response. Additional country exclusions can be added."""@en ;
    dct:subject "Geographic", "EU Only", "Spatial", "GeoNames" ;
    openrel:topic "restricted" ;
    openrel:templateSlug "geographic-eu-only" ;
    odrl:permission
        [ odrl:action odrl:read
          ; odrl:constraint         [ a odrl:Constraint ; odrl:leftOperand odrl:spatial ; odrl:operator odrl:eq ; odrl:rightOperand <https://sws.geonames.org/6255148/> ]
        ] ;
    .