# --------------------------------------------------------------------------------------------------------------------------------
# Policy Wizard Template (mock-up source) — for offline comparison with data/policy/
# OpenREL - Open Rights Encoding Language
# Version 0.4 (Draft)
# --------------------------------------------------------------------------------------------------------------------------------

@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .


<p015> a openrel:Policy ;
    dct:title "EOSC Open Research Data Policy" ;
    dct:description """This composite policy governs research data deposited in EOSC repositories. It combines open access rights with accountability obligations: access must be logged to a clearing house and the data provider must be notified."""@en ;
    dct:subject "EOSC", "Composite", "Open Access", "Accountability" ;
    openrel:topic "open-access" ;
    openrel:templateSlug "eosc-open-research-data" ;
    odrl:permission
        [ odrl:action odrl:read
          ; odrl:constraint [ a odrl:LogicalConstraint ; odrl:and ( [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.openAccess:required ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.attribution:required ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.openAccess:fundingPublic ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.accountability:notifyEndpoint ; odrl:operator odrl:eq ; odrl:rightOperand "<param: openrel:constraint.accountability:notifyEndpoint>" ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.accountability:loggingCH ; odrl:operator odrl:eq ; odrl:rightOperand "<param: openrel:constraint.accountability:loggingCH>" ] ) ]
          ; odrl:postDuty [ odrl:action odrl:attribute ; odrl:action openrel:log ; odrl:action openrel:notify ]
        ] ,
        [ odrl:action odrl:distribute
          ; odrl:constraint [ a odrl:LogicalConstraint ; odrl:and ( [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.openAccess:required ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.attribution:required ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.openAccess:fundingPublic ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.accountability:notifyEndpoint ; odrl:operator odrl:eq ; odrl:rightOperand "<param: openrel:constraint.accountability:notifyEndpoint>" ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.accountability:loggingCH ; odrl:operator odrl:eq ; odrl:rightOperand "<param: openrel:constraint.accountability:loggingCH>" ] ) ]
          ; odrl:postDuty [ odrl:action odrl:attribute ; odrl:action openrel:log ; odrl:action openrel:notify ]
        ] ,
        [ odrl:action odrl:reproduce
          ; odrl:constraint [ a odrl:LogicalConstraint ; odrl:and ( [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.openAccess:required ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.attribution:required ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.openAccess:fundingPublic ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.accountability:notifyEndpoint ; odrl:operator odrl:eq ; odrl:rightOperand "<param: openrel:constraint.accountability:notifyEndpoint>" ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.accountability:loggingCH ; odrl:operator odrl:eq ; odrl:rightOperand "<param: openrel:constraint.accountability:loggingCH>" ] ) ]
          ; odrl:postDuty [ odrl:action odrl:attribute ; odrl:action openrel:log ; odrl:action openrel:notify ]
        ] ;
    .