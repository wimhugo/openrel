# --------------------------------------------------------------------------------------------------------------------------------
# Policy Wizard Template (mock-up source) — for offline comparison with data/policy/
# OpenREL - Open Rights Encoding Language
# Version 0.4 (Draft)
# --------------------------------------------------------------------------------------------------------------------------------

@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .


<p016> a openrel:Policy ;
    dct:title "Sensitive Data — Full Governance" ;
    dct:description """This policy governs access to sensitive research data including personal or health-related information. It combines managed access, GDPR-aligned constraints, and full accountability. Access evaluation results in PERMIT, CONDITIONAL, or DENY based on all conditions being met."""@en ;
    dct:subject "Sensitive Data", "GDPR", "Ethics", "Full Governance" ;
    openrel:topic "restricted", "personal-data" ;
    openrel:templateSlug "sensitive-data-full-governance" ;
    odrl:permission
        [ odrl:action odrl:read
          ; odrl:constraint [ a odrl:LogicalConstraint ; odrl:and ( [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.legalBasis:consent ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.ethicsApproval:required ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.security:trustPlus ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.tom:required ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.dataMinimization ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.revocation:active ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.accountability:loggingCH ; odrl:operator odrl:eq ; odrl:rightOperand "<param: openrel:constraint.accountability:loggingCH>" ] ) ]
          ; odrl:preDuty [ odrl:action openrel:obtainConsent ; odrl:action openrel:anonymize ]
          ; odrl:postDuty [ odrl:action openrel:log ]
        ] ;
    odrl:prohibition
        [ odrl:action odrl:distribute ] ,
        [ odrl:action odrl:modify ] ;
    .