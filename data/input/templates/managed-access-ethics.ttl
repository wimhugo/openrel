# --------------------------------------------------------------------------------------------------------------------------------
# Policy Wizard Template (mock-up source) — for offline comparison with data/policy/
# OpenREL - Open Rights Encoding Language
# Version 0.4 (Draft)
# --------------------------------------------------------------------------------------------------------------------------------

@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .


<p010> a openrel:Access ;
    dct:title "Managed Access — Ethics Approval Required" ;
    dct:description """Access is conditional on the applicant providing documented approval from a recognised ethics committee or IRB. The access request triggers a CONDITIONAL outcome. Access is granted only after approval is verified."""@en ;
    dct:subject "Managed Access", "Ethics", "Sensitive Data", "CONDITIONAL" ;
    openrel:topic "restricted", "personal-data" ;
    openrel:templateSlug "managed-access-ethics" ;
    odrl:permission
        [ odrl:action odrl:read
          ; odrl:constraint [ a odrl:LogicalConstraint ; odrl:and ( [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.ethicsApproval:required ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.attribution:required ; odrl:operator odrl:eq ; odrl:rightOperand true ] ) ]
          ; odrl:preDuty [ odrl:action openrel:obtainConsent ]
          ; odrl:postDuty [ odrl:action odrl:attribute ]
        ] ;
    .