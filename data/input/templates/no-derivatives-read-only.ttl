# --------------------------------------------------------------------------------------------------------------------------------
# Policy Wizard Template (mock-up source) — for offline comparison with data/policy/
# OpenREL - Open Rights Encoding Language
# Version 0.4 (Draft)
# --------------------------------------------------------------------------------------------------------------------------------

@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .


<p005> a openrel:Licence ;
    dct:title "No Derivatives — Read Only" ;
    dct:description """This resource is available for reading and downloading. Redistribution is permitted with attribution. Modification, adaptation, translation, and derivative works are prohibited."""@en ;
    dct:subject "Read Only", "No Derivatives", "CC BY-ND" ;
    openrel:topic "restricted" ;
    openrel:templateSlug "no-derivatives-read-only" ;
    odrl:permission
        [ odrl:action odrl:read
          ; odrl:constraint         [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.attribution:required ; odrl:operator odrl:eq ; odrl:rightOperand true ]
          ; odrl:postDuty [ odrl:action odrl:attribute ]
        ] ,
        [ odrl:action odrl:distribute
          ; odrl:constraint         [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.attribution:required ; odrl:operator odrl:eq ; odrl:rightOperand true ]
          ; odrl:postDuty [ odrl:action odrl:attribute ]
        ] ,
        [ odrl:action odrl:reproduce
          ; odrl:constraint         [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.attribution:required ; odrl:operator odrl:eq ; odrl:rightOperand true ]
          ; odrl:postDuty [ odrl:action odrl:attribute ]
        ] ;
    odrl:prohibition
        [ odrl:action odrl:modify ] ;
    .