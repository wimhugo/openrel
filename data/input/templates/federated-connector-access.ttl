# --------------------------------------------------------------------------------------------------------------------------------
# Policy Wizard Template (mock-up source) — for offline comparison with data/policy/
# OpenREL - Open Rights Encoding Language
# Version 0.4 (Draft)
# --------------------------------------------------------------------------------------------------------------------------------

@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .


<p017> a openrel:Access ;
    dct:title "Federated Access — Authorised Connector" ;
    dct:description """This resource is accessible exclusively through a specific data connector identified by URI. The connector must be authorised, hold a valid IDS security certification, and not be listed as revoked."""@en ;
    dct:subject "Federated", "Connector", "IDS", "EOSC", "Authorised" ;
    openrel:topic "restricted" ;
    openrel:templateSlug "federated-connector-access" ;
    odrl:permission
        [ odrl:action odrl:use
          ; odrl:constraint [ a odrl:LogicalConstraint ; odrl:and ( [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.security:trust ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.revocation:active ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.connector:authorisedURI ; odrl:operator odrl:eq ; odrl:rightOperand "<param: openrel:constraint.connector:authorisedURI>" ] ) ]
          ; odrl:postDuty [ odrl:action openrel:log ]
        ] ,
        [ odrl:action odrl:read
          ; odrl:constraint [ a odrl:LogicalConstraint ; odrl:and ( [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.security:trust ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.revocation:active ; odrl:operator odrl:eq ; odrl:rightOperand true ] [ a odrl:Constraint ; odrl:leftOperand openrel:constraint.connector:authorisedURI ; odrl:operator odrl:eq ; odrl:rightOperand "<param: openrel:constraint.connector:authorisedURI>" ] ) ]
          ; odrl:postDuty [ odrl:action openrel:log ]
        ] ;
    odrl:prohibition
        [ odrl:action odrl:distribute ] ,
        [ odrl:action odrl:modify ] ;
    .