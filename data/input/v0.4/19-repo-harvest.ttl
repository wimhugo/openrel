@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix openrel: <https://openrel.org/ns#> .

openrel:policy.p019
    rdf:type openrel:Access ;
    dc:title "Repository Harvesting Policy" ;
    odrl:assigner [REPOSITORY_URI] ;
    odrl:assignee openrel:agent.harvester ;
    odrl:target [REPOSITORY_COLLECTION_URI] ;
    odrl:permission [
        odrl:action openrel:action.read ;
        odrl:constraint openrel:constraint.connector:authorisedURI ;
        odrl:constraint openrel:constraint.harvestingScope ;
        odrl:constraint openrel:constraint.volume:maxVolume ;
        odrl:duty [
            odrl:action openrel:action.log ;
            dc:description "Each harvesting session must be logged with timestamp, connector ID, and record count."
        ]
    ] ;
    odrl:prohibition [
        odrl:action openrel:action.read ;
        dc:description "Full-content harvesting prohibited for non-open-access resources." ;
        odrl:constraint openrel:constraint.harvestingScope
    ] ;
    odrl:prohibition [
        odrl:action openrel:action.read ;
        dc:description "Unidentified bots denied entirely." ;
        odrl:constraint [
            odrl:leftOperand openrel:leftOperand.connectorURI ;
            odrl:operator odrl:isPartOf ;
            odrl:rightOperand openrel:connectorList.unknown
        ]
    ] ;
    openrel:evaluation "permit | deny" ;
    openrel:machineActionable "true" .
