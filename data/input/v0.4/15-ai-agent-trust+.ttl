@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix openrel: <https://openrel.org/ns#> .

openrel:policy.p015
    rdf:type openrel:Process ;
    dc:title "AI Agent Access with TRUST+ Security and TOM Requirement" ;
    odrl:assigner [ASSIGNER_URI] ;
    odrl:assignee openrel:agent.aiAgent ;
    odrl:target [TARGET_URI] ;
    odrl:permission [
        odrl:action openrel:action.use ;
        odrl:constraint openrel:constraint.security:trustPlus ;
        odrl:constraint openrel:constraint.tom:required ;
        odrl:duty [
            odrl:action openrel:action.log ;
            odrl:constraint openrel:constraint.log:clearinghouse
        ]
    ] ;
    odrl:prohibition [
        odrl:action openrel:action.use ;
        odrl:constraint [
            odrl:leftOperand openrel:leftOperand.securityProfile ;
            odrl:operator odrl:neq ;
            odrl:rightOperand openrel:security.trustPlus
        ]
    ] ;
    openrel:evaluation "permit | deny" ;
    openrel:machineActionable "true" .
