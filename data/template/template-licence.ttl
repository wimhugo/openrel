# This Version: 30 July 2026

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dpv: <https://w3id.org/dpv> .
@prefix lfs: <> . # Points to an LFS Node API

# --------------------------------------------------------------------------------------------------------------------------------
# Policy and Licence Metadata
# --------------------------------------------------------------------------------------------------------------------------------

<> a odrl:Set ;
    # Alternate identifiers
    skos:exactMatch spdx:<> ;
    skos:exactMatch lfs:<> ;
    skos:exactMatch cc:<> ;
    # Coverage related information, mappings of CC and DALICC properties
    openrel:liabilityLimitation {{Liability Limitation Text}} ;
    openrel:warrantyNotice {{Warranty Notice Text}} ;
    openrel:validityType openrel:perpetual ;
    openrel:jurisdiction openrel:worldwide ;
    # Citation Information
    dct:source <> ;
    dct:title {{Policy Or Licence Title}}@en ;
    dct:alternative {{Alternative Titles}} ;
    dct:publisher {{Publisher IRI OR Label}} ;
    dct:created {{DateTime}} ;
    dct:mofified {{DateTime}} ;
    dct:creator {{Creator IRI OR Label}} ;
    dct:contributor {{Contributor IRI OR Label}} ;
    dct:subject {{One OR More Keywords OR Tags}} ;
	dct:licence spdxlicense:CC-BY-4.0 ;
    # Alternative representations, mappings of SPDX and LFS properties
    openrel:legalCode <IRI_TO_LEGAL_CODE> ;
    openrel:policyTextHtml <IRI_TO_HTML_VIEW> ;
    openrel:policyText <IRI_TO_TEXT_VIEW> ;
    openrel:encodeRules <IRI_TO_RULE_ENCODING> ;
    # These properties apply only for those policies that explicitly require them, optional for others
    odrl:assigner [ASSIGNER_IRI] ;
    odrl:assignee [ASSIGNEE_IRI] ;
    odrl:target [TARGET_IRI] ;
	# Optional results of evaluation of two policies
    openrel:permits <IRI_OF_OTHER_POLICY> ;
	openrel:contradicts <IRI_OF_OTHER_POLICY>
    openrel:evaluationDetail {{}} ;

# --------------------------------------------------------------------------------------------------------------------------------
#   Rules (Example)
# --------------------------------------------------------------------------------------------------------------------------------
    
    odrl:permission [
        odrl:action openrel:use ;
        odrl:namedconstraint openrel:euUseOnly ;
    ] ;

    odrl:permission [
        odrl:action openrel:derive ;
        odrl:constraint <example-logical-constraint> ;
    ] ;
    
.

# --------------------------------------
# Custom Logical Constraints
# --------------------------------------

<example-logical-constraint>
    a odrl:LogicalConstraint ;
    odrl:and (
        openrel:verifiedResearcher 
        openrel:eidasVerifiedResearcher
    ) 
.

# --------------------------------------
# Custom Named Constraints (Example)
# --------------------------------------

openrel:euUseOnly 
	[ a openrel:NamedConstraint ;
		rdfs:label "Allow EU-wide Use"@en ;
		skos:definition "Allow the Asset to be used within the current definition of the EU."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:context ;
		openrel:scenario openrel:european-use ;
		odrl:leftOperand openrel:locationLimitation ;
		odrl:operand odrl:eq 
		odrl:rightOperand loc:EU27 ;
	]	
	.
