############################################################################################################
# POLICY CLASSES and PROPERTIES
############################################################################################################

openrel:PolicyScheme
  a skos:ConceptScheme ;
  skos:prefLabel "OpenREL Policies"@en ;
  dct:title "OpenREL Policies"@en ;
  dct:description "OpenREL additionally defines the subclasses of Licence, Access Rules, and Process Rules."@en ;
  dct:created "2026-06-29T00:00:00+00:00"^^xsd:datetime ;  
  dct:modified "2026-07-10T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;  # Wim Hugo
  dct:creator "Melios Katsamakis" ;
  dct:contributor <https://orcid.org/0000-0003-2459-6817> ; # Prodromos Tsiavos
  owl:versionInfo "0.4" .

# -------------------------------------------------------------------------------------------------------------
# Object/ Class Definition
# -------------------------------------------------------------------------------------------------------------

# --------ODRL

odrl:Policy
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:label "Policy"@en ;
	skos:definition "A non-empty group of Permissions and/or Prohibitions."@en ;
    skos:seeAlso <https://www.w3.org/TR/odrl-model/#policy> ;
	skos:note "A Policy may contain multiple Rules."@en .

odrl:Agreement
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:subClassOf odrl:Policy  ;
	owl:disjointWith odrl:Offer, odrl:Privacy, odrl:Request, odrl:Ticket, odrl:Assertion ;
	rdfs:label "Agreement"@en ;
	skos:definition "A Policy that grants the assignee a Rule over an Asset from an assigner."@en ;
	skos:note "An Agreement Policy MUST contain at least one Permission or Prohibition rule, a Party with Assigner function, and a Party with Assignee function (in the same Permission or Prohibition). The Agreement Policy will grant the terms of the Policy from the Assigner to the Assignee."@en ;
  	skos:seeAlso <https://www.w3.org/TR/odrl-model/#policy-agreement> ;
  	.

odrl:Assertion
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:subClassOf odrl:Policy  ;
	owl:disjointWith odrl:Offer, odrl:Privacy, odrl:Request, odrl:Ticket ;
	rdfs:label "Assertion"@en ;
	skos:definition "A Policy that asserts a Rule over an Asset from parties."@en ;
	skos:note "For example, a party (an assignee or assigner) can claim what terms they have over an Asset. An Assertion Policy does not grant such permissions/prohibitions but only asserts the parties claims. An Assetion Policy  MUST contain a target Asset, a Party with any functional role, and at least one of a Permission or Prohibition rule."@en ;
  	skos:scopeNote "Non-Normative"@en ;
	.

odrl:Offer
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:subClassOf odrl:Policy  ;
	owl:disjointWith odrl:Agreement, odrl:Privacy, odrl:Request, odrl:Ticket, odrl:Assertion ;
	rdfs:label "Offer"@en ;
	skos:definition "A Policy that proposes a Rule over an Asset from an assigner."@en ;
	skos:note "An Offer Policy MUST contain at least one Permission or Prohibition rule and a Party with Assigner function (in the same Permission or Prohibition). The Offer Policy MAY contain a Party with Assignee function, but MUST not grant any privileges to that Party."@en ;
    skos:seeAlso <https://www.w3.org/TR/odrl-model/#policy-offer> ;
  	.

odrl:Privacy
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:subClassOf odrl:Policy  ;
	owl:disjointWith odrl:Agreement, odrl:Offer, odrl:Request, odrl:Ticket, odrl:Assertion ;
	rdfs:label "Privacy Policy"@en ;
	skos:definition "A Policy that expresses a Rule over an Asset containing personal information."@en ;
	skos:note "A Privacy Policy  MUST contain a target Asset, a Party with Assigner  is, a Party with Assignee function, and at least one of a Permission or Prohibition rule that MUST include a Duty. The target Asset SHOULD contain or relate to personal information about the Assignee. The Duty MUST describe obligations on the Assigner about managing the Asset. The Assignee is being granted the terms of the Privacy policy from the Assigner."@en ;
  	skos:scopeNote "Non-Normative"@en ;
  	.

odrl:Request
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:subClassOf odrl:Policy ;
	owl:disjointWith odrl:Agreement, odrl:Offer, odrl:Privacy, odrl:Ticket, odrl:Assertion ;
	rdfs:label "Request"@en ;
	skos:definition "A Policy that proposes a Rule over an Asset from an assignee."@en ;
	skos:note "A Request Policy  MUST contain a target Asset, a Party with Assignee function, and at least one of a Permission or Prohibition rule. The Request MAY also contain the Party with Assigner function if this is known. No privileges are granted to any Party."@en ;
  	skos:scopeNote "Non-Normative"@en ;
   .

odrl:Set
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:subClassOf odrl:Policy  ;
	owl:disjointWith odrl:Agreement, odrl:Offer, odrl:Privacy, odrl:Request, odrl:Ticket, odrl:Assertion ;
	rdfs:label "Set"@en ;
	skos:definition "A Policy that expresses a Rule over an Asset."@en ;
	skos:note "A Set Policy MUST contain a target Asset, and at least one Rule. A Set Policy is the default Policy subclass. The Set is aimed at scenarios where there is an open criteria for the semantics of the policy expressions and typically refined by other systems/profiles that process the information at a later time. No privileges are granted to any Party (if defined)."@en ;
  	skos:seeAlso <https://www.w3.org/TR/odrl-model/#policy-set> ;
    .

odrl:Ticket
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:subClassOf odrl:Policy  ;
	owl:disjointWith odrl:Agreement, odrl:Offer, odrl:Privacy, odrl:Request, odrl:Assertion ;
	rdfs:label "Ticket"@en ;
	skos:definition "A Policy that grants the holder a Rule over an Asset from an assigner."@en ;
	skos:note "A Ticket Policy MUST contain a target Asset and at least one of a Permission or Prohibition rule.  The Ticket MAY contain the Party with Assigner function and MUST NOT contain an Assignee. The Ticket Policy will grant the terms of the Policy to the holder of that Ticket. The holder of the Ticket MAY remain unknown or MAY have to be identified at some later stage."@en ;
  	skos:scopeNote "Non-Normative"@en ;
    .

# --------OpenREL

openrel:Licence
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:subClassOf odrl:Policy ;
	owl:disjointWith odrl:Agreement, odrl:Offer, odrl:Privacy, odrl:Request, odrl:Assertion , odrl:Ticket, openrel:AccessRules, openrel:ProcessRules ;
	rdfs:label "Licence"@en ;
	skos:definition "A Policy that is generally imnterpreted as a licence, specifies additional properties of a licence, and has a legal code representation."@en ;
	skos:note "The Licence Policy subclass introduces additional properties that are not typically applicable to other Policy subclasses, and takes its broad scope from the properties associated specifically with licences. It could be viewed as a special case (non-negotiable) of an Offer or an Agreement that will not be modified."@en ;
  	skos:note "Unique to Assets or Asset Collections."@en ;
	skos:note "cc: a set of requests/permissions to users of a Work, e.g. a copyright license, the public domain, information for distributors."@en ;
  	skos:scopeNote "Non-Normative"@en ;
	skos:closeMatch cc:License ;
	.

openrel:AccessRules
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:subClassOf odrl:Policy ;
	owl:disjointWith odrl:Agreement, odrl:Offer, odrl:Privacy, odrl:Request, odrl:Assertion , odrl:Ticket, openrel:ProcessRules ;
	rdfs:label "Access Rule(s)"@en ;
	skos:definition "A Policy that defines conditions of access that are not generally considered to be part of a licence, but depends on the context."@en ;
	skos:note "Such access rules may include, for example, the terms and conditions of use associated with a specific repository, data service, or institution. It is usually institutional policy driven."@en ;
 	skos:note "Unique to an Institution, Repository, or Catalogue."@en ;
  	skos:scopeNote "Non-Normative"@en ;
    .

openrel:ProcessRules
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:subClassOf odrl:Policy ;
	owl:disjointWith odrl:Agreement, odrl:Offer, odrl:Privacy, odrl:Request, odrl:Assertion , odrl:Ticket, openrel:AccessRules ;
	rdfs:label "Process Rule(s)"@en ;
	skos:definition "A Policy that defines formalities associated with the process of gaining access associated with sofwtare or dissemination channels."@en ;
	skos:note "Such process rules may include, or example, steps related to interaction of a software platform, infrastricture, federation, or dissemination channel with an Assignee."@en ;
 	skos:note "Unique to a software platform or dissemination channel."@en ;
 	skos:scopeNote "Non-Normative"@en ;
	.

openrel:PolicyCollection
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
  	rdfs:subClassOf odrl:Policy ;
	owl:disjointWith odrl:Agreement, odrl:Offer, odrl:Privacy, odrl:Request, odrl:Assertion , odrl:Ticket, openrel:AccessRules, openrel:ProcessRules ;
	rdfs:label "Policy Collection"@en ;
	skos:definition "A collection that includes two or more policies"@en ;
	skos:note "A policy collection references two or more policies via IRI."@en ;
  	skos:note "Similar to odrl:Set, but it inherits Asset and Party references from contributing Policies."@en ;
	skos:note "Can be used to define all policies applicable to an asset collection, or to collectively reference the policies involved in a negotiation process."@en ;
	skos:scopeNote "Non-Normative"@en 
	.

# -------------------------------------------------------------------------------------------------------------
# Property Definition
# -------------------------------------------------------------------------------------------------------------

# ODRL Profile conformance note:
# The ODRL Profile extension rules do not explicitly specify a mechanism
# for arbitrary new policy metadata predicates. This module defines
# supplementary RDF/OWL vocabulary, not an ODRL Core Vocabulary modification.
# Every new property is also a skos:Concept, per the supplied profile rules.
# Domain is the OWL union of the four intended OpenREL policy classes.
# A SHACL shape is needed if domain membership must be validated.

# Attribution
# Reuse prov:wasDerivedFrom (domain prov:Entity, range prov:Entity) and
# prov:wasAttributedTo (domain prov:Entity, range prov:Agent).
# A literal value for prov:wasAttributedTo in the example should be replaced
# by an agent IRI or node with a label.

# Alternate identifiers
# Reuse dct:relation (domain and range unconstrained in DCMI Terms).
# For true identifiers, consider dct:identifier or adms:identifier separately.

# Citation Information
# Reuse dct:title, dct:alternative, dct:description, dct:publisher,
# dct:created, dct:modified, dct:creator, dct:contributor, dct:subject,
# dct:source. DCMI does not prescribe a domain for these properties.
# Typical DCMI ranges: dct:publisher/creator/contributor -> dct:Agent;
# dct:created/modified -> rdfs:Literal; dct:subject -> rdfs:Resource;
# dct:source -> rdfs:Resource; dct:title/alternative/description -> rdfs:Literal.
# dct:version is not a standard DCMI Terms property; consider owl:versionInfo
# (literal) or schema:version instead.

openrel:accessType a owl:ObjectProperty, skos:Concept ;
    rdfs:label "Access type"@en ;
    skos:definition "Access classification applicable to the policy."@en ;
    rdfs:comment "Access classification applicable to the policy."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (
        openrel:Licence openrel:AccessRules
        openrel:ProcessRules openrel:PolicyCollection
    ) ] ;
    rdfs:range skos:Concept ;
    skos:note "Citation Information. Values should come from the OpenREL access-type concept scheme; enforce scheme membership using SHACL."@en .

openrel:policyStatus a owl:ObjectProperty, skos:Concept ;
    rdfs:label "Policy status"@en ;
    skos:definition "Lifecycle or publication status of the policy."@en ;
    rdfs:comment "Lifecycle or publication status of the policy."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (
        openrel:Licence openrel:AccessRules
        openrel:ProcessRules openrel:PolicyCollection
    ) ] ;
    rdfs:range skos:Concept ;
    skos:note "Coverage related information. Use the OpenREL policy-status concept scheme; avoid conflating lifecycle status with access scope."@en .

# Coverage related information

openrel:jurisdiction a owl:ObjectProperty, skos:Concept ;
    rdfs:label "Jurisdiction"@en ;
    skos:definition "Jurisdiction applicable to the policy, typically expressed by a location IRI."@en ;
    rdfs:comment "Jurisdiction applicable to the policy, typically expressed by a location IRI."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (
        openrel:Licence openrel:AccessRules
        openrel:ProcessRules openrel:PolicyCollection
    ) ] ;
    rdfs:range dct:Location ;
    rdfs:subPropertyOf cc:jurisdiction ;
    skos:note "Coverage related information. A narrower OpenREL use of cc:jurisdiction; verify that the chosen location concept denotes legal jurisdiction rather than geographic access coverage."@en .

openrel:validityType a owl:ObjectProperty, skos:Concept ;
    rdfs:label "Validity type"@en ;
    skos:definition "Classifies the temporal validity of the policy, such as perpetual validity."@en ;
    rdfs:comment "Classifies the temporal validity of the policy, such as perpetual validity."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (
        openrel:Licence openrel:AccessRules
        openrel:ProcessRules openrel:PolicyCollection
    ) ] ;
    rdfs:range skos:Concept ;
    skos:note "Coverage related information. Use a controlled concept scheme; this does not by itself encode start or end dates."@en .

# Disclaimers

openrel:liabilityLimitation a owl:DatatypeProperty, skos:Concept ;
    rdfs:label "Liability limitation"@en ;
    skos:definition "Text of a limitation-of-liability notice associated with the policy."@en ;
    rdfs:comment "Text of a limitation-of-liability notice associated with the policy."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (
        openrel:Licence openrel:AccessRules
        openrel:ProcessRules openrel:PolicyCollection
    ) ] ;
    rdfs:range rdf:langString ;
    skos:note "Disclaimers. Plain literals in the example should preferably carry a language tag; the full legal text remains authoritative."@en .

openrel:warrantyNotice a owl:DatatypeProperty, skos:Concept ;
    rdfs:label "Warranty notice"@en ;
    skos:definition "Text of a warranty disclaimer associated with the policy."@en ;
    rdfs:comment "Text of a warranty disclaimer associated with the policy."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (
        openrel:Licence openrel:AccessRules
        openrel:ProcessRules openrel:PolicyCollection
    ) ] ;
    rdfs:range rdf:langString ;
    skos:note "Disclaimers. Plain literals in the example should preferably carry a language tag."@en .

# Alternative representations, mappings of SPDX and LFS properties

openrel:legalcode a owl:ObjectProperty, skos:Concept ;
    rdfs:label "Legal code"@en ;
    skos:definition "Links to the authoritative legal-text representation of a licence or policy."@en ;
    rdfs:comment "Links to the authoritative legal-text representation of a licence or policy."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (
        openrel:Licence openrel:AccessRules
        openrel:ProcessRules openrel:PolicyCollection
    ) ] ;
    rdfs:range rdfs:Resource ;
    skos:note "Alternative representations, mappings of SPDX and LFS properties. Compare with cc:legalcode; relationship is intentionally not asserted without verification of its published definition."@en .

openrel:policyTextHtml a owl:ObjectProperty, skos:Concept ;
    rdfs:label "Policy text (HTML)"@en ;
    skos:definition "Links to an HTML representation of the policy text."@en ;
    rdfs:comment "Links to an HTML representation of the policy text."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (
        openrel:Licence openrel:AccessRules
        openrel:ProcessRules openrel:PolicyCollection
    ) ] ;
    rdfs:range rdfs:Resource ;
    skos:note "Alternative representations, mappings of SPDX and LFS properties. The object is a resource IRI, not an embedded HTML literal."@en .

openrel:policyText a owl:ObjectProperty, skos:Concept ;
    rdfs:label "Policy text resource"@en ;
    skos:definition "Links to a retrievable representation of the policy text."@en ;
    rdfs:comment "Links to a retrievable representation of the policy text."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (
        openrel:Licence openrel:AccessRules
        openrel:ProcessRules openrel:PolicyCollection
    ) ] ;
    rdfs:range rdfs:Resource ;
    skos:note "Alternative representations, mappings of SPDX and LFS properties. Distinguish a URL to text from a literal containing text."@en .

openrel:encodedRules a owl:ObjectProperty, skos:Concept ;
    rdfs:label "Encoded rules"@en ;
    skos:definition "Links to a machine-readable encoding of the policy rules."@en ;
    rdfs:comment "Links to a machine-readable encoding of the policy rules."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf (
        openrel:Licence openrel:AccessRules
        openrel:ProcessRules openrel:PolicyCollection
    ) ] ;
    rdfs:range odrl:Policy ;
    skos:note "Alternative representations, mappings of SPDX and LFS properties. The linked resource should be typed as an ODRL policy or a suitable OpenREL policy class."@en .

# Specific properties appliable to openrel:PolicyCollection

openrel:hasPolicy
    a owl:ObjectProperty, skos:Concept ;
    rdfs:label "has policy"@en ;
    skos:definition "References a constituent Policy included in an OpenREL Policy Collection."@en ;
    skos:note "Policy Collection: identifies the constituent Policies grouped by a Policy Collection. Each referenced Policy may belong to any ODRL or OpenREL Policy subclass. A Policy Collection must reference at least two Policies."@en ;
    rdfs:domain openrel:PolicyCollection ;
    rdfs:range odrl:Policy .

openrel:hasEvaluationDetail
    a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "has evaluation detail"@en ;
    skos:definition "Associates a Policy Collection with an Evaluation Detail recording the outcome of a comparison involving its constituent Policies."@en ;
    skos:note "A Policy Collection MAY have multiple Evaluation Details representing different comparison purposes, evaluation contexts, or evaluation events. Each Evaluation Detail MAY reference one or more Evaluation Mappings as supporting evidence."@en ;
    rdfs:domain openrel:PolicyCollection ;
    rdfs:range openrel:EvaluationDetail .

openrel:policyEvaluationOutcome
    a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "policy evaluation outcome"@en ;
    skos:definition "Identifies the overall outcome of evaluating or comparing the Policies contained in a Policy Collection."@en ;
    skos:note "The outcome MUST be one of PERMIT, CONDITIONAL, or DENY. It represents the aggregate policy-level decision and is distinct from the individual relationship outcomes recorded by Evaluation Mappings."@en ;
    rdfs:domain openrel:PolicyCollection ;
    rdfs:range skos:Concept .

############################################################################################################
# RULE CLASSES and PROPERTIES
############################################################################################################

# -------------------------------------------------------------------------------------------------------------
# Object/ Class Definition
# -------------------------------------------------------------------------------------------------------------

openrel:PreDuty
    a owl:Class, skos:Concept ;
    rdfs:subClassOf odrl:Duty ;
    rdfs:label "Pre-Action Duty"@en ;
    skos:definition
        "A Duty that MUST be fulfilled before the associated Action may be executed."@en ;
    skos:note
        "A PreDuty represents a prerequisite for executing an Action. A Duty MAY be classified as both a PreDuty and a PostDuty when obligations apply before and after execution."@en .

openrel:PostDuty
    a owl:Class, skos:Concept ;
    rdfs:subClassOf odrl:Duty ;
    rdfs:label "Post-Action Duty"@en ;
    skos:definition
        "A Duty that MUST be fulfilled after execution of the associated Action, within the period or conditions specified by the applicable Policy."@en ;
    skos:note
        "A PostDuty does not, by itself, prevent initial execution of the associated Action. Failure to fulfil it MAY constitute a policy violation or trigger consequences defined by the Policy. A Duty MAY be classified as both a PreDuty and a PostDuty."@en .

# -------------------------------------------------------------------------------------------------------------
# Property Definition
# -------------------------------------------------------------------------------------------------------------

# Not required

############################################################################################################
# ACTION CLASSES and PROPERTIES
############################################################################################################

# -------------------------------------------------------------------------------------------------------------
# Object/ Class Definition
# -------------------------------------------------------------------------------------------------------------

# ODRL odrl:Action is defined by the ODRL vocabulary; not redefined here.

# -------------------------------------------------------------------------------------------------------------
# Property Definition
# -------------------------------------------------------------------------------------------------------------

# ODRL odrl:action is defined by ODRL; not redefined here.

openrel:actionCategory
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Action Category"@en ;
	skos:definition "The Action is typically applicable to these Rules."@en ;
	rdfs:domain odrl:Action ;
	rdfs:range rdfs:Class .

openrel:defaultDuty
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Default Duty"@en ;
	skos:definition "The Action typically implies this Duty."@en ;
	rdfs:domain odrl:Action ;
	rdfs:range odrl:Action .


############################################################################################################
# EVALUATION CLASSES and PROPERTIES
############################################################################################################
# OpenREL Evaluation Vocabulary revised 2026-10-27
# Canonical OpenREL namespace: http://www.w3id.org/ns/openrel/0/
# Schema only. Comparison individuals belong in a separate mappings graph.
# The property openrel:wasDerivedFrom is used with both IRIs
# and string descriptions in existing mapping data. It is deliberately an
# rdf:Property without an OWL object/datatype restriction. Prefer an IRI for
# machine-actionable provenance; use dct:source for a textual corpus citation.
# openrel:allows in corpus data records an observed association,
# not necessarily logical or legal permission or compatibility.


openrel:EvaluationScheme a skos:ConceptScheme ;
    skos:prefLabel "OpenREL Evaluation Vocabulary"@en ;
    dct:title "OpenREL Evaluation Classes and Properties"@en ;
    dct:description "Vocabulary for recording comparisons of policies, actions, constraints and other resources, including assertion provenance and outcomes."@en ;
    dct:created "2026-08-04T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-10-27T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    owl:versionInfo "0.4-reviewed" .

openrel:EvaluationDetail a owl:Class, skos:Concept ;
    rdfs:label "Evaluation Detail"@en ;
    skos:definition "A record of a directed comparison between two resources, identifying the comparison class and the asserted outcome."@en ;
    skos:note "Comparisons MAY concern Actions, Constraints, Policies or other resources. The record does not change either compared resource."@en .

openrel:EvaluationMapping a owl:Class, skos:Concept ;
    rdfs:subClassOf openrel:EvaluationDetail ;
    rdfs:label "Evaluation Mapping"@en ;
    skos:definition "An Evaluation Detail recording a reusable mapping or relationship between two resources."@en ;
    skos:note "Mappings SHOULD be maintained separately from the source vocabulary definitions."@en .

openrel:hasEvaluation a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "has evaluation"@en ;
    skos:definition "Links a resource to a recorded evaluation involving that resource."@en ;
    rdfs:range openrel:EvaluationDetail .

openrel:comparedSubject a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "compared subject"@en ;
    skos:definition "Identifies the source resource in a directed comparison."@en ;
    skos:note "The source resource MAY be an Action, Constraint, Policy or another RDF resource."@en ;
    rdfs:domain openrel:EvaluationDetail .

openrel:comparedIndividual a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "compared individual"@en ;
    skos:definition "Identifies the target resource in a directed comparison."@en ;
    skos:note "Direction is significant for relationships such as odrl:includedIn."@en ;
    rdfs:domain openrel:EvaluationDetail .

openrel:evaluationClass a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "evaluation class"@en ;
    skos:definition "Identifies the RDF class of the resources being compared, such as odrl:Action or odrl:Policy."@en ;
    rdfs:domain openrel:EvaluationDetail ;
    rdfs:range rdfs:Class .

openrel:evaluationOutcome a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "evaluation outcome"@en ;
    skos:definition "Identifies the asserted relationship or outcome of a comparison."@en ;
    skos:note "The value MAY be a concept from the evaluation-outcome scheme or an existing relationship predicate such as odrl:includedIn; the latter is referenced, not asserted directly."@en ;
    rdfs:domain openrel:EvaluationDetail .

openrel:derivationType a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "derivation type"@en ;
    skos:definition "Identifies how a comparison assertion was established or derived."@en ;
    skos:note "Values SHOULD be selected from openrel:typeAssertion, including openrel:assertionSemantic."@en ;
    rdfs:domain openrel:EvaluationDetail ;
    rdfs:range skos:Concept .

openrel:subjectRole a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "subject rule role"@en ;
    skos:definition "Identifies the ODRL rule class associated with the compared subject in its source context."@en ;
    skos:note "For example, odrl:Prohibition."@en ;
    rdfs:domain openrel:EvaluationDetail ;
    rdfs:range rdfs:Class .

openrel:objectRole a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "object rule role"@en ;
    skos:definition "Identifies the ODRL rule class associated with the compared target in its source context."@en ;
    skos:note "For example, odrl:Permission."@en ;
    rdfs:domain openrel:EvaluationDetail ;
    rdfs:range rdfs:Class .

openrel:sourceRelation a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "source relation"@en ;
    skos:definition "Identifies the relationship predicate or term used in the source assertion."@en ;
    skos:note "May coincide with evaluationOutcome, but distinguishes source wording from a normalised outcome."@en ;
    rdfs:domain openrel:EvaluationDetail .

openrel:rationale a rdf:Property, owl:DatatypeProperty, skos:Concept ;
    rdfs:label "rationale"@en ;
    skos:definition "Provides a human-readable explanation of the comparison or its supporting evidence."@en ;
    rdfs:domain openrel:EvaluationDetail ;
    rdfs:range xsd:string .

openrel:support a rdf:Property, owl:DatatypeProperty, skos:Concept ;
    rdfs:label "support count"@en ;
    skos:definition "Specifies the number of source records supporting an observation or comparison."@en ;
    skos:note "A support count alone does not establish compatibility or entailment."@en ;
    rdfs:domain openrel:EvaluationDetail ;
    rdfs:range xsd:nonNegativeInteger .

openrel:assertedBy a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "asserted by"@en ;
    skos:definition "Identifies an agent responsible for asserting the evaluation."@en ;
    skos:note "Use an IRI for an agent; for a plain-text name, use dct:creator."@en ;
    rdfs:domain openrel:EvaluationDetail ;
    rdfs:subPropertyOf prov:wasAttributedTo .

openrel:created a rdf:Property, owl:DatatypeProperty, skos:Concept ;
    rdfs:label "created"@en ;
    skos:definition "Records when the evaluation assertion was created."@en ;
    skos:note "Prefer dct:created for general provenance metadata."@en ;
    rdfs:domain openrel:EvaluationDetail ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dct:created .

openrel:wasDerivedFrom a rdf:Property, skos:Concept ;
    rdfs:label "was derived from"@en ;
    skos:definition "Identifies a source resource or textual source description from which an evaluation assertion was derived."@en ;
    skos:note "This legacy property accepts both IRI and literal values in existing data. For new data, an IRI-valued prov:wasDerivedFrom or a textual dct:source is preferred. It is not declared an owl:ObjectProperty or a subproperty of prov:wasDerivedFrom because some existing values are literals."@en ;
    rdfs:domain openrel:EvaluationDetail .