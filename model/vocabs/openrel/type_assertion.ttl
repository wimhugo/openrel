# OpenREL - Open Rights Encoding Language
# Assertion Types | Version 0.4 (Draft)
# Original version: 29 July 2026; QA revision: 26 October 2026
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE),
# and Wim Hugo (DANS/EUDAT).
#

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

openrel:typeAssertion
    a skos:ConceptScheme ;
    skos:prefLabel "Types of Assertion"@en ;
    dct:title "Assertion Types"@en ;
    dct:description "Types describing how comparison and mapping assertions are established or derived."@en ;
    dct:created "2026-09-11T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-10-26T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    owl:versionInfo "0.5" ;
    skos:hasTopConcept openrel:assertionDeterministic,
        openrel:assertionCorpus,
        openrel:assertionProbabilistic,
        openrel:assertionSemantic,
        openrel:assertionHuman .

openrel:assertionDeterministic
    a skos:Concept ;
    skos:prefLabel "Deterministic Assertion"@en ;
    skos:definition "An assertion produced by applying a defined, reproducible procedure that yields the same result for the same inputs."@en ;
    skos:note "This classification concerns the method of derivation; it does not by itself establish the correctness of the inputs or the resulting assertion."@en ;
    skos:inScheme openrel:typeAssertion ;
    skos:topConceptOf openrel:typeAssertion .

openrel:assertionCorpus
    a skos:Concept ;
    skos:prefLabel "Corpus-Derived Assertion"@en ;
    skos:definition "An assertion derived from analysing a corpus of policy or licence encodings and identifying relationships within that corpus."@en ;
    skos:note "An observed relationship in a corpus does not, by itself, establish a logical or legal implication."@en ;
    skos:inScheme openrel:typeAssertion ;
    skos:topConceptOf openrel:typeAssertion .

openrel:assertionProbabilistic
    a skos:Concept ;
    skos:prefLabel "Probabilistic Assertion"@en ;
    skos:definition "An assertion inferred by a method that produces an estimated or uncertain relationship, for example through vector similarity or generative AI."@en ;
    skos:note "The confidence or uncertainty associated with the assertion should be recorded separately where available."@en ;
    skos:inScheme openrel:typeAssertion ;
    skos:topConceptOf openrel:typeAssertion .

openrel:assertionSemantic
    a skos:Concept ;
    skos:prefLabel "Semantic Assertion"@en ;
    skos:definition "A comparison derived directly from an explicitly defined semantic relationship between resources in an authoritative source vocabulary."@en ;
    skos:note "Used when the comparison reproduces a relationship explicitly asserted in a source vocabulary, such as odrl:includedIn or odrl:implies. The relationship is treated as authoritative within the semantics of that vocabulary, provided that the source assertion is faithfully represented. This classification does not automatically apply to relationships inferred from the source assertion."@en ;
    skos:inScheme openrel:typeAssertion ;
    skos:topConceptOf openrel:typeAssertion .

openrel:assertionHuman
    a skos:Concept ;
    skos:prefLabel "Human Assertion"@en ;
    skos:definition "A comparison derived by a human through inspection of two policies, actions, or constraints."@en ;
    skos:note "Used when the comparison derives from human evaluation or comparison."@en ;
    skos:inScheme openrel:typeAssertion .
