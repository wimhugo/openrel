# -------------------------------------------------------------------------------------------------------------
# Evaluation Outcome Types 
# In OpenREL, Evaluation Outcome Types are used to unambigously identify one or more outcomes of policy comparisons
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3id.org/ns/openrel/0/> .

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dalicc: <https://dalicc.net/ns#> .

# ------------------------------------------------------------
# Evaluation Outcome Types
# ------------------------------------------------------------

openrel:typeEvaluationOutcome
    a skos:ConceptScheme ;
    skos:prefLabel "Evaluation Outcome Types"@en ;
    dct:title "Evaluation Outcome Types"@en ;
    dct:description
        "A controlled vocabulary of outcomes used to evaluate individual policy elements and policies."@en ;
    skos:hasTopConcept
        openrel:pairwiseEvaluation,
        openrel:policyEvaluation ;
    dct:created "2026-06-29T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-11-04T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    owl:versionInfo "0.5" .

# ------------------------------------------------------------
# Pairwise Evaluation Outcomes
# ------------------------------------------------------------

openrel:pairwiseEvaluation
    a skos:Concept ;
    skos:prefLabel "Pairwise Evaluation Outcomes"@en ;
    skos:definition
        "A category of outcomes resulting from comparisons between individual policy elements, including actions and constraints."@en ;
    skos:topConceptOf openrel:typeEvaluationOutcome ;
    skos:inScheme openrel:typeEvaluationOutcome .

openrel:compatible
    a skos:Concept ;
    skos:prefLabel "Compatible"@en ;
    skos:definition
        "Indicates that the compared actions or constraints are compatible and may coexist within a policy or Policy Collection without an identified conflict."@en ;
    skos:scopeNote
        "Compatibility does not establish that the compared resources are identical or semantically equivalent."@en ;
    skos:broader openrel:pairwiseEvaluation ;
    skos:inScheme openrel:typeEvaluationOutcome .

openrel:contradicts
    a skos:Concept ;
    skos:prefLabel "Contradicts"@en ;
    skos:definition
        "Indicates that the compared actions or constraints are in conflict under the applicable evaluation context and cannot be jointly satisfied."@en ;
    rdfs:seeAlso dalicc:contradicts ;
    skos:broader openrel:pairwiseEvaluation ;
    skos:inScheme openrel:typeEvaluationOutcome .

openrel:allows
    a skos:Concept ;
    skos:prefLabel "Allows"@en ;
    skos:definition
        "Indicates that a Prohibition on the subject action can coexist with a Permission on the object action within the same policy."@en ;
    skos:scopeNote
        "An evaluation relation used by the OpenREL reasoner for comparisons involving Prohibitions and Permissions. The result is specific to the compared actions and their rule roles."@en ;
    skos:broader openrel:pairwiseEvaluation ;
    skos:inScheme openrel:typeEvaluationOutcome .

openrel:includedIn
    a skos:Concept ;
    skos:prefLabel "Included In"@en ;
    skos:definition
        "Indicates that the scope or meaning of the subject action or constraint is included within that of the compared object action or constraint."@en ;
    rdfs:seeAlso odrl:includedIn ;
    skos:note
        "Extends the use of inclusion comparisons to constraints and Named Constraints. This evaluation outcome does not change the formal domain or range of odrl:includedIn."@en ;
    skos:broader openrel:pairwiseEvaluation ;
    skos:inScheme openrel:typeEvaluationOutcome .

openrel:implies
    a skos:Concept ;
    skos:prefLabel "Implies"@en ;
    skos:definition
        "Indicates that satisfaction or applicability of the subject action or constraint entails satisfaction or applicability of the compared object action or constraint under the evaluation context."@en ;
    skos:broader openrel:pairwiseEvaluation ;
    skos:inScheme openrel:typeEvaluationOutcome .

openrel:missing
    a skos:Concept ;
    skos:prefLabel "Missing"@en ;
    skos:definition
        "Indicates that an expected action or constraint is absent from the policy being compared."@en ;
    skos:scopeNote
        "An absence is not necessarily a contradiction. Its significance depends on the requirements of the policy evaluation."@en ;
    skos:broader openrel:pairwiseEvaluation ;
    skos:inScheme openrel:typeEvaluationOutcome .

# ------------------------------------------------------------
# Policy-Level Evaluation Outcomes
# ------------------------------------------------------------

openrel:policyEvaluation
    a skos:Concept ;
    skos:prefLabel "Policy-Level Evaluation Outcomes"@en ;
    skos:definition
        "A category of outcomes resulting from evaluation of an individual policy, an access request against a policy, or the combined application of policies."@en ;
    skos:topConceptOf openrel:typeEvaluationOutcome ;
    skos:inScheme openrel:typeEvaluationOutcome .

openrel:policyPermit
    a skos:Concept ;
    skos:prefLabel "PERMIT"@en ;
    skos:definition
        "Indicates that the evaluated request or combined application of policies is permitted, with all applicable prohibitions accounted for and all mandatory preconditions satisfied."@en ;
    skos:broader openrel:policyEvaluation ;
    skos:inScheme openrel:typeEvaluationOutcome .

openrel:policyConditional
    a skos:Concept ;
    skos:prefLabel "CONDITIONAL"@en ;
    skos:definition
        "Indicates that the evaluated request or combined application of policies may be permitted, provided that outstanding mandatory conditions or PreDuties are satisfied."@en ;
    skos:scopeNote
        "The evaluation should identify the outstanding conditions and any required verification, including human assessment where applicable."@en ;
    skos:broader openrel:policyEvaluation ;
    skos:inScheme openrel:typeEvaluationOutcome .

openrel:policyDeny
    a skos:Concept ;
    skos:prefLabel "DENY"@en ;
    skos:definition
        "Indicates that the evaluated request or combined application of policies is not permitted because an applicable Prohibition exists or a mandatory condition cannot be satisfied."@en ;
    skos:scopeNote
        "The evaluation should identify the applicable Prohibition, unsatisfied condition, or other reason supporting the denial."@en ;
    skos:broader openrel:policyEvaluation ;
    skos:inScheme openrel:typeEvaluationOutcome .
