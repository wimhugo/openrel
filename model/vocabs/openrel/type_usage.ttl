# -------------------------------------------------------------------------------------------------------------
# Usage Types 
# In OpenREL, Usage Types are used to unambiguously identify 
# usage conditions. Selected concepts also serve as ODRL LeftOperands,
# whose runtime values are evaluated against thresholds or allowed values.
# -------------------------------------------------------------------------------------------------------------

@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix idsc: <https://w3id.org/idsa/code/> .

# ------------------------------------------------------------
# Usage Types Concept Scheme
# ------------------------------------------------------------

openrel:typeUsage
    a skos:ConceptScheme ;
    skos:prefLabel "Types of Usage"@en ;
    dct:title "Types of Usage"@en ;
    dct:description
        "A classification scheme for usage conditions and restrictions applicable to Actions and Constraints in OpenREL policies."@en ;
    dct:created "2026-07-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-11-05T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    owl:versionInfo "0.6" .

# ------------------------------------------------------------
# Usage Type Concepts
# ------------------------------------------------------------

openrel:connector
    a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "Connector"@en ;
    skos:definition
        "The identifier of the data connector through which the evaluated Action is requested or performed."@en ;
    skos:note
        "The Left Operand resolves to the connector IRI for the current request; compare it with authorised connector identifiers. This does not independently verify the responsible agent."@en ;
    rdfs:seeAlso idsc:CONNECTOR_RESTRICTED_DATA_USAGE ;
    skos:inScheme openrel:typeUsage .

openrel:specificIpRange
    a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "Specific IP Range"@en ;
    skos:definition
        "The IP address of the network endpoint associated with the evaluated Action."@en ;
    skos:note
        "The Left Operand resolves to the relevant endpoint IP address. Matching an address against a CIDR range requires an explicitly supported IP-membership comparison; do not assume ordinary IRI or string inclusion performs CIDR matching."@en ;
    skos:inScheme openrel:typeUsage .

openrel:application
    a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "Application"@en ;
    skos:definition
        "The identifier of the application through which the evaluated Action is requested or performed."@en ;
    rdfs:seeAlso idsc:APPLICATION_RESTRICTED_DATA_USAGE ;
    skos:note
        "The Left Operand resolves to the application identifier in the request context. Application identification is distinct from verification of the requesting agent."@en ;
    skos:inScheme openrel:typeUsage .

openrel:accessDuration
    a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "Access Duration"@en ;
    skos:definition
        "The elapsed duration of access measured from a defined starting event to the evaluation time or proposed end of access."@en ;
    skos:note
        "The Left Operand resolves to an xsd:duration value. The starting event and whether the proposed action duration is included MUST be specified by the evaluation context."@en ;
    rdfs:seeAlso idsc:DURATION_RESTRICTED_DATA_USAGE ;
    skos:inScheme openrel:typeUsage .

openrel:accessWindow
    a skos:Concept ;
    skos:scopeNote "This concept classifies a permitted time interval; it is not itself a runtime Left Operand. An executable constraint should compare an observed or requested date-time with the interval bounds."@en ;
    skos:prefLabel "Access Window"@en ;
    skos:definition
        "A usage condition restricting access to a specified date-time interval."@en ;
    skos:note
        "The interval may be defined by dateTimeFrom and dateTimeTo parameters using xsd:dateTime. Both bounds must be satisfied for access within the interval."@en ;
    rdfs:seeAlso idsc:INTERVAL_RESTRICTED_DATA_USAGE ;
    skos:inScheme openrel:typeUsage .

openrel:spatialCoverage
    a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "Spatial Coverage"@en ;
    skos:definition
        "The geographic location or spatial extent associated with the evaluated Action, agent or system."@en ;
    skos:note
        "The Left Operand resolves to a location or geometry in an explicitly defined representation; the policy MUST identify which entity's location is evaluated and the comparison semantics."@en ;
    rdfs:seeAlso idsc:LOCATION_RESTRICTED_DATA_USAGE ;
    skos:inScheme openrel:typeUsage .

openrel:userRole
    a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "User Role"@en ;
    skos:definition
        "The role held by the relevant Party in the evaluated Action."@en ;
    skos:note
        "The Left Operand resolves to the role of the explicitly identified Party. Role evidence and verification requirements are separate evaluation concerns; values may use the OpenREL typeAgent vocabulary."@en ;
    rdfs:seeAlso idsc:ROLE_RESTRICTED_DATA_USAGE ;
    skos:inScheme openrel:typeUsage .

openrel:usagePurpose
    a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "Usage Purpose"@en ;
    skos:definition
        "The declared or verified purpose associated with the evaluated Action."@en ;
    skos:note
        "The Left Operand resolves to a purpose value, potentially from the OpenREL typePurpose vocabulary. Purpose verification is separate from purpose declaration; this term is distinct from openrel:purpose in typeConstraint."@en ;
    rdfs:seeAlso idsc:PURPOSE_RESTRICTED_DATA_USAGE ;
    skos:inScheme openrel:typeUsage .

openrel:usageCount
    a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "Usage Count"@en ;
    skos:definition
        "The accumulated number of executions of the evaluated Action within the applicable accounting scope, including the proposed execution."@en ;
    skos:note
        "The Left Operand resolves to a non-negative integer count; the accounting entity, action/asset scope, counting window and concurrency rules MUST be specified by the evaluation context. The maximum allowed count is the right operand."@en ;
    rdfs:seeAlso idsc:RESTRICTED_NUMBER_OF_USAGES ;
    skos:inScheme openrel:typeUsage .

openrel:usageVolume a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "Usage Volume"@en ;
    skos:definition "The quantity of data associated with executions of an Action, measured within a defined accounting scope."@en ;
    skos:note "The Left Operand resolves to the accumulated usage volume, including the projected volume of the requested Action. The accounting scope determines the relevant agent, asset, action and accounting period. The measurement unit MUST be compatible with the unit of the right operand before comparison."@en ;
    skos:inScheme openrel:typeUsage .

openrel:securityLevel
    a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "Security Level"@en ;
    skos:definition
        "The security assurance level established for the connector or system associated with the evaluated Action."@en ;
    skos:note
        "The Left Operand resolves to an assurance level in a specified vocabulary; comparisons require a defined ordering or membership relation, and evidence of the evaluated system’s level."@en ;
    rdfs:seeAlso idsc:SECURITY_LEVEL_RESTRICTED_POLICY ;
    skos:inScheme openrel:typeUsage .

# ------------------------------------------------------------
# Optional extension: event-based usage
# ------------------------------------------------------------

openrel:usageEvent
    a skos:Concept, odrl:LeftOperand ;
    skos:prefLabel "Usage Event"@en ;
    skos:definition
        "The event identifier or event type associated with the evaluated Action."@en ;
    skos:note
        "The Left Operand resolves to an event IRI or defined event-type value. Event-triggered time windows require separate temporal evaluation context."@en ;
    rdfs:seeAlso idsc:EVENT_RESTRICTED_DATA_USAGE ;
    skos:inScheme openrel:typeUsage .