# -------------------------------------------------------------------------------------------------------------
# Agent Types (Actor Types)
# In OpenREL, Agent Types are used to unambigously idemntify agents, actors, and roles in the ecosystem
# -------------------------------------------------------------------------------------------------------------

# OpenREL typeAgent reviewed vocabulary, version 0.2
# Original concept IRIs preserved; mappings to external classes removed pending review.
@prefix openrel: <http://www.w3id.org/ns/openrel/0/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

openrel:typeAgent a skos:ConceptScheme ;
    skos:prefLabel "Types of Agents"@en ;
    dct:title "Types of Agents"@en ;
    dct:description "A vocabulary of agent types, roles and related subjects used in the OpenREL research data management context."@en ;
    dct:created "2026-06-29T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0002-0255-5101> ;
    skos:scopeNote "The scheme includes agent types and roles. The broader Data Subject concept also covers non-agent entities; its meaning must not be conflated with the GDPR definition of data subject."@en ;
    owl:versionInfo "0.2" .

openrel:ai-agent a skos:Concept ;
    skos:prefLabel "AI Agent"@en ;
    skos:definition "An AI-based software agent or autonomous process that seeks to access or use an Asset."@en ;
    skos:inScheme openrel:typeAgent .

openrel:human-agent a skos:Concept ;
    skos:prefLabel "Human Agent"@en ;
    skos:definition "A human individual who seeks to access or use an Asset."@en ;
    skos:inScheme openrel:typeAgent .

openrel:research-organisation a skos:Concept ;
    skos:prefLabel "Research Organisation"@en ;
    skos:definition "An organisation whose status as a research-performing or academic institution can be independently verified."@en ;
    skos:note "A separate vocabulary may identify recognised verification methods."@en ;
    skos:inScheme openrel:typeAgent .

openrel:researcher a skos:Concept ;
    skos:prefLabel "Researcher"@en ;
    skos:definition "An agent whose status or role as a researcher can be independently verified."@en ;
    skos:note "A separate vocabulary may identify recognised verification methods."@en ;
    skos:inScheme openrel:typeAgent .

openrel:data-subject a skos:Concept ;
    skos:prefLabel "Data Subject"@en ;
    skos:definition "A person, legal entity, community, ecosystem or geographic region that is the subject of research or information represented by an Asset."@en ;
    skos:note "This OpenREL term is broader than the GDPR concept of a data subject, which concerns an identified or identifiable natural person. DPV may be used to describe personal-data considerations where applicable."@en ;
    skos:inScheme openrel:typeAgent .

openrel:curator a skos:Concept ;
    skos:prefLabel "Curator"@en ;
    skos:definition "An agent responsible for the curation, publication, archiving, dissemination or preservation of an Asset."@en ;
    skos:note "A curator's authority and permissions depend on the applicable repository or catalogue arrangements and policies."@en ;
    skos:inScheme openrel:typeAgent .
