# -------------------------------------------------------------------------------------------------------------
# Evaluation Outcome Types 
# In OpenREL, Evaluation Outcome Types are used to unambigously identify one or more outcomes of policy comparisons
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:typeEvaluationOutcome
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Evaluation Outcomes"@en ;
  dct:title "Types of Evaluation Outcome"@en ;
  dct:description "Types of evaluation outcomes when comparing policies pairwise by action and constraint ."@en ;
  dct:created "2026-29-06T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.1" .
# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# ----------------------------------------------------- --------------------------------------------------------

openrel:compatible
  a skos:Concept ;
  skos:prefLabel "Action or constraint is directly compatible with another"@en ;
  skos:exactmatch owl:sameAs ;
  skos:definition "Action or constraint is directly compatible with another and one can be combined in the same policy or in a policy collection."@en ;
  skos:inScheme openrel:typeEvaluationOutcome .

openrel:contradicts
  a skos:Concept ;
  skos:prefLabel "Action or constraint contracdicts another"@en ;
  skos:exactmatch dalicc:contradicts ;
  skos:definition "Action or constraint is not compatible with another and can not be combined in the same policy or in a policy collection."@en ;
  skos:inScheme openrel:typeEvaluationOutcome .

openrel:includedIn
  a skos:Concept ;
  skos:prefLabel "Action or constraint is included in another"@en ;
  skos:closematch odrl:includedIn ;
  skos:definition "Action or constraint is included in another and can be combined in the same policy or in a policy collection."@en ;
  skos:note "This ODRL property is made applicable also to constraints and named constraints."@en ;
  skos:inScheme openrel:typeEvaluationOutcome .

openrel:implies
  a skos:Concept ;
  skos:prefLabel "Action or constraint implies another"@en ;
  skos:closematch odrl:implies ;
  skos:definition "Action or constraint implies another and can be combined in the same policy or in a policy collection."@en ;
  skos:inScheme openrel:typeEvaluationOutcome .

