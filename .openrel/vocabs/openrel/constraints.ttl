# -------------------------------------------------------------------------------------------------------------
# Constraints
# In OpenREL, Constraints are modelled on ODRL. Constraints may be allowed for any Action 
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

openrel:constraintScheme
  a skos:ConceptScheme ;
  skos:prefLabel "OpenREL Constraints and Mappings"@en ;
  dct:title "OpenREL Constraints and Mappings"@en ;
  dct:description "Constraints defined by OpenREL, and extensions to ODRL and other vocabularies, including mappings."@en ;
  dct:created "2026-06-29T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;  # Wim Hugo
  dct:creator "Melios Katsamakis" ;
  dct:contributor <https://orcid.org/0000-0003-2459-6817> ; # Prodromos Tsiavos
  owl:versionInfo "0.3" .
  ## Discussion
  # Decide whether to define this as a concept scheme with an interlinked vocabulary of terms

# -------------------------------------------------------------------------------------------------------------
# Class Definition
# -------------------------------------------------------------------------------------------------------------

odrl:Constraint
	a rdfs:Class, owl:Class, skos:Concept, odrl:Constraint ;
	rdfs:isDefinedBy odrl: ;
	rdfs:label "Constraint"@en ;
	skos:definition "A boolean expression that refines the semantics of an Action and Party/Asset Collection or declare the conditions applicable to a Rule."@en .

openrel:NamedConstraint
	a rdfs:Class, owl:Class, skos:Concept, odrl:Constraint ;
  	rdfs:subClassOf odrl:Constraint ;
  	rdfs:isDefinedBy openrel: ;
	rdfs:label "Named Constraint"@en ;
  	skos:definition "A subclass that extends the properties of the ODRL Constraint Class."@en ;
	skos:note "ODRL: A boolean expression that refines the semantics of an Action and Party/Asset Collection or declare the conditions applicable to a Rule."@en .

# -------------------------------------------------------------------------------------------------------------
# Property Definition
# -------------------------------------------------------------------------------------------------------------

openrel:constraint
	a rdf:Property , owl:ObjectProperty, skos:Concept, odrl:constraint ;
	rdfs:isDefinedBy odrl: ;
	rdfs:label "Has Constraint"@en ;
	skos:definition "Constraint applied to a Rule"@en ;
	skos:note "Constraints on Rules are used to determine if a rule is Active or not. Example: the Permission rule is only active during the year 2018."@en ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf ( :Policy :Rule ) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf ( :Constraint :LogicalConstraint ) ;
	] .

openrel:namedConstraint
	a rdf:Property , owl:ObjectProperty, skos:Concept;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Has Applicable Named Constraint"@en ;
	skos:definition "Rule has a Named Constraint"@en ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf ( odrl:Policy odrl:Rule ) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf ( odrl:Constraint odrl:LogicalConstraint odrl:NamedConstraint) ;
	] 
	.

openrel:applicableEndpoint
	a rdf:Property , owl:ObjectProperty, skos:Concept;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Has Applicable Endpoint"@en ;
	skos:definition "Endpoint Associated with an OpenREL Named Constraint"@en ;
	skos:note "Named Constraints MAY have designated endpoints for purposes of notification, specification, or compliance checklists."@en ;
	rdfs:domain openrel:NamedConstraint ;
	rdfs:range xsd:anyURI 
    .

openrel:hasLegalBasis
	a rdf:Property , owl:ObjectProperty, skos:Concept;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Has Legal Basis"@en ;
	skos:definition "Endpoint or Details of Legal Basis Associated with an OpenREL Named Constraint"@en ;
	skos:note "Includes ability to reference a IRL to a document or specify details based on DPV."@en ;
	skos:note "Named Constraints MAY have designated endpoints for purposes of notification, specification, or compliance checklists."@en ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf ( openrel:NamedConstraint odrl:Rule ) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf ( odrl:Constraint odrl:LogicalConstraint odrl:NamedConstraint) ;
	] 
	skos:closeMatch dpv:hasLegalBasis ;
	rdfs:range xsd:anyURI 
    .

openrel:constraintType
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Has Applicable Constraint Type"@en ;
	skos:definition "An optional categorisation of an OpenREL Named Constraint in terms of rationale."@en ;
	skos:note "Named Constraints MAY have designated endpoints for purposes of notification, specification, or compliance checklists."@en ;
	rdfs:domain openrel:NamedConstraint ;
	rdfs:range skos:Concept ; #
 	.

openrel:scenario
	a rdf:Property , owl:ObjectProperty, skos:Concept;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Has Applicable Scenario"@en ;
	skos:definition "This named constraint supports a specific scenario or context"@en ;
	skos:note "Scenarios reflect the context of the user (Assignee) or owner (Assigner) and are used to categorise Named Constraints in terms of application."@en ;
	rdfs:domain openrel:NamedConstraint ;
	rdfs:range skos:Concept ; #
 	.

# -------------------------------------------------------------------------------------------------------------
# Named Constraint Instances (Individuals)
# -------------------------------------------------------------------------------------------------------------

openrel:academicUseOnly 
	[ a openrel:NamedConstraint ;
		rdfs:label "Academic Use Only"@en ;
		skos:definition "Asset MUST only be used for Academic Research or Applications"@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		skos:note "Linked to several scenarios related to academic and research use and validation."@en ;
		openrel:constraintType openrel:purpose ;
		openrel:scenario openrel:research-only, openrel:academic-only, openrel:confirmed-researcher, openrel:confirmed-rpo, openrel:affirmed-research ;
		odrl:leftOperand openrel:usePurpose;
		odrl:operator odrl:eq ;
		odrl:rightOperand openrel:academicResearch ;
		]
		.

openrel:verifiedResearcher 
    [ a openrel:namedConstraint ;
        rdfs:label "Asserted Researcher"@en ;
        skos:definition "A general assertion or inference that the end user has the role of a researcher.";@en ;
        openrel:constraintType openrel:role ;
		openrel:scenario openrel:research-only, openrel:academic-only, openrel:confirmed-researcher, openrel:confirmed-rpo, openrel:affirmed-research ;
        odrl:leftOperand openrel:agentRole ;
        odrl:operator odrl:eq ;
        odrl:rightOperand openrel:researcher ;
        ]
        .

openrel:eidasVerifiedResearcher 
    [ a openrel:namedConstraint ;
        rdfs:label "eIDAS Verfied Researcher"@en ;
        skos:definition "End User has been verified as a Researcher via eIDAS.";@en ;
        openrel:constraintType openrel:context ;
        odrl:leftOperand openrel:contextLimitation ;
        odrl:operator odrl:eq ;
        odrl:rightOperand openrel:context-eidas ;
        ]
        .

openrel:notifyInAsset 
	[ a openrel:NamedConstraint ;
		rdfs:label "Notification in Asset"@en ;
		skos:definition "Changes and modifications must be added in the Asset using human-readable text, without removing the current licence information."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:notification ;
		openrel:scenario openrel:attribution ;
		odrl:leftOperand openrel:notificationDuty ;
		odrl:operator odrl:eq ;
		odrl:rightOperand openrel:notify-local-log ;
		]
		.

openrel:logUse 
	[ a openrel:NamedConstraint ;
		rdfs:label "Record Usage in a Log"@en ;
		skos:definition "Instances of use of the asset or asset collection must be recorded in a log and retained for a legally mandated duration."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:notification ;
		openrel:scenario openrel:gdpr-compliance ;
		openrel:scenario openrel:gdpr-controller ;
		odrl:leftOperand openrel:notificationDuty ;
		odrl:operator odrl:eq ;
		odrl:rightOperand openrel:record-in-asset ;
		]
		.

openrel:allowDistrubutionFee 
	[ a openrel:NamedConstraint ;
		rdfs:label "Allow Distribution Fee"@en ;
		skos:definition "Allow the legitimate and reasonable costs of distrbution of the asset or its derivations - not regarded as commercial use."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:revenue ;
		openrel:scenario openrel:non-commercial-only ;
		odrl:leftOperand openrel:revenuePermitted ;
		odrl:operand odrl:eq 
		odrl:rightOperand trsp:distributionCost ;
	]	
	.

openrel:ethicsApproval 
	[ a openrel:NamedConstraint ;
		rdfs:label "Ethics Approval Required"@en ;
		skos:definition "Allow access to the Asset or Asset Collection only when an instutional review board has confirmed ethics approval."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:consent ;
		openrel:scenario openrel:ethics-approval ;
		odrl:leftOperand openrel:consentRequired ;
		odrl:operand odrl:eq 
		odrl:rightOperand openrel:consent-ethics ;
	]	
	.

openrel:consentPrior 
	[ a openrel:NamedConstraint ;
		rdfs:label "Consent is Required Prior to Access"@en ;
		skos:definition "Allow access to the Asset or Asset Collection only applicable consent has been obtained prior to access."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:consent ;
		openrel:scenario openrel:ethics-approval ;
		odrl:leftOperand openrel:consentRequired ;
		odrl:operand odrl:eq 
		odrl:rightOperand openrel:consent-reuse-before ;
	]	
	.

openrel:consentLegal 
	[ a openrel:NamedConstraint ;
		rdfs:label "Consent Required on Legal Basis"@en ;
		skos:definition "Allow reuse of the Asset or Asset Collection based on legal basis consent."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:consent ;
		openrel:scenario openrel:gdpr-controller, openrel:gdpr-compliance, openrel:consent-gdpr ;
		odrl:leftOperand openrel:consentRequired ;
		odrl:operand odrl:eq 
		odrl:rightOperand openrel:consent-legal ;
	]	
	.

openrel:euUseOnly 
	[ a openrel:NamedConstraint ;
		rdfs:label "Allow EU-wide Use"@en ;
		skos:definition "Allow the Asset to be used within the current definition of the EU."@en ;
		skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
		openrel:constraintType openrel:context ;
		openrel:scenario openrel:european-use ;
		odrl:leftOperand openrel:locationLimitation ;
		odrl:operand odrl:eq 
		odrl:rightOperand loc:EU27 ;
	]	
	.




