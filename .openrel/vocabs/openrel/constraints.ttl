# -------------------------------------------------------------------------------------------------------------
# Constraints
# In OpenREL, Constraints are modelled on ODRL. Constraints may be allowed for any Action 
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

openrel:constraintScheme
  a skos:ConceptScheme ;
  skos:prefLabel "OpenREL Constraints and Mappings"@en ;
  dct:title "OpenREL Constraints and Mappings"@en ;
  dct:description "Constraints defined by OpenREL, and extensions to ODRL and other vocabularies, including mappings."@en ;
  dct:created "2026-06-29T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;  # Wim Hugo
  dct:creator "Melios Katsamakis" ;
  dct:contributor <https://orcid.org/0000-0003-2459-6817> ; # Prodromos Tsiavos
  owl:versionInfo "0.3" .
  ## Discussion
  # Decide whether to define this as a concept scheme with an interlinked vocabulary of terms

# -------------------------------------------------------------------------------------------------------------
# Class Definition
# -------------------------------------------------------------------------------------------------------------

openrel:Constraint
	a rdfs:Class, owl:Class, skos:Concept, odrl:Constraint ;
	rdfs:isDefinedBy odrl: ;
	rdfs:label "Constraint"@en ;
	skos:definition "A boolean expression that refines the semantics of an Action and Party/Asset Collection or declare the conditions applicable to a Rule."@en .

openrel:NamedConstraint
	a rdfs:Class, owl:Class, skos:Concept ;
  	rdfs:subClassOf odrl:Constraint ;
  	rdfs:isDefinedBy openrel: ;
	rdfs:label "Named Constraint"@en ;
  	skos:definition "A subclass that extends the properties of the ODRL Constraint Class."@en ;
	skos:note "ODRL: A boolean expression that refines the semantics of an Action and Party/Asset Collection or declare the conditions applicable to a Rule."@en .

# -------------------------------------------------------------------------------------------------------------
# Property Definition
# -------------------------------------------------------------------------------------------------------------

openrel:constraint
	a rdf:Property , owl:ObjectProperty, skos:Concept, odrl:constraint ;
	rdfs:isDefinedBy odrl: ;
	rdfs:label "Has Constraint"@en ;
	skos:definition "Constraint applied to a Rule"@en ;
	skos:note "Constraints on Rules are used to determine if a rule is Active or not. Example: the Permission rule is only active during the year 2018."@en ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf ( :Policy :Rule ) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf ( :Constraint :LogicalConstraint ) ;
	] .

openrel:applicableEndpoint
	a rdf:Property , owl:ObjectProperty, skos:Concept, odrl:constraint ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Has Applicable Endpoint"@en ;
	skos:definition "Endpoint Associated with an OpenREL Named Constraint"@en ;
	skos:note "Named Constraints MAY have designated endpoints for purposes of notification, specification, or compliance checklists."@en ;
	rdfs:domain openrel:NamedConstraint ;
	rdfs:range xsd:anyURI 
    .

openrel:constraintType
	a rdf:Property , owl:ObjectProperty, skos:Concept, odrl:constraint ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Has Applicable Constraint Type"@en ;
	skos:definition "An optional categorisation of an OpenREL Named Constraint in terms of rationale."@en ;
	skos:note "Named Constraints MAY have designated endpoints for purposes of notification, specification, or compliance checklists."@en ;
	rdfs:domain openrel:NamedConstraint ;
	rdfs:range skos:Concept ; #
 	.

openrel:scenario
	a rdf:Property , owl:ObjectProperty, skos:Concept, odrl:constraint ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Has Applicable Scenario"@en ;
	skos:definition "This named constraint supports a specific scenario or context"@en ;
	skos:note "Scenarios reflect the context of the user (Assignee) or owner (Assigner) and are used to categorise Named Constraints in terms of application."@en ;
	rdfs:domain openrel:NamedConstraint ;
	rdfs:range skos:Concept ; #
 	.

# -------------------------------------------------------------------------------------------------------------
# Named Constraint Instances (Individuals)
# -------------------------------------------------------------------------------------------------------------

openrel:academicUseOnly 
	a openrel:NamedConstraint ;
	rdfs:label "Academic Use Only"@en ;
	skos:definition "Asset MUST only be used for Academic Research or Applications"@en ;
	skos:note "Created by OpenREL to assist with compilation and comparison of policies and licences."@en ;
	skos:note "Linked to several scenarios related to academic and research use and validation."@en ;
	openrel:constraintType openrel:purpose ;
	openrel:scnario openrel:research-only, openrel:academic-only, openrel:confirmed-researcher, openrel:confirmed-rpo, openrel:affirmed-research ;
	openrel:usePurpose odrl:eq openrel:academicResearch ;
	.







