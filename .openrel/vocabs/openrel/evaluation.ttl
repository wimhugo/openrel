# -------------------------------------------------------------------------------------------------------------
# Evaluation Details
# In OpenREL, Policy Comparisions can explicitly be recorded as Evaluation Details.
# OpenREL adds a number of specific subclasses
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dpv: <https://w3id.org/dpv> .
@prefix ropa: <https://w3id.org/dpv-ropa#> .

openrel:EvaluationScheme
  a skos:ConceptScheme ;
  skos:prefLabel "OpenREL Evaluation Details"@en ;
  dct:title "OpenREL Evaluation Details"@en ;
  dct:description "In OpenREL, Policy Comparisions can explicitly be recorded as Evaluation Details."@en ;
  dct:created "2026-08-04T00:00:00+00:00"^^xsd:datetime ;  
  dct:modified "2026-08-04T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;  # Wim Hugo
  dct:creator "Melios Katsamakis" ;
  dct:contributor <https://orcid.org/0000-0003-2459-6817> ; # Prodromos Tsiavos
  owl:versionInfo "0.1" .

# -------------------------------------------------------------------------------------------------------------
# Object/ Class Definition
# -------------------------------------------------------------------------------------------------------------

# --------OpenRel

openrel:EvaluationDetail
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Evaluation Detail"@en ;
	skos:definition "A record of comparison of two actions or constraints."@en ;
	.

# -------------------------------------------------------------------------------------------------------------
# Property Definition
# -------------------------------------------------------------------------------------------------------------

openrel:hasEvaluation
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Individual has an asserted evaluation"@en ;
	skos:definition "Action or constraint was compared to another and evaluated"@en ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf ( odrl:Action openrel:NamedConstraint ) ;
	];
	rdfs:range openrel:EvaluationDetail 
	.

openrel:comparedIndividual
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Compared To"@en ;
	skos:definition "Action or constraint was compared to"@en ;
	skos:note "Actions and Constraints can be compared pairwise to other actions and constraints."@en ;
	rdfs:domain openrel:EvaluationDetail ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf ( odrl:Action openrel:NamedConstraint ) ;
	] .

openrel:evaluationOutcome
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Evaluation Outcome"@en ;
	skos:definition "The result of a comparison between two actions or named constraints."@en ;
	skos:note "Actions and Constraints can be compared pairwise to other actions and constraints."@en ;
	rdfs:domain openrel:EvaluationDetail ;
	rdfs:range openrel:typeEvaluationOutcome .

openrel:assertedBy
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Asserted By"@en ;
	skos:definition "The result of a comparison between two actions or named constraints was asserted by."@en ;
	skos:note "An evaluation outcome can be asserted by an individual, an organisation, an agent, or a vocabulary."@en ;
	rdfs:domain openrel:EvaluationDetail ;
	skos:exactMatch prov:wasAttributedTo ;
	rdfs:range rdfs:Resource .

openrel:wasDerivedFrom
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy prov: ;
	rdfs:label "Source of the assertion information."@en ;
	skos:definition "The result of a comparison between two actions or named constraints was asserted by this mechanism or source."@en ;
	skos:closeMatch prov:wasDerivedFrom ;
	rdfs:domain openrel:EvaluationDetail ;
	rdfs:range openrel:DateOrDateTime .

openrel:created
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy dct: ;
	rdfs:label "Date Created"@en ;
	skos:definition "The result of a comparison between two actions or named constraints was asserted on this date."@en ;
	skos:closeMatch dct:created ;
	rdfs:domain openrel:EvaluationDetail ;
	rdfs:range openrel:DateOrDateTime .

# -------------------------------------------------------------------------------------------------------------
# Type Definition
# -------------------------------------------------------------------------------------------------------------

openrel:DateOrDateTime
    a rdfs:Datatype ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:unionOf (
            xsd:date
            xsd:dateTime
        )
    ] 
    .

# -------------------------------------------------------------------------------------------------------------
# Instances (Individuals) Definition
# -------------------------------------------------------------------------------------------------------------

cc:Attribution
    a odrl:Action ;
    openrel:hasEvaluation 
		[
        a openrel:EvaluationDetail ;
        openrel:comparedIndividual cc:Notice ;
		openrel:evaluationOutcome openrel:implies ;
		openrel:assertedBy "Giray Havur" ;
		openrel:wasDerivedFrom <https://github.com/dalicc/dalicc/blob/0f1a7e27a888e08e36cbea3246d6c8fb8d4ba991/licensedata/dependencygraph/dg_default.ttl> ;
    	openrel:created "2023-12-10"
		],
		[
        a openrel:EvaluationDetail ;
        openrel:comparedIndividual odrl:use ;
		openrel:evaluationOutcome openrel:includedIn ;
		openrel:assertedBy "Giray Havur" ;
		openrel:wasDerivedFrom <https://github.com/dalicc/dalicc/blob/0f1a7e27a888e08e36cbea3246d6c8fb8d4ba991/licensedata/dependencygraph/dg_default.ttl> ;
    	openrel:created "2023-12-10"
		],
		[
        a openrel:EvaluationDetail ;
        openrel:comparedIndividual odrl:attribute ;
		openrel:evaluationOutcome openrel:compatibleWith ;
		openrel:assertedBy "Giray Havur" ;
		openrel:wasDerivedFrom <https://github.com/dalicc/dalicc/blob/0f1a7e27a888e08e36cbea3246d6c8fb8d4ba991/licensedata/dependencygraph/dg_default.ttl> ;
    	openrel:created "2023-12-10"
		],
		[
        a openrel:EvaluationDetail ;
        openrel:comparedIndividual openrel:attribute ;
		openrel:evaluationOutcome openrel:compatibleWith ;
		openrel:assertedBy <https://orcid.org/0000-0002-0255-5101> ;
		openrel:wasDerivedFrom <https://github.com/wimhugo/openrel/blob/main/.openrel/vocabs/openrel/actions.ttl> ;
    	openrel:created "2027-08-03"
		]
	.
