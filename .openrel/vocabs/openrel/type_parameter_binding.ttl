@prefix openrel: <http://www.w3.org/ns/openrel/0/> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

openrel:ParameterBindingSource
    a rdfs:Class, skos:ConceptScheme ;
    rdfs:label "Parameter binding source"@en 
    skos:definition "Value explicitly encoded in the policy"@en ;
    skos:note "Example: """P30D"""^^xsd:duration"@en 
    .

openrel:PolicyValue
    a openrel:ParameterBindingSource, skos:Concept ;
    skos:inScheme openrel:ParameterBindingSource ;
    skos:prefLabel "Policy value"@en ;
    skos:definition ""@en 
    .

openrel:EvaluationRequestValue
    a openrel:ParameterBindingSource, skos:Concept ;
    skos:inScheme openrel:ParameterBindingSource ;
    skos:prefLabel "Evaluation-request value"@en ;
    skos:definition ""@en 
    .

