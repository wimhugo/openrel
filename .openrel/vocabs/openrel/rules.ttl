# -------------------------------------------------------------------------------------------------------------
# Rules
# In OpenREL, Rules are modelled on ODRL.
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dpv: <https://w3id.org/dpv> .
@prefix ropa: <https://w3id.org/dpv-ropa#> .

# -------------------------------------------------------------------------------------------------------------
# Object/ Class Definition
# -------------------------------------------------------------------------------------------------------------

odrl:Rule
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:label "Rule"@en ;
	skos:definition "An abstract concept that represents the common characteristics of Permissions, Prohibitions, and Duties."@en ;
	skos:note "Rule is an abstract concept."@en 
  # openREL Extensions
  skos:note ""@en ;
  .

odrl:Permission
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:subClassOf odrl:Rule ;
	owl:disjointWith odrl:Prohibition, odrl:Duty ;
	rdfs:label "Permission"@en ;
	skos:definition "The ability to perform an Action over an Asset."@en 
  # openREL Extensions
  skos:closeMatch ccrel:Permission ;
  skos:note "These actions are often rights that the rights holder (creator or owner) of the Asset can perform, and can grant to third parties."@en ;
  skos:note "ccREL: an action that may or may not be allowed or desired."@en ;
  .

odrl:Prohibition
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:subClassOf odrl:Rule ;
	owl:disjointWith odrl:Duty, odrl:Permission ;
	rdfs:label "Prohibition"@en ;
	skos:definition "The inability to perform an Action over an Asset."@en 
  # openREL Extensions
  skos:closeMatch ccrel:Prohibition ;
  skos:note "ccREL: something you may be asked not to do."@en ;
  skos:note "In practical terms, these are often rights or actions that the rights holder, subject of sensitive data in the Asset, or curator of the Asset do not grant to a third party."@en ;
  .

odrl:Duty
	a rdfs:Class , owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:subClassOf odrl:Rule ;
	owl:disjointWith odrl:Prohibition, odrl:Permission ;
	rdfs:label "Duty"@en ;
  skos:definition "The obligation to perform an Action"@en 
  # openREL Extensions
  skos:closeMatch ccrel:Requirement ;
  skos:note "ccREL: an action that may or may not be requested of you."@en ;
  skos:note "Duties are often related to other actions, especially Permissions, in the sense that a Permission is granted subject to performance of a Duty. For example, use of an Asset may be granted subject to the Duty of proper citation (attribution)."@en ;
  .


  
  
