# -------------------------------------------------------------------------------------------------------------
# Parameters
# In OpenREL, Parameters are modelled as a subclass of Right Operands as a mechanism for run-time evaluation
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dpv: <https://w3id.org/dpv> .
@prefix ropa: <https://w3id.org/dpv-ropa#> .

openrel:ParameterScheme
  a skos:ConceptScheme ;
  skos:prefLabel "OpenREL Actions and Mappings"@en ;
  dct:title "OpenREL Actions and Mappings"@en ;
  dct:description "Actions defined by OpenREL, and extensions to ODRL and other vocabularies, including mappings."@en ;
  dct:created "2026-06-29T00:00:00+00:00"^^xsd:datetime ;  
  dct:modified "2026-07-10T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;  # Wim Hugo
  dct:creator "Melios Katsamakis" ;
  dct:contributor <https://orcid.org/0000-0003-2459-6817> ; # Prodromos Tsiavos
  owl:versionInfo "0.4" .
  ## Discussion
  # Decide whether to define this as a concept scheme with an interlinked vocabulary of terms

# -------------------------------------------------------------------------------------------------------------
# Object/ Class Definition
# -------------------------------------------------------------------------------------------------------------

openrel:Parameter 
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:subClassOf odrl:RightOperand ;
	rdfs:label "Parameters"@en ;
	skos:prefLabel "OpenREL Parameters"@en ;
	dct:title "OpenREL Parameters"@en ;
	dct:description "Parameters defined by OpenREL as an extension to ODRL and other vocabularies, including mappings."@en ;
	dct:created "2026-06-29T00:00:00+00:00"^^xsd:datetime ;  
	dct:modified "2026-08-04T00:00:00+00:00"^^xsd:datetime ;
	dct:creator <https://orcid.org/0000-0002-0255-5101> ;  # Wim Hugo
	dct:creator "Melios Katsamakis" ;
	dct:contributor <https://orcid.org/0000-0003-2459-6817> ; # Prodromos Tsiavos
	owl:versionInfo "01" .
	rdfs:isDefinedBy openrel: ;
	skos:definition "A Right Operand as a Parameter."@en ;
	.
	# Extensions by OpenREL
	#	None

# -------------------------------------------------------------------------------------------------------------
# Property Definition
# -------------------------------------------------------------------------------------------------------------

openrel:parameterName
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Parameter Name"@en ;
	skos:definition "Label or Name of the Parameter."@en ;
	rdfs:domain openrel:Parameter 
  .

openrel:expectedDatatype
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Expected Data Type"@en ;
	skos:definition "Expected data type for the parameter, expressed in XSD syntax."@en ;
	rdfs:domain openrel:Parameter 
  .

openrel:resolutionMethod
	a rdf:Property , owl:ObjectProperty, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Resolution Method"@en ;
	skos:definition "The method whereby the parameter will be resolved."@en ;
	rdfs:domain openrel:Parameter ;
  	rdfs:range openrel:ParameterBindingSource
  .

# -------------------------------------------------------------------------------------------------------------
# Foundational Parameter Instances
# These include parameters that are commonly used in policy templates and standards
# -------------------------------------------------------------------------------------------------------------

# ----------- Date, Time, Duration

openrel:startDateParameter
    a openrel:Parameter, odrl:RightOperand ;
	skos:prefLabel "Start Date" ;
	skos:definition "The start date for a period, usually a period of access."@en ;
    openrel:parameterName "START_DATE" ;
    openrel:expectedDatatype xsd:dateTime ;
    openrel:resolutionMethod openrel:RuntimeContext 
    .

openrel:endDateParameter
    a openrel:Parameter, odrl:RightOperand ;
	skos:prefLabel "End Date" ;
	skos:definition "The end date for a period, usually a period of access."@en ;
    openrel:parameterName "END_DATE" ;
    openrel:expectedDatatype xsd:dateTime ;
    openrel:resolutionMethod openrel:RuntimeContext 
    .

# ---------- Assigner Context

openrel:parameterPublisherIRI
    a openrel:Parameter, odrl:RightOperand ;
	skos:prefLabel "Publisher IRI" ;
	skos:definition "A unique identifier for a publisher (PID, URI, URL)."@en ;
    openrel:parameterName "PUBLISHER_IRI" ;
    openrel:expectedDatatype xsd:anyURI ;
    openrel:resolutionMethod openrel:RepositoryContext 
    .

openrel:parameterAssignerIRI
    a openrel:Parameter, odrl:RightOperand ;
	skos:prefLabel "Assigner IRI" ;
	skos:definition "A unique identifier for the assigner (curator, rights owner) (PID, URI, URL)."@en ;
    openrel:parameterName "ASSIGNER_IRI" ;
    openrel:expectedDatatype xsd:anyURI ;
    openrel:resolutionMethod openrel:RepositoryContext 
    .

openrel:parameterTargetIRI
    a openrel:Parameter, odrl:RightOperand ;
	skos:prefLabel "Target IRI" ;
	skos:definition "A unique identifier for the target (Asset or Asset Collection) (PID, URI, URL)."@en ;
    openrel:parameterName "TARGET_IRI" ;
    openrel:expectedDatatype xsd:anyURI ;
    openrel:resolutionMethod openrel:AssetMetadataValue 
    .

# ---------- Assignee/ Requesting Party Context

openrel:parameterAssigneeIRI
    a openrel:Parameter, odrl:RightOperand ;
	skos:prefLabel "Assignee IRI" ;
	skos:definition "A unique identifier for the assignee (user, requestor) (PID, URI, URL)."@en ;
    openrel:parameterName "ASSIGNEE_IRI" ;
    openrel:expectedDatatype xsd:anyURI ;
    openrel:resolutionMethod openrel:PartyContext 
	.

# ---------- Data Subject Context

openrel:parameterDataSubjectIRI
    a openrel:Parameter, odrl:RightOperand ;
	skos:prefLabel "Data Subject IRI" ;
	skos:definition "A unique identifier for the data subject(s) (PID, URI, URL)."@en ;
    openrel:parameterName "DATA_SUBJECT_IRI" ;
    openrel:expectedDatatype xsd:anyURI ;
    openrel:resolutionMethod openrel:SubjectContext
	.

openrel:parameterInformedConsentIRI
    a openrel:Parameter, odrl:RightOperand ;
	skos:prefLabel "Informed Consent IRI" ;
	skos:definition "A unique identifier for the evidence of informed consent  (PID, URI, URL)."@en ;
    openrel:parameterName "INFORMED_CONSENT_IRI" ;
    openrel:expectedDatatype xsd:anyURI ;
    openrel:resolutionMethod openrel:SubjectContext
	.

openrel:parameterDataSpecIRI
    a openrel:Parameter, odrl:RightOperand ;
	skos:prefLabel "Data Specification IRI" ;
	skos:definition "A unique identifier for a data specification defining data that is in scope for access (PID, URI, URL)."@en ;
    openrel:parameterName "DATA_SPECIFICATION_IRI" ;
    openrel:expectedDatatype xsd:anyURI ;
    openrel:resolutionMethod openrel:SubjectContext
	.

# [VERIFIED_RESEARCHER]
# [VERIFIED_IDENTITY]
# [INSTITUTION_IRI]
# [VERIFIED_RPO]


# ---------- Target Context
openrel:parameterPublicationDate
    a openrel:Parameter, odrl:RightOperand ;
	skos:prefLabel "Asset Publication Date" ;
	skos:definition "The date on which the asset was published - often used for embargo period definition (PID, URI, URL)."@en ;
    openrel:parameterName "TARGET_PUBLICATION_DATE" ;
    openrel:expectedDatatype xsd:dateTime ;
    openrel:resolutionMethod openrel:AssetMetadataValue
	.

