# -------------------------------------------------------------------------------------------------------------
# Agent Types (Actor Types)
# In OpenREL, Agent Types are used to unambigously idemntify agents, actors, and roles in the ecosystem
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:typeAgent
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Agents"@en ;
  dct:title "Types of Agents"@en ;
  dct:description "Types of Agents, Actors, and/ or Roles present in the RDMI ecosystem, and mappiogs to important vocabularies."@en ;
  dct:created "2026-06-29T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  skos:scopeNote "DCAT-AP: May be used in a qualified-attribution to specify the role of an Agent with respect to an Entity. It is recommended that the value be taken from a controlled vocabulary of agent roles."@en ;
  owl:versionInfo "0.1" .
# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# ----------------------------------------------------- --------------------------------------------------------

openrel:ai-agent
  a skos:Concept ;
  skos:prefLabel "AI Agent"@en ;
  skos:definition "Any AI-based (class of) agent or process seeking to use or access an Asset."@en ;
  skos:broadMatch dcat-ap:agent ;
  skos:broadMatch foaf:Group ;
  skos:inScheme openrel:typeAgent .

openrel:research-organisation
  a skos:Concept ;
  skos:prefLabel "Research Organisation"@en ;
  skos:definition "Any (class of) agent or process seeking to use or access an Asset that can be verified by independent means as a research-performing or academic institution."@en ;
  skos:note "A separate vocabulary defines recognised options for means of identification."@en ;
  skos:broadMatch foaf:Group ;
  skos:inScheme openrel:typeAgent .

openrel:researcher
  a skos:Concept ;
  skos:prefLabel "Researcher"@en ;
  skos:definition "Any (class of) agent or process seeking to use or access an Asset that can be verified by independent means as a researcher."@en ;
  skos:note "A separate vocabulary defines recognised options for means of identification."@en ;
  skos:broadMatch foaf:Group ;
  skos:inScheme openrel:typeAgent .

openrel:curator
  a skos:Concept ;
  skos:prefLabel "Curator"@en ;
  skos:definition "Any (class of) agent or process charged with curation, publication, archiving, dissemination, and/or preservation of an Asset."@en ;
  skos:note "Curators are identified and provided with requisite permissions by the Catalogue (dcat:catalogue) hosting the Asset."@en ;
  skos:broadMatch foaf:Group ;
  skos:inScheme openrel:typeAgent .
