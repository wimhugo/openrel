# -------------------------------------------------------------------------------------------------------------
# Consent Types 
# In OpenREL, Consent Types are used to unambigously identify options for requiring consent
# these are typically duties associated with permissions.
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:typeConsent
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Consent"@en ;
  dct:title "Types of Consent"@en ;
  dct:description "Types of Consent applicable to actions and constraints."@en ;
  dct:created "2026-06-29T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.1" .
# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# ----------------------------------------------------- --------------------------------------------------------

openrel:consent-ethics
  a skos:Concept ;
  skos:prefLabel "Ethics Clearance"@en ;
  skos:definition "Requires documented ethics committee or IRB approval prior to access."@en ;
  skos:inScheme openrel:typeConsent .

openrel:consent-informed
  a skos:Concept ;
  skos:prefLabel "Informed Consent"@en ;
  skos:definition "Requires subject consent prior to gathering or processing/ modification of data, for example explicit consent from persons, communities, threatened species, or CARE-related indigenous culture considerations."@en ;
  skos:inScheme openrel:typeConsent .

openrel:consent-legal
  a skos:Concept ;
  skos:prefLabel "Legal Basis Consent"@en ;
  skos:definition "Requires subject consent prior to reusing an Asset - GDPR-compliant explicit consent as the legal basis for processing personal data."@en ;
  skos:broader openrel:consent-informed ;
  skos:exactMatch dpv:Consent ;
  skos:note "DPV: Consent as defined by Article 4(11) of the GDPR"@en ;
  rdfs:isDefinedBy <https://eur-lex.europa.eu/eli/reg/2016/679/art_4/par_11/oj> ;
  skos:inScheme openrel:typeConsent .

openrel:consent-reuse-before
  a skos:Concept ;
  skos:prefLabel "Reuse Consent Before"@en ;
  skos:definition "Requires subject, creator, or curator consent for reuse prior to access, with subject rights and applicable legislation in mind."@en ;
  skos:inScheme openrel:typeConsent .

openrel:consent-reuse-after
  a skos:Concept ;
  skos:prefLabel "Reuse Consent After"@en ;
  skos:definition "Requires subject, creator, or curator consent forpublication or disseminationof derived or modified assets."@en ;
  skos:inScheme openrel:typeConsent .

