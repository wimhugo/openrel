# -------------------------------------------------------------------------------------------------------------
# Status Types 
# In OpenREL, Status Types are used to unambigously define the status of a policy
# constraints on future licence and policy options
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:typeStatus
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Policy Status"@en ;
  dct:title "Policy Status Types"@en ;
  dct:description "States applicable to policies."@en ;
  dct:created "2026-09-01:00:00+00:00"^^xsd:dateTime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.1" .
# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# ----------------------------------------------------- --------------------------------------------------------

openrel:typeDraft
  a skos:Concept ;
  skos:prefLabel "Draft Policy"@en ;
  skos:definition "A policy that is still in draft status. Private by default."@en ;
  skos:inScheme openrel:typeStatus .

openrel:typeReview
  a skos:Concept ;
  skos:prefLabel "Policy in Review"@en ;
  skos:definition "A policy that is being reviewed. Private by default."@en ;
  skos:inScheme openrel:typeStatus .

openrel:typeActive
  a skos:Concept ;
  skos:prefLabel "Policy is Active"@en ;
  skos:definition "A policy that is active. Can be private, custom, or global"@en ;
  skos:inScheme openrel:typeStatus .

openrel:typePrivateActive
  a skos:Concept ;
  skos:prefLabel "Policy is Active/ Private"@en ;
  skos:definition "A policy that is active but applicable in a specific private context only. For example, assigner, assignee, and asset have all been explicitly defined."@en ;
  skos:broader openrel:typeActive ;
  skos:inScheme openrel:typeStatus .

openrel:typeCustomActive
  a skos:Concept ;
  skos:prefLabel "Policy is Active/ Custom"@en ;
  skos:definition "A policy that is active but applicable in a specific custom context only. For example, assigner and asset collection may have been explicitly defined - typically for a repositiry or collection."@en ;
  skos:broader openrel:typeActive ;
  skos:inScheme openrel:typeStatus .

openrel:typeGlobalActive
  a skos:Concept ;
  skos:prefLabel "Policy is Active/ Global"@en ;
  skos:definition "A policy that is active and applicable globally. Typically, assigner, assignee, and asset/ asset collection are not defined."@en ;
  skos:broader openrel:typeActive ;
  skos:inScheme openrel:typeStatus .

