# -------------------------------------------------------------------------------------------------------------
# Notification Purpose Types 
# Based on various inputs
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:notification-target-type
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Notification Targets"@en ;
  dct:title "Types of Notification Targets"@en ;
  dct:description "Types of notification targets that can be used to distinguish endpoints."@en ;
  dct:created "2026-07-06T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.4" .
# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# ----------------------------------------------------- --------------------------------------------------------

openrel:notify-attribution
  a skos:Concept ;
  skos:prefLabel "Attribution Notification"@en ;
  skos:definition "Notifications of attribution and citation are made to this endpoint."@en ;
  rdfs:isDefinedBy openrel: ;
  skos:inScheme openrel:notification-target-type .

openrel:notify-clearinghouse
  a skos:Concept ;
  skos:prefLabel "Clearinghouse Notification"@en ;
  skos:definition "Notifications of use and/ or access are made to this audit/ clearinghouse endpoint. This assists with pre- or post-use permissions to publish, for example."@en ;
  rdfs:isDefinedBy openrel: ;
  skos:closeMatch idsc:REMOTE_NOTIFICATION ;
  skos:note "IDSC: This policy restricts the usage of data assets with the obligation to notify a specific party about the data usage."@en.
  skos:inScheme openrel:trustType .

openrel:notify-external-log
  a skos:Concept ;
  skos:prefLabel "External Notification"@en ;
  skos:definition "Notifications of use and/ or access are made to this external endpoint."@en ;
  rdfs:isDefinedBy openrel: ;
  skos:exactMatch idsc:REMOTE_NOTIFICATION ;
  skos:note "IDSC: This policy restricts the usage of data assets with the obligation to notify a specific party about the data usage."@en.
  skos:inScheme openrel:trustType .

openrel:notify-local-log
  a skos:Concept ;
  skos:prefLabel "Local Logging Notification"@en ;
  skos:definition "Notifications of use and/ or access are made to a local log meeting specific requirements."@en ;
  skos:exactMatch idsc:LOCAL_LOGGING ;
  rdfs:isDefinedBy idsc: ;
  skos:note "This policy restricts the usage of data assets with the obligation to log prior specified processes, such as the data access. Rightoperand can also be a template or specification."@en ;
  skos:inScheme openrel:trustType .
