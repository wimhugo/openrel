# Connect my GitHub so I can directly select and pull raw TTL vocabulary files from my public repositories into the manager.

# -------------------------------------------------------------------------------------------------------------
# OpenREL - Open Rights Encoding language
# Version 0.4 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE), and Wim Hugo (DANS/ EUDAT)
# This Version: 6 July 2026
# -------------------------------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------------------------------
# Notification Purpose Types 
# Based on various inputs
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dpv: <https://w3id.org/dpv> .
@prefix ropa: <https://w3id.org/dpv-ropa#> .
@prefix eu-gdpr: <https://www.w3.org/community/reports/dpvcg/CG-FINAL-eu-gdpr-20260225/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:notification-target-type
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Notification Targets"@en ;
  dct:title "Types of Notification Targets"@en ;
  dct:description "Types of notification targets that can be used to distinguish endpoints."@en ;
  dct:created "2026-07-06T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.4" .
# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# ----------------------------------------------------- --------------------------------------------------------

openrel:notify-attribution
  a skos:Concept ;
  skos:prefLabel "Attribution Notification"@en ;
  skos:definition "Notifications of attribution and citation are made to this endpoint."@en ;
  rdfs:isDefinedBy openrel: ;
  skos:inScheme openrel:notification-target-type .

openrel:notify-clearinghouse
  a skos:Concept ;
  skos:prefLabel "Clearinghouse Notification"@en ;
  skos:definition "Notifications of use and/ or access are made to this audit/ clearinghouse endpoint. This assists with pre- or post-use permissions to publish, for example."@en ;
  rdfs:isDefinedBy openrel: ;
  skos:closeMatch idsc:REMOTE_NOTIFICATION ;
  skos:note "IDSC: This policy restricts the usage of data assets with the obligation to notify a specific party about the data usage."@en.
  skos:inScheme openrel:notification-target-type .

openrel:notify-external-log
  a skos:Concept ;
  skos:prefLabel "External Notification"@en ;
  skos:definition "Notifications of use and/ or access are made to this external endpoint."@en ;
  rdfs:isDefinedBy openrel: ;
  skos:exactMatch idsc:REMOTE_NOTIFICATION ;
  skos:note "IDSC: This policy restricts the usage of data assets with the obligation to notify a specific party about the data usage."@en.
  skos:inScheme openrel:notification-target-type .

openrel:notify-local-log
  a skos:Concept ;
  skos:prefLabel "Local Logging Notification"@en ;
  skos:definition "Notifications of use and/ or access are made to a local log meeting specific requirements."@en ;
  skos:exactMatch idsc:LOCAL_LOGGING ;
  rdfs:isDefinedBy idsc: ;
  skos:note "This policy restricts the usage of data assets with the obligation to log prior specified processes, such as the data access. Rightoperand can also be a template or specification."@en ;
  skos:inScheme openrel:notification-target-type .

openrel:notify-ropa 
  a skos:Concept ;
  skos:exactMatch ropa:ROPA ;
  rdfs:isDefinedBy ropa: ;
  rdfs:prefLabel "Register of Processing Activities (ROPA)"@en ;
  skos:definition "All instances of use must be logged in a register of processing activity to comply with GDPR, and the vocabulary defined by ROPA may be used to describe these activities."@en ;
  skos:note "ROPA: A ROPA is a document maintained by Data Controllers detailing processing activities carried out under their responsibility"@en ;
  skos:inScheme openrel:notification-target-type .

openrel:record-in-asset 
  a skos:Concept ;
  skos:closeMatch dalicc:modificationNotice ;
  rdfs:isDefinedBy openrel: ;
  rdfs:prefLabel "Record in Asset"@en ;
  skos:definition "All instances of use must be recorded in human-readable form within the licenced asset. Records of previous modification must be retained."@en ;
  skos:note "DALICC: A notice that indicates if the Assignee modified the Licensed Material and retains an indication of any previous modifications."@en ;
  skos:note "This captures the requirement to annotate e.g. source code, where the original licence is displayed as comments, with additional comments to indicate changes."@en ;
  skos:inScheme openrel:notification-target-type .

openrel:notice-collection-subject
  a skos:Concept ;
  skos:closeMatch eu-gdpr:DirectDataCollectionNotice ;
  rdfs:isDefinedBy openrel: ;
  rdfs:prefLabel "Notice to Subject"@en ;
  skos:definition "All instances of sensitive subject data collection from third-party sources must be notified to the subject."@en ;
  skos:note "EU-GDPR: A Notice provided in fulfilment of GDPR's Art.13 regarding information to be provided where personal data are collected from the data subject."@en ;
  dct:source <https://eur-lex.europa.eu/eli/reg/2016/679/art_13/oj> ;
  skos:inScheme openrel:notification-target-type .

openrel:notice-collection-indirect
  a skos:Concept ;
  skos:closeMatch eu-gdpr:IndirectDataCollectionNotice ;
  rdfs:isDefinedBy openrel: ;
  rdfs:prefLabel "Notice to Subject - Indirect"@en ;
  skos:definition "All instances of sensitive subject data collection from third-party and indirect sources must be notified to the subject."@en ;
  skos:note "EU-GDPR: A Notice provided in fulfilment of GDPR's Art.14 regarding information to be provided where personal data are not collected from the data subject."@en ;
  dct:source <https://eur-lex.europa.eu/eli/reg/2016/679/art_14/oj>  ;
  skos:inScheme openrel:notification-target-type .

openrel:notice-collection-indirect
  a skos:Concept ;
  skos:closeMatch eu-gdpr:IndirectDataCollectionNotice ;
  rdfs:isDefinedBy openrel: ;
  rdfs:prefLabel "Notice to Subject - Indirect"@en ;
  skos:definition "All instances of sensitive subject data collection from third-party and indirect sources must be notified to the subject."@en ;
  skos:note "EU-GDPR: A Notice provided in fulfilment of GDPR's Art.14 regarding information to be provided where personal data are not collected from the data subject."@en ;
  dct:source <https://eur-lex.europa.eu/eli/reg/2016/679/art_14/oj>  ;
  skos:inScheme openrel:notification-target-type .

openrel:notice-actions
  a skos:Concept ;
  skos:closeMatch eu-gdpr:RightsRecipientsNotice ;
  rdfs:isDefinedBy openrel: ;
  rdfs:prefLabel "Notice - Actions"@en ;
  skos:definition "Actions requested by the data subject (rectification, erasure, ...) notified to the subject on completion."@en ;
  skos:note "EU-GDPR: A Notice provided in fulfilment of GDPR's Art.19 regarding Recipients to whom a rights exercise has been communicated, such as regarding rectification (A.16) or erasure of personal data (A.17) or restriction of processing (A.18)."@en ;
  dct:source <https://eur-lex.europa.eu/eli/reg/2016/679/art_19/oj>  ;
  skos:inScheme openrel:notification-target-type .

openrel:notice-sar
  a skos:Concept ;
  skos:closeMatch eu-gdpr:SARNotice ;
  rdfs:isDefinedBy openrel: ;
  rdfs:prefLabel "Notice - Subject Access Request"@en ;
  skos:definition "Fulfilment of a subject's request for access to subject data is notified to the subject on completion."@en ;
  skos:note "EU-GDPR: A Notice provided in fulfilment of GDPR's Art.15 regarding information to be provided for Right of Access or Subject Access Request (SAR)."@en ;
  dct:source <https://eur-lex.europa.eu/eli/reg/2016/679/art_15/oj>  ;
  skos:inScheme openrel:notification-target-type .



