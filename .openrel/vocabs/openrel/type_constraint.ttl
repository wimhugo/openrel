# -------------------------------------------------------------------------------------------------------------
# Named Constraint Types 
# Based on various inputs
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dpv: <https://w3id.org/dpv> .
@prefix ropa: <https://w3id.org/dpv-ropa#> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:constraint-type
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Named Constraints"@en ;
  dct:title "Types of Named Constraints"@en ;
  dct:description "Types of Named Constraints that are used for categorisation of instances."@en ;
  dct:created "2026-07-10T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.4" .

# -------------------------------------------------------------------------------------------------------------
# Concept Definitions
# -------------------------------------------------------------------------------------------------------------

openrel:role
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy odrl: ;
	rdfs:label "Role"@en 
	skos:definition "Named Constraint defined on the basis of an Agent Role."@en ;
	skos:note "Role-based Constraints may apply to any Action. Agent typology can be obtained from .openrel/vocabs/openrel/type_agent.ttl"@en ;
	skos:inScheme openrel:constraint-type .

openrel:usage
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Usage"@en 
	skos:definition "Constraint defined on the basis of usage characteristics."@en ;
	skos:note "Usage-based Constraints may apply to any Action. Usage typology can be obtained from .openrel/vocabs/openrel/type_usage.ttl"@en ;
	skos:inScheme openrel:constraint-type .

openrel:access
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Access"@en 
	skos:definition "Constraint defined on the basis of allowable access types."@en ;
	skos:note "Access-based Constraints may apply to any Action. Access typology can be obtained from .openrel/vocabs/openrel/type_access.ttl"@en ;
	skos:inScheme openrel:constraint-type .

openrel:purpose
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Purpose"@en 
	skos:definition "Constraint defined on the basis of allowable purposes and research types."@en ;
	skos:note "Purpose-based Constraints may apply to any Action. Purpose typology can be obtained from .openrel/vocabs/openrel/type_agent.ttl"@en ;
	skos:inScheme openrel:constraint-type .

openrel:notification
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Notification"@en 
	skos:definition "Constraint defined for elaboration of notification duties."@en ;
	skos:note "Notification-based Constraints may apply to any Action. Notification target typology can be obtained from .openrel/vocabs/openrel/type_notification-target.ttl"@en ;
	skos:inScheme openrel:constraint-type .

openrel:consent
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Consent"@en 
	skos:definition "Constraint defined for definition of consent-related duties."@en ;
	skos:note "Consent-based Constraints may apply to any Action, but usually in context of a Duty. Consent vocabulary can be obtained from .openrel/vocabs/openrel/type_consent.ttl"@en ;
	skos:inScheme openrel:constraint-type .

openrel:context
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Context"@en 
	skos:definition "Constraint defined for definition of agent-related context."@en ;
	skos:note "Context-based Constraints may apply to any Action, but usually in relation to a prohibition. Context vocabulary can be obtained from .openrel/vocabs/openrel/type_context.ttl"@en ;
	skos:inScheme openrel:constraint-type .

openrel:tom
	a rdfs:Class, owl:Class, skos:Concept ;
	rdfs:isDefinedBy openrel: ;
	rdfs:label "Technical and Organisation Measures"@en 
	skos:definition "Constraint defined for definition of technical, organisational, legal, and physical measures required to safeguard sensitive data."@en ;
	skos:note "Any class or subclass defined by DPV in TOM (https://www.w3.org/community/reports/dpvcg/CG-FINAL-dpv-20240801/modules/TOM.html) is a valid left operand when describing this constraint. Additional vocabulary, focused on non-personal sensitive data can be obtained from .openrel/vocabs/openrel/type_tom.ttl"@en ;
	skos:inScheme openrel:constraint-type .













