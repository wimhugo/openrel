# -------------------------------------------------------------------------------------------------------------
# Access Types 
# In OpenREL, Access Types are used to unambigously identify a superclass of provisions, and to define 
# constraints on future licence and policy options
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix openrel: <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:typeAccess
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Access"@en ;
  dct:title "Types of Agents"@en ;
  dct:description "Types of Access applicable to actions and constraints."@en ;
  dct:created "2026-06-29T00:00:00+00:00"^^xsd:dateTime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.1" .
# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# ----------------------------------------------------- --------------------------------------------------------

openrel:open-access
  a skos:Concept ;
  skos:prefLabel "Open Access"@en ;
  skos:definition "COAR: Open access refers to a resource that is immediately and permanently online, and free for all on the Web, without financial and technical barriers.The resource is either stored in the repository or referenced to an external journal or trustworthy archive."@en ;
  skos:exactMatch r3d:dataAccessTypes/open ;
  skos:exactMatch coar:dataAccessTypes/c_abf2/ ;
  skos:inScheme openrel:typeAccess .

openrel:embargoed
  a skos:Concept ;
  skos:prefLabel "Embargoed"@en ;
  skos:definition "COAR: Embargoed access refers to a resource that is metadata only access until released for open access on a certain date. Embargoes can be required by publishers and funders policies, or set by the author (e.g such as in the case of theses and dissertations)."@en ;
  skos:note "OpenREL does not regard an embargo as a special type of access, but a constraint that can be encoded for permissions or other rules. It could apply to any other type of access (open, restricted, managed, ...)"@en ;
  skos:exactMatch r3d:dataAccessTypes/embargoed ;
  skos:exactMatch coar:dataAccessTypes/c_f1cf/ ;
  skos:inScheme openrel:typeAccess .

openrel:restricted
  a skos:Concept ;
  skos:prefLabel "Restricted"@en ;
  skos:definition "COAR: Restricted access refers to a resource that is available in a system but with some type of restriction for full open access. This type of access can occur in a number of different situations. Some examples are described below: The user must log-in to the system in order to access the resource The user must send an email to the author or system administrator to access the resource Access to the resource is restricted to a specific community (e.g. limited to a university community)"@en ;
  skos:exactMatch r3d:dataAccessTypes/restricted ;
  skos:exactMatch coar:dataAccessTypes/c_16ec/ ;
  skos:inScheme openrel:typeAgent .

openrel:closed
  a skos:Concept ;
  skos:prefLabel "Closed"@en ;
  skos:definition "The metadata for the resource is available, but the data is not."@en ;
  skos:exactMatch coar:dataAccessTypes/c_14cb/ ;
  skos:exactMatch r3d:dataAccessTypes/closed ;
  skos:inScheme openrel:typeAgent .

openrel:managed
  a skos:Concept ;
  skos:prefLabel "Managed"@en ;
  skos:definition "The resource is available to any end user that complies with rules designed to protect the interests of the subjects. Access is not determined on an ad-hoc basis and it is possible to verify prior to requesting access whether such access will be granted."@en ;
  skos:broadMatch foaf:Group ;
  skos:inScheme openrel:typeAgent .
