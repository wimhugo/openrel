# -------------------------------------------------------------------------------------------------------------
# TRUST Types 
# Based on IDSC Security Guarantee vocabulary
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:typeTrust
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Trusted Connectors"@en ;
  dct:title "Types of Trusted Connectors"@en ;
  dct:description "Types of connectors with levels of trust certification as defined for Data Spaces."@en ;
  dct:created "2026-07-06T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.1" .
# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# ----------------------------------------------------- --------------------------------------------------------

openrel:base
  a skos:Concept ;
  skos:prefLabel "Base TRUST Certification"@en ;
  skos:definition "IDSC: Default security profile of a certified IDS Connector."@en ;
  skos:exactMatch idsc:BASE_SECURITY_PROFILE ;
  rdfs:isDefinedBy idsc: ;
  skos:inScheme openrel:typeTrust .

openrel:trust
  a skos:Concept ;
  skos:prefLabel "TRUST Certification"@en ;
  skos:definition "The Security Profile TRUST as defined by the IDS certification criteria."@en ;
  skos:exactMatch idsc:TRUST_SECURITY_PROFILE ;
  rdfs:isDefinedBy idsc: ;
  skos:inScheme openrel:typeTrust .

openrel:trust-plus
  a skos:Concept ;
  skos:prefLabel "TRUST + Certification"@en ;
  skos:definition "The Security Profile TRUST+ as defined by the IDS certification criteria."@en ;
  skos:exactMatch idsc:TRUST_PLUS_SECURITY_PROFILE ;
  rdfs:isDefinedBy idsc: ;
  skos:inScheme openrel:typeTrust .
