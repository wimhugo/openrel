# -------------------------------------------------------------------------------------------------------------
# OpenREL - Open Rights Encoding language
# Version 0.4 (Draft)
# Developed by Melios Katsamakis and Prodromos Tsiavos (OpenAIRE) and Wim Hugo (DANS/ EUDAT)
# This Version: 1 July 2026
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Metadata
# -------------------------------------------------------------------------------------------------------------

openrel:
	a owl:Ontology ;
	rdfs:label "OpenREL Version 0.4"@en ;
	owl:versionInfo "0.4" ;
	dct:creator "Melios Katsamakis", "Wim Hugo", "Prodromos Tsiavos" ;
	dct:contributor "EOSC Beyond WP 13 and WP 15" ;
	dct:description "OpenREL supports the machine-readable expression of licences, access conditions, obligations and reuse policies for EOSC resources. "@en ;
	rdfs:comment "This is the RDF ontology for OpenREL Version 0.4"@en ;
    dct:created "2026-06-20T00:00:00+00:00"^^xsd:datetime ;
	dct:license <https://spdx.org/licenses/CC-BY-4.0.html/> .

