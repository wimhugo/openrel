# -------------------------------------------------------------------------------------------------------------
# Properties
# definition of properties
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> .
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Applicable to Policies (Licences)
# -------------------------------------------------------------------------------------------------------------

# --------- OpenREL

openrel:assetType
        a rdfs:Property skos:Concept ;
        rdfs:label "Asset Type"@en ;        
        skos:definition "A property that describes one or more asset types, as defined in an appropriate vocabulary. Applicable to Policies, Assets, and Asset Collections. Can also be encoded in Policies as 'Target' with types from relevant vocabularies."@en ;
        skos:note "DALICCe.g cc:CreativeWork. This asset type comprises any type of literary work that is subject to copyright. It also includes multimedia work that combines various media types such as text, audio, images, animations, video and interactive content."@en ;
        rdfs:isDefinedBy openrel: .

openrel:dataSubjectRights
        a rdfs:Property, skos:Concept ;
        rdfs:label "Subject Rights"@en ;        
        skos:definition "Declares GDPR data subject rights applicable to an openrel:Process policy. Maps to W3C DPV rights vocabulary. No ODRL equivalent.."@en ;
        skos:note "GDPR Chapter III / W3C DPV"@en ;
        rdfs:isDefinedBy openrel: .

openrel:agentDelegation
        a rdfs:Property, skos:Concept ;
        rdfs:label "Agent Delegation"@en ;        
        skos:definition "Captures the human principal, purpose scope, and expiry of an AI agent's delegation. Specific to agentic AI scenarios in openrel:Process policies. No ODRL equivalent.."@en ;
        skos:note "OpenREL internal — EU AI Act / agentic workflow governance"@en ;
        rdfs:isDefinedBy openrel: .

openrel: subPolicyOf
        a rdfs:Property, skos:Concept ;
        rdfs:label "Sublicence of"@en ;        
        skos:definition "The licence is based on an original licence that allows derived licences to be granted to third parties.."@en ;
        skos:note "OpenREL, in response to DALICC property 'sublicense'."@en ;
        rdfs:isDefinedBy openrel: .

openrel:warrantyNotice
        a rdfs:Property skos:Concept ;
        rdfs:label "Warranty Notice"@en ;        
        skos:definition "Provides a text-based warrantly notice if applicable, and can state the terms of warranty or, more commonly, a disclaimer."@en ;
        skos:exactMatch dalicc:WarrantyDisclaimer ;
        skos:exactMatch dalicc:noWarrantyNotice ;
        skos:note "OpenREL, in response to DALICC property 'noWarrantyNotice'. and 'WarrantyDisclaimer'."@en ;
        rdfs:isDefinedBy dalicc: .

openrel:liabilityLimitation
        a rdfs:Property, skos:Concept ;
        rdfs:label "Liability Limitation"@en ;        
        skos:definition "Provides a text-based liability limitation if applicable,."@en ;
        skos:exactMatch dalicc:LiabilityLimitation ;
        skos:note "OpenREL, in response to DALICC property 'noWarrantyNotice'. and 'WarrantyDisclaimer'."@en ;
        rdfs:isDefinedBy dalicc: .

openrel:validityType
        a rdfs:Property, skos:Concept ;
        rdfs:label "Validity Type"@en ;        
        skos:definition "A range of validity types typically included into licences. Values are sourced from the Validity Type vocabulary (https://github.com/wimhugo/openrel/blob/main/.openrel/vocabs/openrel/type_validity.ttl)."@en ;
        skos:exactMatch dalicc:validityType ;
        skos:note "DALICC. Modified by OpenREL to refer to vocabulary terms in the 'Licence Type Vocabulary'."@en ;
        rdfs:isDefinedBy dalicc: .

# --------- Dublin Core

dct:subject
        a rdfs:Property, skos:Concept ;
        rdfs:label "Subject"@en ;        
        skos:definition "Any keyword or categorisation that can be used to aid classification or discovery of the object."@en ;
        skos:note ""@en ;
        rdfs:isDefinedBy dct: .

# --------- DALICC

dalicc:contradicts
        a rdfs:Property, skos:Concept ;
        rdfs:label "Contradicts"@en ;        
        skos:definition "An Action contradicts with another Action."@en ;
        skos:note "DALICC"@en ;
        rdfs:isDefinedBy dalicc: .

dalicc:WarrantyDisclaimer
        a rdfs:Property, skos:Concept ;
        rdfs:label "Warranty Disclaimer"@en ;        
        skos:definition "."@en ;
        skos:exactMatch openrel:warrantynotice ;
        skos:note "DALICC"@en ;
        rdfs:isDefinedBy dalicc: .

dalicc:LiabilityLimitation
        a rdfs:Property, skos:Concept ;
        rdfs:label "Liability Limitation"@en ;        
        skos:definition "."@en ;
        skos:note "DALICC"@en ;
        rdfs:isDefinedBy dalicc: .

dalicc:validityType
        a rdfs:Property, skos:Concept ;
        rdfs:label "Validity Type"@en ;        
        skos:definition "."@en ;
        skos:note "DALICC. Modified by OpenREL to refer to vocabulary terms in the 'Licence Type Vocabulary'."@en ;
        rdfs:isDefinedBy dalicc: .

dalicc:patentNotice
        a rdfs:Property, skos:Concept ;
        rdfs:label "Patent Notice"@en ;        
        skos:definition "Notifies that Licensed Material is patented or includes patented parts. True or false, or a patent information text value.."@en ;
        skos:note "DALICC"@en ;
        rdfs:isDefinedBy dalicc: .

dalicc:trademarkNotice
        a rdfs:Property skos:Concept ;
        rdfs:label "Trademark Notice"@en ;        
        skos:definition "Informs that Licensed Material is a trademark or includes trademark. The license does not grant permission to use the trade names, trademarks, service marks, or product names of the Licensor, except as required for reasonable and customary use in describing the origin of the Work and reproducing the content of the notice file. True or false.."@en ;
        skos:note "DALICC"@en ;
        rdfs:isDefinedBy dalicc: .

dalicc:noWarrantyNotice
        a rdfs:Property, skos:Concept ;
        rdfs:label "No Warranty Notice"@en ;        
        skos:definition "Informs that Licensed Material does or does not provide any warranties. Property value is true or false, or text.."@en ;
        skos:note "DALICC"@en ;
        rdfs:isDefinedBy dalicc: .

dalicc:sublicense
        a rdfs:Property, skos:Concept ;
        rdfs:label "Sublicense"@en ;        
        skos:definition "The license granted by a licensee to a third party, under the authority of the license originally granted by a licensor to the licensee.."@en ;
        skos:note "DALICC"@en ;
        rdfs:isDefinedBy dalicc: .
