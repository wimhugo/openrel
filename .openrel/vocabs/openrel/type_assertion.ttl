# -------------------------------------------------------------------------------------------------------------
# Assertion Types 
# In OpenREL, Assertion Types are used to  identify the source of comparisons and mappings
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:typeAssertion
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Assertion"@en ;
  dct:title "Types of Evaluation Outcome"@en ;
  dct:description "Assertion Types are used to identify the source of comparisons and mappings ."@en ;
  dct:created "2026-09-11T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.1" .
# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# ----------------------------------------------------- --------------------------------------------------------

openrel:assertionDeterministiic
  a skos:Concept ;
  skos:prefLabel "Deterministic Assertion"@en ;
  skos:definition "The assertion is the result of encoding by a human or from a previously asserted and published source."@en ;
  skos:inScheme openrel:typeAssertion .

openrel:assertionCorpus
  a skos:Concept ;
  skos:prefLabel "Corpus-Derived Assertion"@en ;
  skos:definition "The assertion is the result of analysing an existing corpus of policy and licence encodings, and deducing relational assertions from these."@en ;
  skos:inScheme openrel:typeAssertion .

openrel:assertionProbabilistic
  a skos:Concept ;
  skos:prefLabel "Probabilistic Assertion"@en ;
  skos:definition "The assertion is the result of machine-based comparison and imputation, e.g. via vector similarity or generive AI."@en ;
  skos:inScheme openrel:typeAssertion .
