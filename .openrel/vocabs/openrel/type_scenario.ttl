# -------------------------------------------------------------------------------------------------------------
# Scenario Types 
# In OpenREL, Scenario Types are used to model the human-readable contextual aspects of end users, assets, and 
# organisations for the purposes of mapping to encoded language or examples
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:typeScenario
  a skos:ConceptScheme ;
  skos:prefLabel "Scenario Types"@en ;
  dct:title "Scenario Definitions (Types)"@en ;
  dct:description "Scenarios describing user, asset, or organisational context. Scenario groups and individual scenarios used for deterministic policy matching."@en ;
  dct:created "2026-07-12T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.1" .

# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# ----------------------------------------------------- --------------------------------------------------------

# Research Scenarios

openrel:group-research-only
  a skos:Concept ;
  skos:prefLabel "Research Only"@en ;
  skos:definition "Limited to research, development, and academic reuse. Reseaerch may be aimed at commercial exploitation of results."@en ;
  skos:exactMatch r3d:dataAccessTypes/open ;
  skos:exactMatch coar:dataAccessTypes/c_abf2/ ;
  skos:inScheme openrel:typeScenario 
  .

openrel:academic-only
  a skos:Concept ;
  rdfs:label "Academic Only."@en ;
  skos:definiton "Your work can only be used for academic research."@en ;
  skos:broader openrel:group-research-only ;
  skos:inScheme openrel:typeScenario 
  .

openrel:confirmed-researcher
  a skos:Concept ;
  rdfs:label "Confirmed Researcher Only."@en ;
  skos:definiton "Your work can only be used by a confirmed researcher."@en ;
  skos:broader openrel:group-research-only ;
  skos:inScheme openrel:typeScenario 
  .

openrel:confirmed-rpo
  a skos:Concept ;
  rdfs:label "Confirmed Research Performing Organisation."@en ;
  skos:definiton "Your work can only be used by a confirmed research institution."@en ;
  skos:broader openrel:group-research-only ;
  skos:inScheme openrel:typeScenario 
  .

openrel:affirmed-research
  a skos:Concept ;
  rdfs:label "Affrimed Researcher."@en ;
  skos:definiton "I am a researcher, or I am affiliated with a verfied research or academic institution."@en ;
  skos:broader openrel:group-research-only ;
  skos:inScheme openrel:typeScenario 
  .

# Commercial use scenarios

openrel:commercial-use
  a skos:Concept ;
  skos:prefLabel "Commercial Use Excluded"@en ;
  skos:definition "Limitations to commercial applications."@en ;
  skos:inScheme openrel:typeScenario 
  .

openrel:non-commercial-only
  a skos:Concept ;
  rdfs:label "Non-Commercial Only."@en ;
  skos:definiton "Your work can only be used for non-commercial research, derived Assets, or application."@en ;
  skos:broader openrel:commercial-use ;
  skos:inScheme openrel:typeScenario 
  .

# Funding-related considerations

openrel:funding-related
  a skos:Concept ;
  skos:prefLabel "Funding-related Considerations"@en ;
  skos:definition "Your work can only be used in ways defined by the funder."@en ;
  skos:inScheme openrel:typeScenario 
  .

openrel:public-funding-open
  a skos:Concept ;
  rdfs:label "Public Funding Open Access"@en ;
  skos:definiton "Your work was created through public funding, and as a result, must be published with the most open licence applicable to the content."@en ;
  skos:broader openrel:funding-related ;
  skos:inScheme openrel:typeScenario 
  .

# Legal considerations

openrel:legal-considerations
  a skos:Concept ;
  skos:prefLabel "Legal Considerations"@en ;
  skos:definition "Adherence to legislation and regulatory considerations."@en ;
  .

openrel:gdpr-compliance
  a skos:Concept ;
  rdfs:label "GDPR Compliance"@en ;
  skos:definiton "Your work can only be used if GDPR-compliant consent is obtained."@en ;
  skos:broader openrel:legal-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:gdpr-controller
  a skos:Concept ;
  rdfs:label "GDPR Controller"@en ;
  skos:definiton "The organisation using your work must act as the data controller as intended by GDPR."@en ;
  skos:broader openrel:legal-considerations ;
  skos:inScheme openrel:typeScenario 
  .

# Publication (status) considerations

openrel:publication-status
  a skos:Concept ;
  skos:prefLabel "Publication Status"@en ;
  skos:definition "Limitations due to workflow or publication state."@en ;
  .

openrel:status-revoked
  a skos:Concept ;
  rdfs:label "Revocation or Withdrawal"@en ;
  skos:definiton "Your work cannot be used once its publication has been revoked or withdrawn."@en ;
  skos:broader openrel:publication-status ;
  skos:inScheme openrel:typeScenario 
  .

# Ethical considerations

openrel:ethics-considerations
  a skos:Concept ;
  skos:prefLabel "Ethics-Related"@en ;
  skos:definition "Alignment with ethical considerations, policies, and norms."@en ;
  .

openrel:consent-gdpr
  a skos:Concept ;
  rdfs:label "GDPR Consent"@en ;
  skos:definiton "Your work can only be used if GDPR-compliant consent is obtained."@en ;
  skos:broader openrel:ethics-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:ethics-approval
  a skos:Concept ;
  rdfs:label "Ethics Approval"@en ;
  skos:definiton "Requires documented ethics committee or IRB approval prior to access to Assets."@en ;
  skos:broader openrel:ethics-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:explicit-consent
  a skos:Concept ;
  rdfs:label "Explicit Consent"@en ;
  skos:definiton "Your work can only be reused with explicit consent for each application of the work."@en ;
  skos:note "Consent may be required before, after, or before and after use of the work'"@en ;
  skos:broader openrel:ethics-considerations ;
  skos:inScheme openrel:typeScenario 
  .

# End user obligations and duties

openrel:obligations
  a skos:Concept ;
  skos:prefLabel "End User Obligations and Duties"@en ;
  skos:definition "Obligations of the end user."@en ;
  .

openrel:attribution
  a skos:Concept ;
  rdfs:label "Attribution"@en ;
  skos:definiton "You want to be credited or cited when the work is reused."@en ;
  skos:broader openrel:obligations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:licence-preserved
  a skos:Concept ;
  rdfs:label "Share-Alike"@en ;
  skos:definiton "You want derivative works to be distributed under the same licence."@en ;
  skos:note "Such a requirement makes it very difficult to licence a derived Asset based on more than one source Assets, since it prevents a licence that takes all input constraints and actions into account."
  skos:broader openrel:obligations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:notification-duty
  a skos:Concept ;
  rdfs:label "Notification Duties"@en ;
  skos:definiton "Your work can only be accessed and/ or siddeminated if one or more notifcation duties are complied with."@en ;
  skos:broader openrel:access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

# Open Science Related

openrel:open-science
  a skos:Concept ;
  skos:prefLabel "Open Science Considerations"@en ;
  skos:definition "Open science and open data considerations."@en ;
  .

openrel:open-access
  a skos:Concept ;
  rdfs:label "Open Access"@en ;
  skos:definiton "You want your work to be available openly without limitations on reuse. Reuse may include duties such as attribution."@en ;
  skos:broader openrel:open-science ;
  skos:inScheme openrel:typeScenario 
  .

openrel:public-repository
  a skos:Concept ;
  rdfs:label "Public Repository"@en ;
  skos:definiton "You want to deposit the work in a public repository."@en ;
  skos:broader openrel:open-science ;
  skos:inScheme openrel:typeScenario 
  .

# Access Related

openrel:access-considerations
  a skos:Concept ;
  skos:prefLabel "Access Considerations."@en ;
  skos:definition "Access-related limitations and considerations."@en ;
  .

openrel:trusted-connection
  a skos:Concept ;
  rdfs:label "Trusted Connections"@en ;
  skos:definiton "Your work can only be accessed via certified trusted connections."@en ;
  skos:broader openrel:access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:european-use
  a skos:Concept ;
  rdfs:label "EU Use"@en ;
  skos:definiton "Your work can only be accessed if the requestor is based in the European Union."@en ;
  skos:broader openrel:access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:strict-subset
  a skos:Concept ;
  rdfs:label "Strictly Necessary Content"@en ;
  skos:definiton "You only want to grant access to a subset of the work that is strictly necessary for the stated purpose."@en ;
  skos:broader openrel:access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:verified-identity
  a skos:Concept ;
  rdfs:label "Verified Identity"@en ;
  skos:definiton "Your work can only be accessed if the identity of the requestor is verified."@en ;
  skos:broader openrel:access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:system-limitations
  a skos:Concept ;
  rdfs:label "System Limitations"@en ;
  skos:definiton "Your work can only be accessed or processed by systems, devices, and applications that have been identified and verified."@en ;
  skos:broader openrel:access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:formal-toms
  a skos:Concept ;
  rdfs:label "Technical and Organisational Measures"@en ;
  skos:definiton "Your work can only be accessed if the requesting infrastructure, system, or device complies with specific technical, organisational, physical, and legal constraints."@en ;
  skos:broader openrel:access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:tech-limits
  a skos:Concept ;
  rdfs:label "Technical Access Limits"@en ;
  skos:definiton "Your work can only be accessed subject to technical constraints, limiting the duration of access, number of access events, volume of downloads, or similar."@en ;
  skos:broader openrel:access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

