# -------------------------------------------------------------------------------------------------------------
# Scenario Types 
# In OpenREL, Scenario Types are used to model the human-readable contextual aspects of end users, assets, and 
# organisations for the purposes of mapping to encoded language or examples
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ------------------------------------------------------------------------------------------------------------

openrel:typeScenario
  a skos:ConceptScheme ;
  skos:prefLabel "Scenario Types"@en ;
  dct:title "Scenario Definitions (Types)"@en ;
  dct:description "Scenarios describing user, asset, or organisational context. Scenario groups and individual scenarios used for deterministic policy matching."@en ;
  rdfs:hasTopLevel openrel:group-research-only , 
                   openrel:group-commercial-scenarios ,
                   openrel:group-funding-related ,
                   openrel:group-legal-ethical ,
                   openrel:group-publication-status ,
                   openrel:group-obligations ,
                   
  dct:created "2026-07-12T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.1" .

# -------------------------------------------------------------------------------------------------------------
# Definition of Terms
# -------------------------------------------------------------------------------------------------------------

# Research Scenarios

openrel:group-research-only
  a skos:Concept ;
  skos:prefLabel "Research Only"@en ;
  skos:definition "Limited to research, development, and academic reuse. Research may be aimed at commercial exploitation of results."@en ;
  skos:exactMatch r3d:dataAccessTypes/open ;
  skos:exactMatch coar:dataAccessTypes/c_abf2/ ;
  skos:inScheme openrel:typeScenario 
  .

openrel:academic-only
  a skos:Concept ;
  skos:prefLabel "Academic Only"@en ;
  skos:definition "Your work can only be used for academic research."@en ;
  skos:broader openrel:group-research-only ;
  skos:inScheme openrel:typeScenario 
  .

openrel:confirmed-researcher
  a skos:Concept ;
  skos:prefLabel "Confirmed Researcher Only"@en ;
  skos:definition "Your work can only be used by a confirmed researcher."@en ;
  skos:broader openrel:group-research-only ;
  skos:inScheme openrel:typeScenario 
  .

openrel:confirmed-rpo
  a skos:Concept ;
  skos:prefLabel "Confirmed Research Performing Organisation"@en ;
  skos:definition "Your work can only be used by a confirmed research institution."@en ;
  skos:broader openrel:group-research-only ;
  skos:inScheme openrel:typeScenario 
  .

openrel:affirmed-research
  a skos:Concept ;
  skos:prefLabel "Affirmed Researcher"@en ;
  skos:definition "I am a researcher, or I am affiliated with a verfied research or academic institution."@en ;
  skos:broader openrel:group-research-only ;
  skos:inScheme openrel:typeScenario 
  .

# Commercial use scenarios

openrel:group-commercial-scenarios
  a skos:Concept ;
  skos:prefLabel "Commercialisation Scenarios"@en ;
  skos:definition "Limitations to commercial applications."@en ;
  skos:inScheme openrel:typeScenario 
  .

openrel:commercial-use
  a skos:Concept ;
  skos:prefLabel "Commercial Use Excluded"@en ;
  skos:definition "Limitations to commercial applications."@en ;
  skos:broader openrel:group-commercial-scenarios ;
  skos:inScheme openrel:typeScenario 
  .

openrel:non-commercial-only
  a skos:Concept ;
  skos:prefLabel "Non-Commercial Only"@en ;
  skos:definition "Your work can only be used for non-commercial research, derived Assets, or application."@en ;
  skos:broader openrel:group-commercial-scenarios ;
  skos:inScheme openrel:typeScenario 
  .

# Funding-related considerations

openrel:group-funding-related
  a skos:Concept ;
  skos:prefLabel "Funding Considerations"@en ;
  skos:definition "Your work can only be used in ways defined by the funder."@en ;
  skos:inScheme openrel:typeScenario 

openrel:funding-related
  a skos:Concept ;
  skos:prefLabel "Funder-defined permissions and prohibitions"@en ;
  skos:definition "Your work can only be used in ways defined by the funder."@en ;
  skos:broader openrel:group-funding-related ;
  skos:inScheme openrel:typeScenario 
  .

openrel:public-funding-open
  a skos:Concept ;
  skos:prefLabel "Public Funding - -Open Access"@en ;
  skos:definition "Your work was created through public funding, and as a result, must be published with the most open licence applicable to the content."@en ;
  skos:broader openrel:funding-related ;
  skos:inScheme openrel:typeScenario 
  .

# Legal and Ethical Considerations

openrel:group-legal-ethical
  a skos:Concept ;
  skos:prefLabel "Legal and Ethical Considerations"@en ;
  skos:definition "Adherence to ethical, legal and regulatory considerations."@en ;
  skos:inScheme openrel:typeScenario 

openrel:legal-considerations
  a skos:Concept ;
  skos:prefLabel "Legal Considerations"@en ;
  skos:definition "Adherence to legislation and regulatory considerations."@en ;
  skos:broader openrel:group-legal-ethical ;
  skos:inScheme openrel:typeScenario 
  .

openrel:gdpr-compliance
  a skos:Concept ;
  skos:prefLabel "GDPR Compliance"@en ;
  skos:definition "Your work can only be used if GDPR-compliant consent is obtained."@en ;
  skos:broader openrel:legal-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:gdpr-controller
  a skos:Concept ;
  skos:prefLabel "GDPR Controller"@en ;
  skos:definition "The organisation using your work must act as the data controller as intended by GDPR."@en ;
  skos:broader openrel:legal-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:gdpr-special-category
  a skos:Concept ;
  skos:prefLabel "Special Data Categories"@en ;
  skos:definition "My personal data, if it includes categories defined in GDPR Article 9, may only be distributed or used in accordance with the legal provisions."@en ;
  skos:note "Processing of personal data revealing racial or ethnic origin, political opinions, religious or philosophical beliefs, or trade union membership, and the processing of genetic data, biometric data for the purpose of uniquely identifying a natural person, data concerning health or data concerning a natural person's sex life or sexual orientation shall be prohibited [subject to exemptions]."@en ;
  skos:broader openrel:legal-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:ethics-considerations
  a skos:Concept ;
  skos:prefLabel "Ethics-Related"@en ;
  skos:broader openrel:legal-considerations ;
  skos:definition "Alignment with ethical considerations, policies, and norms."@en ;
  .

openrel:consent-gdpr
  a skos:Concept ;
  skos:prefLabel "GDPR Consent"@en ;
  skos:definition "Your work can only be used if GDPR-compliant consent is obtained."@en ;
  skos:broader openrel:ethics-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:ethics-approval
  a skos:Concept ;
  skos:prefLabel "Ethics Approval"@en ;
  skos:definition "Requires documented ethics committee or IRB approval prior to access to Assets."@en ;
  skos:broader openrel:ethics-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:explicit-consent
  a skos:Concept ;
  skos:prefLabel "Explicit Consent"@en ;
  skos:definition "Your work can only be reused with explicit consent for each application of the work."@en ;
  skos:note "Consent may be required before, after, or before and after use of the work'"@en ;
  skos:broader openrel:ethics-considerations ;
  skos:inScheme openrel:typeScenario 
  .

# Publication (status) considerations

openrel:group-publication-status
  a skos:Concept ;
  skos:prefLabel "Publication Status"@en ;
  skos:definition "Limitations due to workflow or publication state."@en ;
  .

openrel:status-revoked
  a skos:Concept ;
  skos:prefLabel "Revocation or Withdrawal"@en ;
  skos:definition "Your work cannot be used once its publication has been revoked or withdrawn."@en ;
  skos:broader openrel:group-publication-status ;
  skos:inScheme openrel:typeScenario 
  .

# End user obligations and duties

openrel:group-obligations
  a skos:Concept ;
  skos:prefLabel "End User Obligations and Duties"@en ;
  skos:definition "Obligations of the end user."@en ;
  skos:inScheme openrel:typeScenario
  .

openrel:attribution
  a skos:Concept ;
  skos:prefLabel "Attribution"@en ;
  skos:definition "You want to be credited or cited when the work is reused."@en ;
  skos:broader openrel:group-obligations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:licence-preserved
  a skos:Concept ;
  skos:prefLabel "Share-Alike"@en ;
  skos:definition "You want derivative works to be distributed under the same licence."@en ;
  skos:note "Such a requirement makes it very difficult to licence a derived Asset based on more than one source Asset, since it prevents a new licence that takes all input constraints and actions into account."
  skos:broader openrel:group-obligations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:notification-duty
  a skos:Concept ;
  skos:prefLabel "Notification Duties"@en ;
  skos:definition "Your work can only be accessed and/ or disseminated if one or more notification duties are complied with."@en ;
  skos:broader openrel:group-obligations ;
  skos:inScheme openrel:typeScenario 
  .

# Open Science Related

openrel:group-open-science
  a skos:Concept ;
  skos:prefLabel "Open Science Considerations"@en ;
  skos:definition "Open science and open data considerations."@en ;
  skos:inScheme openrel:typeScenario
  .

openrel:open-access
  a skos:Concept ;
  skos:prefLabel "Open Access"@en ;
  skos:definition "You want your work to be available openly without limitations on reuse. Reuse may include duties such as attribution and notification."@en ;
  skos:broader openrel:group-open-science ;
  skos:inScheme openrel:typeScenario 
  .

openrel:public-repository
  a skos:Concept ;
  skos:prefLabel "Public Repository"@en ;
  skos:definition "You want to deposit the work in a public repository."@en ;
  skos:broader openrel:group-open-science ;
  skos:inScheme openrel:typeScenario 
  .

# Access Related

openrel:group-access-considerations
  a skos:Concept ;
  skos:prefLabel "Access Considerations"@en ;
  skos:definition "Access-related limitations and considerations."@en ;
  skos:inScheme openrel:typeScenario 
  .

openrel:trusted-connection
  a skos:Concept ;
  skos:prefLabel "Trusted Connections"@en ;
  skos:definition "Your work can only be accessed via certified trusted connections."@en ;
  skos:broader openrel:group-access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:european-use
  a skos:Concept ;
  skos:prefLabel "EU Use"@en ;
  skos:definition "Your work can only be accessed if the requestor is based in the European Union."@en ;
  skos:broader openrel:group-access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:strict-subset
  a skos:Concept ;
  skos:prefLabel "Strictly Necessary Content"@en ;
  skos:definition "You only want to grant access to a subset of the work that is strictly necessary for the stated purpose."@en ;
  skos:broader openrel:group-access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:verified-identity
  a skos:Concept ;
  skos:prefLabel "Verified Identity"@en ;
  skos:definition "Your work can only be accessed if the identity of the requestor is verified."@en ;
  skos:broader openrel:group-access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:system-limitations
  a skos:Concept ;
  skos:prefLabel "System Limitations"@en ;
  skos:definition "Your work can only be accessed or processed by systems, devices, and applications that have been identified and verified."@en ;
  skos:broader openrel:group-access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:formal-toms
  a skos:Concept ;
  skos:prefLabel "Technical and Organisational Measures"@en ;
  skos:definition "Your work can only be accessed if the requesting infrastructure, system, or device complies with specific technical, organisational, physical, and legal constraints."@en ;
  skos:broader openrel:group-access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

openrel:tech-limits
  a skos:Concept ;
  skos:prefLabel "Technical Access Limits"@en ;
  skos:definition "Your work can only be accessed subject to technical constraints, limiting the duration of access, number of access events, volume of downloads, or similar."@en ;
  skos:broader openrel:group-access-considerations ;
  skos:inScheme openrel:typeScenario 
  .

