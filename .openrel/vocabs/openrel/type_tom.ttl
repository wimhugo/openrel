# -------------------------------------------------------------------------------------------------------------
# Technical and Operational Measure Types
# In OpenREL, DPV TOM is used to define left operands for description of technical, organisational, legal, and 
# physical measures required to safeguard sensitive data - which is not limited only to personal data.
# OpenREL only defines measures here that are not included in DPV TOM.
# -------------------------------------------------------------------------------------------------------------

# context
@base <http://www.w3.org/ns/openrel/0/> .
@prefix : <http://www.w3.org/ns/openrel/0/> . 
# RDF-related
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# general content
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
# rdmi-related
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> .
@prefix coar: <http://purl.org/coar/> .
# rights-related
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dalicc: <https://dalicc.net/ns#> .
@prefix dalicclib: <https://dalicc.net/licenselibrary/> .
@prefix ids: <https://w3id.org/idsa/core/> .
@prefix idsc: <https://w3id.org/idsa/code/> .
@prefix osl: <http://opensource.org/licenses/> .
@prefix spdx: <http://spdx.org/rdf/terms#>  .
@prefix spdxlicense: <http://spdx.org/licenses/> .
@prefix dpv: <https://w3id.org/dpv/2.0> .

# -------------------------------------------------------------------------------------------------------------
# Definition of Scheme and Provenance
# ----------------------------------------------------- -------------------------------------------------------

openrel:type-tom
  a skos:ConceptScheme ;
  skos:prefLabel "Types of Technical and Organisational Measures"@en ;
  dct:title "Types of Technical and Orgnisational Measures"@en ;
  dct:description "Types of technical, organisational, legal, and physical measures that could be required to safeguard sensitive data, including personal data."@en ;
  skos:note "DPV, IDSC, and ODRL provide a comprehensive set of classes for description of technical, organisational, legal, and physical measures used to safeguard personal data, and tehse are used by preference - OpenREL extends these with concepts that identify non-personal data measures or measures that are not well described."@en ;
  dct:created "2026-07-07T00:00:00+00:00"^^xsd:datetime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  owl:versionInfo "0.1" .

# -------------------------------------------------------------------------------------------------------------
# Definition of Terms - extensions by OpenREL of DPV TOM
# ----------------------------------------------------- --------------------------------------------------------

#------ OpenREL

openrel:limitResolution
  a skos:Concept ;
  skos:prefLabel "Spatial Resolution Limitation"@en ;
  skos:definition "A minimum spatial resolution permitted in use of the resource, expressed in metres."@en ;
  skos:note "This measure is used to obfuscate the detailed spatial location of the subjects of study, for example endangered species or indigenous community resources."@en ;
  skos:broadMatch dpv:TechnicalMeasure ;
  skos:inScheme openrel:type-tom .

openrel:dataMinimisation
  a skos:Concept ;
  skos:prefLabel "Data Minimisation"@en ;
  skos:definition "Measures are in place to assist users with obtaining a minimum subset of a resource applicable to their context to limit the impact of accidental disclosure."@en ;
  skos:note "Typical implementations might include query support to provide subsets of senstive data sets."@en ;
  skos:broadMatch dpv:TechnicalMeasure ;
  skos:inScheme openrel:type-tom .

openrel:blindProcessing
  a skos:Concept ;
  skos:prefLabel "Blind Data Processing"@en ;
  skos:definition "Constrains processing to visibility of code and the derived asset, a human cannot see the original asset."@en ;
  skos:note "Typical implementation requires an algorithm or code to be developed based on a simulated dataset, which is then used to create a derived asset witghout the original asset being viewed by the human processor."@en ;
  skos:broadMatch dpv:TechnicalMeasure ;
  skos:inScheme openrel:type-tom .

